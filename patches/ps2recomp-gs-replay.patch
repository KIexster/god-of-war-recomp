diff --git a/ps2xTest/src/ps2_gs_replay_tests.cpp b/ps2xTest/src/ps2_gs_replay_tests.cpp
new file mode 100644
index 0000000..3f1803b
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_replay_tests.cpp
@@ -0,0 +1,87 @@
+#include "MiniTest.h"
+#include "runtime/gs/gs_stage.h"
+
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace
+{
+    void setEnv(const char *name, const char *value)
+    {
+#ifdef _WIN32
+        _putenv_s(name, value ? value : "");
+#else
+        if (value)
+            setenv(name, value, 1);
+        else
+            unsetenv(name);
+#endif
+    }
+
+    struct SeenPacket
+    {
+        GifPathId path;
+        std::vector<uint8_t> data;
+    };
+}
+
+void register_ps2_gs_replay_tests()
+{
+    MiniTest::Case("GS replay", [](TestCase &tc)
+    {
+        tc.Run("record preserves packet paths bytes and order", [](TestCase &t)
+        {
+            const auto unique = std::chrono::steady_clock::now().time_since_epoch().count();
+            const std::filesystem::path file = std::filesystem::temp_directory_path() /
+                                               ("ps2x_gs_replay_" + std::to_string(unique) + ".bin");
+            setEnv("PS2X_GS_RECORD", file.string().c_str());
+            setEnv("PS2X_GS_RECORD_SECONDS", "60");
+            std::vector<SeenPacket> live;
+            ps2_gs_stage::start([&](GifPathId path, const uint8_t *data, uint32_t size)
+            {
+                live.push_back({path, std::vector<uint8_t>(data, data + size)});
+            }, [] {});
+            const std::array<uint8_t, 5> a{{1, 2, 3, 4, 5}};
+            const std::array<uint8_t, 3> b{{9, 8, 7}};
+            ps2_gs_stage::push(GifPathId::Path1, a.data(), static_cast<uint32_t>(a.size()));
+            ps2_gs_stage::push(GifPathId::Path3, b.data(), static_cast<uint32_t>(b.size()));
+            ps2_gs_stage::waitIdle();
+            ps2_gs_stage::stop();
+            setEnv("PS2X_GS_RECORD", nullptr);
+            setEnv("PS2X_GS_RECORD_SECONDS", nullptr);
+
+            std::vector<SeenPacket> replayed;
+            const ps2_gs_stage::ReplayStats stats = ps2_gs_stage::replayFile(file.string().c_str(),
+                [&](GifPathId path, const uint8_t *data, uint32_t size)
+                {
+                    replayed.push_back({path, std::vector<uint8_t>(data, data + size)});
+                });
+            t.IsTrue(stats.ok, "a complete recording should replay successfully");
+            t.Equals(stats.packets, 2ull, "replay should report both packets");
+            t.Equals(stats.bytes, 8ull, "replay should report payload bytes");
+            t.Equals(live.size(), static_cast<size_t>(2), "live stage should process both packets");
+            t.Equals(replayed.size(), static_cast<size_t>(2), "replay should process both packets");
+            if (replayed.size() == 2)
+            {
+                t.Equals(replayed[0].path, GifPathId::Path1, "first replay path should be PATH1");
+                t.Equals(replayed[1].path, GifPathId::Path3, "second replay path should be PATH3");
+                t.Equals(replayed[0].data, std::vector<uint8_t>(a.begin(), a.end()), "first payload should be exact");
+                t.Equals(replayed[1].data, std::vector<uint8_t>(b.begin(), b.end()), "second payload should be exact");
+            }
+
+            const auto truncated = file.string() + ".truncated";
+            std::filesystem::copy_file(file, truncated, std::filesystem::copy_options::overwrite_existing);
+            std::filesystem::resize_file(truncated, std::filesystem::file_size(truncated) - 1u);
+            const ps2_gs_stage::ReplayStats bad = ps2_gs_stage::replayFile(truncated.c_str(),
+                [](GifPathId, const uint8_t *, uint32_t) {});
+            std::error_code ignored;
+            std::filesystem::remove(file, ignored);
+            std::filesystem::remove(truncated, ignored);
+            t.IsFalse(bad.ok, "a recording without its complete footer must be rejected");
+        });
+    });
+}
