+                              readU32(file, version) && readU32(file, reserved) &&
+                              magic == kReplayMagic && version == kReplayVersion && reserved == 0u;
+        if (!headerOk)
+        {
+            std::fprintf(stderr, "[gs-replay] invalid header in %s\n", path);
+            std::fclose(file);
+            return stats;
+        }
+
+        std::vector<uint8_t> data;
+        for (;;)
+        {
+            uint8_t first = 0;
+            const size_t got = std::fread(&first, 1, 1, file);
+            if (got == 0u)
+                break;
+            uint8_t rest[3]{};
+            if (std::fread(rest, 1, sizeof(rest), file) != sizeof(rest))
+                break;
+            const uint32_t pathValue = static_cast<uint32_t>(first) |
+                                       (static_cast<uint32_t>(rest[0]) << 8u) |
+                                       (static_cast<uint32_t>(rest[1]) << 16u) |
+                                       (static_cast<uint32_t>(rest[2]) << 24u);
+            uint32_t size = 0;
+            if (!readU32(file, size))
+                break;
+            if (pathValue == 0u && size == 0u)
+            {
+                stats.ok = true;
+                break;
+            }
+            if (pathValue < static_cast<uint32_t>(GifPathId::Path1) ||
+                pathValue > static_cast<uint32_t>(GifPathId::Path3) || size > kMaxReplayPacket)
+                break;
+            data.resize(size);
+            if (size != 0u && std::fread(data.data(), 1, size, file) != size)
+                break;
+            const auto begin = std::chrono::steady_clock::now();
+            process(static_cast<GifPathId>(pathValue), data.data(), size);
+            stats.processNanoseconds += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now() - begin).count());
+            ++stats.packets;
+            stats.bytes += size;
+        }
+        std::fclose(file);
+        if (!stats.ok)
+            std::fprintf(stderr, "[gs-replay] truncated or invalid record in %s after %llu packets\n", path,
+                         static_cast<unsigned long long>(stats.packets));
+        return stats;
+    }
