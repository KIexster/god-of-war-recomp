+    // GOW-Port: función invitada que solo gasta ciclos (como un bucle de sondeo recompilado) y mide cuánto se
+    // adelanta el reloj del EE al reloj real.
+    constexpr uint32_t kPaceBurnPc = 0x00160600u;
+    constexpr uint64_t kPaceBurnChunk = 1024u;
+    std::chrono::steady_clock::time_point g_paceStart;
+    uint64_t g_paceCycles = 0u;
+    double g_paceMaxLeadUs = 0.0;
+
+    void schedulerPaceBurn(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint64_t field = EeScheduler::kEeClockHz * 1001ull / 60000ull;
+        for (;;)
+        {
+            g_paceCycles += kPaceBurnChunk;
+            if (g_paceCycles > field + field / 8u) // el primer campo no tiene puntos de ritmo
+            {
+                const double guestUs = static_cast<double>(g_paceCycles) * 1e6 / static_cast<double>(EeScheduler::kEeClockHz);
+                const double wallUs = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - g_paceStart).count();
+                g_paceMaxLeadUs = std::max(g_paceMaxLeadUs, guestUs - wallUs);
+            }
+            if (g_paceCycles >= 4u * field)
+            {
+                ctx->pc = 0u;
+                runtime->requestStop();
+                return;
+            }
+            if (runtime->eeCheckpointDue(static_cast<uint32_t>(kPaceBurnChunk)))
+            {
+                ctx->pc = kPaceBurnPc;
+                return;
+            }
+        }
+    }
