+    // CSR.FINISH sin enmascarar y todavía sin manejador de la causa 0: la interrupción debe quedar pendiente.
+    void gsIrqRaise(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        runtime->memory().gs().imr = 0u;
+        runtime->memory().gs().csr.fetch_or(0x2u, std::memory_order_acq_rel);
+        EeScheduler &scheduler = runtime->eeScheduler();
+        ctx->pc = kGsIrqRegisterPc;
+        scheduler.waitVSync(scheduler.currentVSyncTick());
+    }
+
+    void gsIrqRegister(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        EeScheduler &scheduler = runtime->eeScheduler();
+        scheduler.addIrqHandler(false, 0u, kGsIrqHandlerPc, true, 0u, 0u, 0u);
+        ctx->pc = kGsIrqDonePc;
+        scheduler.waitVSync(scheduler.currentVSyncTick());
+    }
+
+    void gsIrqDone(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    // El manejador del juego: reconoce FINISH escribiendo CSR.
+    void gsIrqHandler(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        g_gsIrqHandled.fetch_add(1, std::memory_order_relaxed);
+        runtime->memory().gs().csr.fetch_and(~0x2ull, std::memory_order_acq_rel);
+        ctx->pc = 0u;
+    }
