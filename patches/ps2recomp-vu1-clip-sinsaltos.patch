+    VU1N_INLINE uint32_t clipBits(__m128 v, __m128 t, uint32_t prev)
+    {
+        static constexpr uint8_t kSpread[8] = {0x00u, 0x01u, 0x04u, 0x05u, 0x10u, 0x11u, 0x14u, 0x15u};
+        const __m128 w = _mm_and_ps(bc<3>(t), _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF)));
+        const __m128 negW = _mm_xor_ps(w, _mm_castsi128_ps(_mm_set1_epi32(static_cast<int>(0x80000000u))));
