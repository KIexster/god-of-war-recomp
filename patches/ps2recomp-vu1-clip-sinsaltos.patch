+        tc.Run("VU1 native CLIP without branches matches the scalar judgements", [](TestCase &t)
+        {
+            // GOW-Port: ps2recomp-vu1-clip-sinsaltos. clipBits (dos comparaciones SSE) debe dar los mismos seis juicios
+            // que la versión escalar, también con +-0, infinitos, NaN y valores iguales a |w|.
+            const float big = std::numeric_limits<float>::max(), inf = std::numeric_limits<float>::infinity();
+            const float nan = std::numeric_limits<float>::quiet_NaN();
+            const float values[] = {0.0f, -0.0f, 1.0f, -1.0f, 2.5f, -2.5f, big, -big, inf, -inf, nan};
+            const auto scalar = [](const float v[4], const float tt[4], uint32_t prev)
+            {
+                const float w = std::fabs(tt[3]);
+                uint32_t f = 0;
+                if (v[0] > w) f |= 0x01u;
+                if (v[0] < -w) f |= 0x02u;
+                if (v[1] > w) f |= 0x04u;
+                if (v[1] < -w) f |= 0x08u;
+                if (v[2] > w) f |= 0x10u;
+                if (v[2] < -w) f |= 0x20u;
+                return ((prev << 6) | f) & 0xFFFFFFu;
+            };
+            uint32_t mismatches = 0, checked = 0;
+            for (const float x : values)
+                for (const float y : values)
+                    for (const float w : values)
+                    {
+                        const float v[4] = {x, y, -x, 7.0f};
+                        const float tt[4] = {0.0f, 0.0f, 0.0f, w};
+                        const uint32_t prev = 0x2A5A5u + checked;
+                        const uint32_t fast = vu1n::clipBits(_mm_loadu_ps(v), _mm_loadu_ps(tt), prev);
+                        mismatches += fast != scalar(v, tt, prev);
+                        ++checked;
+                    }
+            t.Equals(mismatches, 0u, "every CLIP judgement should match the scalar version");
+            t.IsTrue(checked > 1000u, "the value grid should be covered");
+        });
