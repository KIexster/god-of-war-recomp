+        // GOW-Port: ps2recomp-mpeg-audio-pendiente. God of War abre todos los vídeos con el mismo sceMpeg: el audio que el
+        // callback rechazó al final de uno no debe entregarse al principio del siguiente (desplazaba su PCM).
+        tc.Run("a new movie stream drops the refused audio packets of the previous one", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+            ps2_stubs::resetMpegStubState();
+            constexpr uint32_t kMpegAddr = 0x00123000u;
+            constexpr uint32_t kDataAddr = 0x00128000u;
+            constexpr uint32_t kRefuseAudioPc = 0x00125300u; // callback de audio con el anillo lleno: devuelve 0
+            runtime.registerFunction(kRefuseAudioPc, [](uint8_t *, R5900Context *ctx, PS2Runtime *)
+                                     {
+                                         setRegU32(*ctx, 2, 0u);
+                                         ctx->pc = 0u;
+                                     });
+            const std::vector<uint8_t> payload = {0x00u, 0x00u, 0x01u, 0xB3u, 0x14u, 0x00u, 0xF0u, 0x13u};
+            const uint16_t packetLen = static_cast<uint16_t>(payload.size() + 3u);
+            std::vector<uint8_t> data = {0x00u, 0x00u, 0x01u, 0xE0u, static_cast<uint8_t>(packetLen >> 8u),
+                                         static_cast<uint8_t>(packetLen & 0xFFu), 0x80u, 0x00u, 0x00u};
+            data.insert(data.end(), payload.begin(), payload.end());
+            std::memcpy(rdram.data() + kDataAddr, data.data(), data.size());
+            auto demux = [&]()
+            {
+                R5900Context ctx{};
+                setRegU32(ctx, 29, 0x001F0000u);
+                setRegU32(ctx, 4, kMpegAddr);
+                setRegU32(ctx, 5, kDataAddr);
+                setRegU32(ctx, 6, static_cast<uint32_t>(data.size()));
+                setRegU32(ctx, 7, 0u);
+                setRegU32(ctx, 8, 0xFFFFFFFFu);
+                ps2_stubs::sceMpegDemuxPssRing(rdram.data(), &ctx, &runtime);
+            };
+            ps2_stubs::notifyMpegCdStreamStart(&runtime);
+            demux(); // primer vídeo
+            ps2_stubs::queueMpegPendingAudioForTesting(kMpegAddr, kRefuseAudioPc);
+            t.Equals(ps2_stubs::mpegPendingAudioForTesting(kMpegAddr), static_cast<size_t>(1u),
+                     "the refused packet should wait while its stream lasts");
+            ps2_stubs::notifyMpegCdStreamStart(&runtime);
+            demux(); // segundo vídeo en el mismo sceMpeg
+            t.Equals(ps2_stubs::mpegPendingAudioForTesting(kMpegAddr), static_cast<size_t>(0u),
+                     "the next movie should not receive the previous movie's refused audio");
+            runtime.requestStop();
+        });
