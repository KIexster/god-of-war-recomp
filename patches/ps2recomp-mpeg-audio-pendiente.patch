+        void dropPendingAudio(uint32_t mpegAddr)
+        {
+            static const bool diag = std::getenv("GOW_MPEG_DIAG") != nullptr;
+            const auto it = g_pendingAudio.find(mpegAddr);
+            if (it == g_pendingAudio.end())
+                return;
+            if (diag && !it->second.empty())
+                std::fprintf(stderr, "[MPEG:pending] flujo nuevo en mpeg=0x%x: se descartan %zu paquetes de audio rechazados del anterior\n",
+                             mpegAddr, it->second.size());
+            g_pendingAudio.erase(it);
+        }
