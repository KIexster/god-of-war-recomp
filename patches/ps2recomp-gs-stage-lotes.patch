         });
+        tc.Run("GS stage batches packets and delivers them in order with exact sizes", [](TestCase &t)
+        {
+            // GOW-Port: ps2recomp-gs-stage-lotes. El trabajador agrupa los paquetes GIF antes de pasarlos a la etapa;
+            // cada paquete debe llegar en orden, con su ruta y su tamaño exacto (aunque no sea múltiplo de 16), y
+            // waitIdle desde el hilo productor debe entregar también los que aún esperaban en el lote.
+            struct Seen { GifPathId path; std::vector<uint8_t> bytes; };
+            std::mutex seenMutex;
+            std::vector<Seen> seen;
+            ps2_gs_stage::start([&](GifPathId path, const uint8_t *data, uint32_t size)
+                                {
+                                    std::lock_guard<std::mutex> lock(seenMutex);
+                                    seen.push_back(Seen{path, std::vector<uint8_t>(data, data + size)});
+                                },
+                                nullptr);
+            const GifPathId paths[3] = {GifPathId::Path1, GifPathId::Path2, GifPathId::Path3};
+            const uint32_t sizes[6] = {16u, 20u, 0u, 48u, 40000u, 3u};
+            std::vector<std::vector<uint8_t>> sent;
+            for (uint32_t i = 0; i < 6u; ++i)
+            {
+                std::vector<uint8_t> bytes(sizes[i]);
+                for (uint32_t b = 0; b < sizes[i]; ++b)
+                    bytes[b] = static_cast<uint8_t>(i * 37u + b);
+                ps2_gs_stage::push(paths[i % 3u], bytes.data(), sizes[i]);
+                sent.push_back(std::move(bytes));
+            }
+            ps2_gs_stage::waitIdle();
+            ps2_gs_stage::stop();
+            t.Equals(seen.size(), static_cast<size_t>(6u), "every pushed packet should reach the stage");
+            bool same = seen.size() == 6u;
+            for (uint32_t i = 0; same && i < 6u; ++i)
+                same = seen[i].path == paths[i % 3u] && seen[i].bytes == sent[i];
+            t.IsTrue(same, "packets should arrive in order with their path and exact bytes");
+        });
     });
