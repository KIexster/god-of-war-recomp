diff --git a/ps2xTest/src/ps2_gs_tests.cpp b/ps2xTest/src/ps2_gs_tests.cpp
index 317960a..eb4ce1f 100644
--- a/ps2xTest/src/ps2_gs_tests.cpp
+++ b/ps2xTest/src/ps2_gs_tests.cpp
@@ -1213,5 +1213,25 @@ void register_ps2_gs_tests()
                 same = seen[i].path == paths[i % 3u] && seen[i].bytes == sent[i];
             t.IsTrue(same, "packets should arrive in order with their path and exact bytes");
         });
+
+        tc.Run("GS stage yields between packets while a priority waiter is registered", [](TestCase &t)
+        {
+            // GOW-Port: ps2recomp-gs-prioridad-presentacion. La presentación espera el lock del GS con prioridad: la
+            // etapa no procesa más paquetes mientras haya una espera prioritaria registrada.
+            std::atomic<uint32_t> processed{0u};
+            ps2_gs_stage::start([&](GifPathId, const uint8_t *, uint32_t) { processed.fetch_add(1u); }, nullptr);
+            const uint8_t bytes[16] = {};
+            ps2_gs_stage::priorityWaitBegin();
+            for (int i = 0; i < 3; ++i)
+                ps2_gs_stage::push(GifPathId::Path3, bytes, sizeof(bytes));
+            ps2_gs_stage::flush();
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            const uint32_t whileWaiting = processed.load();
+            ps2_gs_stage::priorityWaitEnd();
+            ps2_gs_stage::waitIdle();
+            ps2_gs_stage::stop();
+            t.Equals(whileWaiting, 0u, "the stage should not process packets while a priority waiter is registered");
+            t.Equals(processed.load(), 3u, "the stage should process them once the waiter is gone");
+        });
     });
 }
