diff --git a/ps2xRuntime/include/runtime/gs/gs_stage.h b/ps2xRuntime/include/runtime/gs/gs_stage.h
index 30fc3c9..44a41b6 100644
--- a/ps2xRuntime/include/runtime/gs/gs_stage.h
+++ b/ps2xRuntime/include/runtime/gs/gs_stage.h
@@ -32,4 +32,12 @@ namespace ps2_gs_stage
 
     // Returns when every queued packet has been processed. No-op on the stage thread itself.
     void waitIdle();
+
+    // GOW-Port: the stage takes and releases the GS state lock once per packet, thousands of times per frame, and
+    // the lock is not fair: the host presentation (main thread) waiting for it could wait for many frames (the
+    // window showed 2-8 pictures per second while the game ran at 60-120). Between packets, the stage yields while
+    // a priority waiter is registered. Bracket the lock acquisition of such a waiter with these (never call them
+    // on the stage thread).
+    void priorityWaitBegin();
+    void priorityWaitEnd();
 }
