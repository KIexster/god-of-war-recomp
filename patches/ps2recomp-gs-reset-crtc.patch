+// GOW-Port: una selección de pantalla no es un paquete de registros de dibujo GIF.
+void GS::setDisplayRegisters(const GSPresentationRequest &request)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (!m_privRegs)
+        return;
+    m_privRegs->pmode = request.pmode;
+    m_privRegs->smode2 = request.smode2;
+    m_privRegs->dispfb1 = request.dispfb1;
+    m_privRegs->display1 = request.display1;
+    m_privRegs->dispfb2 = request.dispfb2;
+    m_privRegs->display2 = request.display2;
+    m_privRegs->bgcolor = request.bgcolor;
+}
