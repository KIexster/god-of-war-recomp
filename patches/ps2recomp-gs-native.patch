+                     (unsigned long long)m_clears, (unsigned long long)m_cpuRead, (unsigned long long)m_cpuWrite,
+                     (unsigned long long)m_snapshots, (unsigned long long)m_consumeL2H);
+        for (const auto &kv : m_reinterpKinds)
