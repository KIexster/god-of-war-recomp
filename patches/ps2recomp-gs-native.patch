+    uint32_t spanBlocks(uint32_t psm, uint32_t bw, uint32_t rows)
+    {
+        const uint32_t pagesDown = (rows + pageRowsFor(psm) - 1u) / pageRowsFor(psm);
+        return std::max<uint32_t>(1u, pagesDown) * std::max<uint32_t>(1u, bw) * 32u;
