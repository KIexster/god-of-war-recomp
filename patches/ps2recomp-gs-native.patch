+        std::fprintf(stderr,
+                     "[gs-inv]     state: fbmsk!=0=%llu abe=%llu fog=%llu aa=%llu atest=%llu date=%llu zte=%llu dither=%llu pabe=%llu scanmsk=%llu prims(pt,ln,ls,tr,ts,tf,sp)=%llu,%llu,%llu,%llu,%llu,%llu,%llu\n",
