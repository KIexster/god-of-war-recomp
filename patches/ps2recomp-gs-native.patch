+flat in vec2 vOff;
+out vec4 oColor;
+uniform sampler2D uSrc;
+uniform int uSrcZ;     // source is a depth buffer (Z words)
+uniform float uZMax;
+uniform int uHs, uHd;  // source / destination halfword (0 low = R,G; 1 high = B,A)
+uniform float uScale;
