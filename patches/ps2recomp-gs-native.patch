+    uint64_t m_localToLocal = 0, m_copyFromRt = 0, m_copyIntoRt = 0, m_clears = 0, m_cpuRead = 0, m_cpuWrite = 0, m_snapshots = 0;
+    uint64_t m_consumeL2H = 0, m_presents = 0;
+};
