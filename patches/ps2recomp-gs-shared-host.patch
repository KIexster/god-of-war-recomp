index 0000000..3ebabad
--- /dev/null
+++ b/ps2xTest/src/ps2_gpu_shared_present_gl_tests.cpp
@@ -0,0 +1,387 @@
+// GOW-Port: comprobar la composición compartida con un host raylib OpenGL 3.3.
+// Patrones sintéticos: sin assets, sin fallback y con el renderer CPU de referencia.
+#include "MiniTest.h"
+
+#include <cstdlib>
+
+#ifdef _WIN32
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/gs_gpu_backend.h"
+#include "runtime/gs/gs_shared_present.h"
+#include "runtime/gs/gs_swizzle.h"
+#include "runtime/gs/gs_threaded_backend.h"
+#include "raylib.h"
+#include "rlgl.h"
+
+#include <algorithm>
+#include <chrono>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace
+{
+    std::string sharedSetting(const char *name, bool &present)
+    {
+        char *value = nullptr;
+        size_t size = 0;
+        if (_dupenv_s(&value, &size, name) != 0)
+            throw std::runtime_error(std::string("No se pudo leer ") + name);
+        const std::unique_ptr<char, decltype(&std::free)> owned(value, &std::free);
+        present = value != nullptr;
+        return present ? std::string(value) : std::string();
+    }
+
+    class RaylibSharedHost
+    {
+        bool hadSetting = false;
+        bool changedSetting = false;
+        bool ownsWindow = false;
+        bool captured = false;
+        std::string oldSetting;
+
+    public:
+        RaylibSharedHost()
+        {
+            oldSetting = sharedSetting("PS2X_GS_DIRECT_PRESENT", hadSetting);
+        }
+
+        ~RaylibSharedHost()
+        {
+            if (captured)
+            {
+                GSSharedPresent::RestoreHostContext();
+                GSSharedPresent::ShutdownHost();
+            }
+            if (ownsWindow)
+                CloseWindow();
+            if (changedSetting)
+                _putenv_s("PS2X_GS_DIRECT_PRESENT", hadSetting ? oldSetting.c_str() : "");
+        }
+
+        bool initialize(TestCase &t)
+        {
+            if (IsWindowReady() || GSSharedPresent::Active())
+            {
+                t.Fail("La prueba requiere un host raylib propio, sin ventana ni GPU compartida anterior");
+                return false;
+            }
+            if (_putenv_s("PS2X_GS_DIRECT_PRESENT", "1") != 0)
+            {
+                t.Fail("No se pudo activar sharing para la prueba");
+                return false;
+            }
+            changedSetting = true;
+            SetConfigFlags(FLAG_WINDOW_HIDDEN | FLAG_WINDOW_UNFOCUSED);
+            InitWindow(160, 120, "GOW prueba compositor compartido");
+            ownsWindow = IsWindowReady();
+            if (!ownsWindow)
+            {
+                t.Fail("Host raylib oculto requerido; no se admite fallback");
+                return false;
+            }
+            if (rlGetVersion() != RL_OPENGL_33)
+            {
+                t.Fail("La prueba requiere el camino host OpenGL 3.3 del juego");
+                return false;
+            }
+            GSSharedPresent::CaptureHostContext();
+            captured = true;
+            GSSharedPresent::RestoreHostContext();
+            return true;
+        }
+    };
+
+    struct OwnedImage
+    {
+        Image image{};
+        explicit OwnedImage(Texture2D texture) : image(LoadImageFromTexture(texture)) {}
+        ~OwnedImage() { if (image.data) UnloadImage(image); }
+        OwnedImage(const OwnedImage &) = delete;
+        OwnedImage &operator=(const OwnedImage &) = delete;
+    };
+
+    struct SharedFixture
+    {
+        std::vector<uint8_t> cpuRam = std::vector<uint8_t>(GSSwizzle::kMemorySize);
+        std::vector<uint8_t> gpuRam = std::vector<uint8_t>(GSSwizzle::kMemorySize);
+        GSCpuBackend cpu;
+        std::unique_ptr<GSThreadedBackend> gpu;
+        GSSharedPresent::Frame current{};
+
+        bool initialize(TestCase &t)
+        {
+            cpu.Initialize(cpuRam.data(), static_cast<uint32_t>(cpuRam.size()));
+            auto inner = std::make_unique<GSGpuBackend>();
+            auto *raw = inner.get();
+            inner->SetHardwareRasterAllowed(false);
+            gpu = std::make_unique<GSThreadedBackend>(std::move(inner));
+            gpu->Initialize(gpuRam.data(), static_cast<uint32_t>(gpuRam.size()));
+            GSSharedPresent::RestoreHostContext();
+            if (&gpu->Inner() != raw || !raw->IsReady() || !gpu->UsesSharedPresentation())
+            {
+                t.Fail("GPU compartida real requerida; el CPU de fallback no valida esta prueba");
+                return false;
+            }
+            GSSharedPresent::Frame startup{};
+            t.IsFalse(GSSharedPresent::Acquire(startup), "Un backend nuevo no hereda una textura del share group anterior");
+            return true;
+        }
+
+        void upload(uint32_t base, uint32_t bw, uint32_t psm, uint32_t width, uint32_t height,
+                    uint32_t variant = 0)
+        {
+            std::vector<uint8_t> pixels;
+            for (uint32_t y = 0; y < height; ++y)
+                for (uint32_t x = 0; x < width; ++x)
+                {
+                    const bool half = psm == GS_PSM_CT16 || psm == GS_PSM_CT16S;
+                    const uint32_t color = half
+                        ? 0x8000u | ((x + variant) & 31u) | ((y & 31u) << 5u) | (((x + y) & 31u) << 10u)
+                        : 0x80000000u | ((x * 3u + variant) & 255u) | (((y * 3u) & 255u) << 8u) |
+                          (((x + y * 7u) & 255u) << 16u);
+                    const unsigned bytes = half ? 2u : (psm == GS_PSM_CT24 ? 3u : 4u);
+                    for (unsigned byte = 0; byte < bytes; ++byte)
+                        pixels.push_back(static_cast<uint8_t>(color >> (byte * 8u)));
+                }
+            GSTransferCommand command{};
+            command.direction = 0;
+            command.bitbltbuf.dbp = base;
+            command.bitbltbuf.dbw = bw;
+            command.bitbltbuf.dpsm = static_cast<uint8_t>(psm);
+            command.trxreg = {static_cast<uint16_t>(width), static_cast<uint16_t>(height)};
+            for (GSRasterBackend *backend : {static_cast<GSRasterBackend *>(&cpu),
+                                            static_cast<GSRasterBackend *>(gpu.get())})
+            {
+                backend->BeginTransfer(command);
+                backend->UploadImage(pixels.data(), static_cast<uint32_t>(pixels.size()));
+            }
+        }
+
+        bool acquireNext(TestCase &t)
+        {
+            // GOW-Port: Acquire comprueba fences del driver; esperar solo en esta prueba.
+            const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+            GSSharedPresent::Frame next{};
+            while (std::chrono::steady_clock::now() < until)
+            {
+                if (GSSharedPresent::Acquire(next) && next.sequence > current.sequence)
+                {
+                    t.IsTrue(next.renderSequence > current.renderSequence, "Avanza la secuencia de composición");
+                    current = next;
+                    return true;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            }
+            t.Fail("No se recibió una composición compartida nueva dentro del plazo");
+            return false;
+        }
+
+        std::vector<uint8_t> compareCurrent(TestCase &t, const PresentationFrame &reference,
+                                            const std::string &label)
+        {
+            t.IsTrue(static_cast<bool>(reference), label + ": referencia CPU no vacía");
+            t.IsFalse(current.blank, label + ": circuitos activos");
+            t.Equals(current.width, reference.width, label + ": ancho lógico");
+            t.Equals(current.height, reference.height, label + ": alto lógico");
+            t.Equals(current.displayFbp, reference.displayFbp, label + ": destino en páginas");
+            t.Equals(current.sourceFbp, reference.sourceFbp, label + ": fuente en sus unidades originales");
+            t.Equals(current.usedPreferred, reference.usedPreferred, label + ": selección preferida");
+            if (!reference || current.width != reference.width || current.height != reference.height)
+                return {};
+            const Texture2D borrowed{current.texture, static_cast<int>(current.width),
+                                     static_cast<int>(current.height), 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+            OwnedImage image(borrowed);
+            if (!image.image.data || image.image.format != PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 ||
+                image.image.width != static_cast<int>(current.width) ||
+                image.image.height != static_cast<int>(current.height))
+            {
+                t.Fail(label + ": lectura real de la textura compartida requerida");
+                return {};
+            }
+            // GOW-Port: CPU tiene stride 640; la textura compartida tiene stride width.
+            const size_t rowBytes = static_cast<size_t>(reference.width) * 4u;
+            if (reference.pixels.size() < static_cast<size_t>(640u) * reference.height * 4u)
+            {
+                t.Fail(label + ": framebuffer CPU incompleto");
+                return {};
+            }
+            const auto *bytes = static_cast<const uint8_t *>(image.image.data);
+            for (uint32_t y = 0; y < reference.height; ++y)
+                if (!std::equal(bytes + y * rowBytes, bytes + (y + 1u) * rowBytes,
+                                reference.pixels.begin() + static_cast<size_t>(y) * 640u * 4u))
+                {
+                    t.Fail(label + ": píxeles diferentes en fila " + std::to_string(y));
+                    return {};
+                }
+            return {bytes, bytes + rowBytes * reference.height};
+        }
+
+        std::vector<uint8_t> present(TestCase &t, const GSPresentationRequest &request,
+                                   const std::string &label)
+        {
+            const auto reference = cpu.Present(request);
+            const auto returned = gpu->Present(request);
+            t.IsFalse(static_cast<bool>(returned), label + ": publicación compartida sin descarga CPU");
+            if (!acquireNext(t))
+                return {};
+            t.Equals(current.vsyncTick, request.vsyncTick, label + ": tick realmente compuesto");
+            return compareCurrent(t, reference, label);
+        }
+    };
+
+    void sharedSourcesAndBlank(TestCase &t)
+    {
+        RaylibSharedHost host;
+        if (!host.initialize(t)) return;
+        SharedFixture fixture;
+        if (!fixture.initialize(t)) return;
+        fixture.upload(32u * 32u, 1, GS_PSM_CT32, 64, 112);
+        GSPresentationRequest request{};
+        request.pmode = 1;
+        request.dispfb1 = 32ull | (1ull << 9u) | (7ull << 32u) | (9ull << 43u);
+        request.display1 = (63ull << 32u) | (95ull << 44u);
+        request.hasPreferredSource = true;
+        request.preferredDestFbp = 32;
+        request.preferredSource = {1057, 2, GS_PSM_CT32, 0};
+        for (const uint32_t format : {GS_PSM_CT32, GS_PSM_CT24, GS_PSM_CT16, GS_PSM_CT16S})
+        {
+            request.preferredSource.psm = static_cast<uint8_t>(format);
+            fixture.upload(1057, 2, format, 64, 96);
+            fixture.present(t, request, "Fuente preferida formato " + std::to_string(format));
+            t.IsTrue(fixture.current.usedPreferred, "El patrón sintético activa la fuente preferida");
+            t.Equals(fixture.current.sourceFbp, 1057u, "La fuente conserva el bloque no alineado a página");
+        }
+        request.hasPreferredSource = false;
+        fixture.present(t, request, "Origen CRTC distinto de cero sin preferredSource");
+        const auto enabledRequest = request;
+        request.pmode = 0;
+        t.IsFalse(static_cast<bool>(fixture.cpu.Present(request)), "PMODE apagado devuelve CPU vacío");
+        fixture.gpu->Present(request);
+        if (!fixture.acquireNext(t)) return;
+        t.IsTrue(fixture.current.blank, "PMODE apagado publica la transición vacía para el host");
+        t.Equals(fixture.current.width, 1u, "Textura interna vacía de un píxel");
+        t.Equals(fixture.current.height, 1u, "Textura interna vacía de una fila");
+        t.Equals(fixture.current.displayFbp, 0u, "Estado vacío sin destino CRTC");
+        t.Equals(fixture.current.sourceFbp, 0u, "Estado vacío sin fuente");
+        t.IsFalse(fixture.current.usedPreferred, "Estado vacío sin selección preferida");
+        const Texture2D blank{fixture.current.texture, 1, 1, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+        OwnedImage blankImage(blank);
+        if (!blankImage.image.data) t.Fail("Lectura real del marcador vacío requerida");
+        else
+        {
+            const auto *pixel = static_cast<const uint8_t *>(blankImage.image.data);
+            t.IsTrue(pixel[0] == 0 && pixel[1] == 0 && pixel[2] == 0 && pixel[3] == 255,
+                     "Marcador interno negro opaco; el host usa su placeholder CPU al ver blank");
+        }
+        fixture.present(t, enabledRequest, "Restaurar PMODE recupera imagen y metadatos");
+    }
+
+    void sharedCrtcFields(TestCase &t)
+    {
+        RaylibSharedHost host;
+        if (!host.initialize(t)) return;
+        SharedFixture fixture;
+        if (!fixture.initialize(t)) return;
+        fixture.upload(1024, 1, GS_PSM_CT24, 64, 66);
+        GSPresentationRequest request{};
+        request.pmode = 0x8023;
+        request.smode2 = 0x401;
+        request.dispfb2 = 32ull | (1ull << 9u) | (1ull << 15u);
+        request.dispfb1 = request.dispfb2 | (1ull << 43u);
+        request.display1 = (63ull << 32u) | (64ull << 44u);
+        request.display2 = (63ull << 32u) | (65ull << 44u);
+        const auto even = fixture.present(t, request, "Dos circuitos: campo par");
+        request.vsyncTick = 1;
+        const auto odd = fixture.present(t, request, "Dos circuitos: campo impar");
+        t.IsTrue(!even.empty() && !odd.empty() && even != odd, "Campos distintos con la misma VRAM");
+        request.smode2 = 0;
+        request.vsyncTick = 2;
+        const auto progressive = fixture.present(t, request, "Dos circuitos: progresivo");
+        const auto previous = fixture.current;
+        request.vsyncTick = 3;
+        fixture.gpu->Present(request);
+        fixture.gpu->Flush();
+        GSSharedPresent::Frame retained{};
+        t.IsTrue(GSSharedPresent::Acquire(retained), "Se conserva la última imagen completa");
+        t.Equals(retained.sequence, previous.sequence, "Progresivo sin cambios no recompone por paridad");
+        t.IsTrue(fixture.compareCurrent(t, fixture.cpu.Present(request), "Progresivo retenido") == progressive,
+                 "La imagen retenida conserva todas las filas");
+        for (const uint32_t alpha : {0u, 64u, 128u, 255u})
+        {
+            request.pmode = 3u | (1u << 5u) | (static_cast<uint64_t>(alpha) << 8u);
+            fixture.present(t, request, "Dos circuitos ALP " + std::to_string(alpha));
+        }
+        request.pmode = 0x8023;
+        request.smode2 = 0x401;
+        request.dispfb1 = 0x800000090d0ull;
+        request.dispfb2 = 0x90d0ull;
+        request.display1 = 0x1be9ff0203227cull;
+        request.display2 = 0x1bf9ff0203227cull;
+        fixture.upload(0xd0u * 32u, 8, GS_PSM_CT24, 512, 448);
+        request.vsyncTick = 0;
+        const auto gowEven = fixture.present(t, request, "Temporización GoW: campo par");
+        request.vsyncTick = 1;
+        const auto gowOdd = fixture.present(t, request, "Temporización GoW: campo impar");
+        t.IsTrue(!gowEven.empty() && !gowOdd.empty() && gowEven != gowOdd,
+                 "Temporización GoW alterna los campos con salida CPU exacta");
+    }
+
+    void sharedForcedReadback(TestCase &t)
+    {
+        RaylibSharedHost host;
+        if (!host.initialize(t)) return;
+        SharedFixture fixture;
+        if (!fixture.initialize(t)) return;
+        fixture.upload(32u * 32u, 1, GS_PSM_CT32, 64, 96);
+        GSPresentationRequest request{};
+        request.pmode = 1;
+        request.dispfb1 = 32ull | (1ull << 9u);
+        request.display1 = (63ull << 32u) | (95ull << 44u);
+        fixture.present(t, request, "Imagen inicial compartida");
+        const auto previous = fixture.current;
+        fixture.upload(32u * 32u, 1, GS_PSM_CT32, 64, 96, 83);
+        request.forceReadback = true;
+        // GOW-Port: la suite nativa arranca con async=false; reponer incluso si falla.
+        struct AsyncScope
+        {
+            AsyncScope() { GSGpuBackend::SetAsyncPresentDefault(true); }
+            ~AsyncScope() { GSGpuBackend::SetAsyncPresentDefault(false); }
+        } asynchronousDefault;
+        const auto expected = fixture.cpu.Present(request);
+        const auto returned = fixture.gpu->Present(request);
+        t.IsTrue(static_cast<bool>(returned), "forceReadback devuelve imagen aunque shared y async estén activos");
+        t.Equals(returned.width, expected.width, "Captura síncrona: ancho");
+        t.Equals(returned.height, expected.height, "Captura síncrona: alto");
+        t.Equals(returned.displayFbp, expected.displayFbp, "Captura síncrona: destino");
+        t.Equals(returned.sourceFbp, expected.sourceFbp, "Captura síncrona: fuente");
+        t.Equals(returned.usedPreferred, expected.usedPreferred, "Captura síncrona: selección");
+        const size_t bytes = static_cast<size_t>(640u) * expected.height * 4u;
+        t.IsTrue(returned.pixels.size() >= bytes && expected.pixels.size() >= bytes &&
+                 std::equal(expected.pixels.begin(), expected.pixels.begin() + bytes, returned.pixels.begin()),
+                 "Captura solicitada lee el request actual y no un PBO anterior");
+        GSSharedPresent::Frame retained{};
+        t.IsTrue(GSSharedPresent::Acquire(retained), "La captura no retira la imagen ya presentada");
+        t.Equals(retained.sequence, previous.sequence, "La lectura diagnóstica no publica otra textura");
+        request.forceReadback = false;
+        fixture.present(t, request, "El camino compartido continúa después de una captura");
+    }
+}
+#endif
+
+void runGpuSharedPresentGlTests()
+{
+#ifdef _WIN32
+    bool present = false;
+    const auto setting = sharedSetting("GOW_GS_GPU_TEST", present);
+    if (!present || setting != "1") return;
+    MiniTest::Case("GS GPU compositor compartido", [](TestCase &suite)
+    {
+        suite.Run("Fuente, dimensiones, unidades y transición PMODE", sharedSourcesAndBlank);
+        suite.Run("Dos circuitos, ALP, filas y campos GoW", sharedCrtcFields);
+        suite.Run("Captura diagnóstica síncrona mientras shared y async están activos", sharedForcedReadback);
+    });
+#endif
+}
diff --git a/ps2xTest/src/ps2_gs_host_present_tests.cpp b/ps2xTest/src/ps2_gs_host_present_tests.cpp
new file mode 100644
index 0000000..0ade394
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_host_present_tests.cpp
@@ -0,0 +1,277 @@
+// GOW-Port: el consumidor raylib de producción, con GS procedural y ventana oculta.
+#include "MiniTest.h"
+#include <cstdlib>
+
+#ifdef _WIN32
+#include "runtime/gs/gs_host_present.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/gs_gpu_backend.h"
+#include "runtime/gs/gs_threaded_backend.h"
+#include "runtime/gs/gs_swizzle.h"
+#include "runtime/gs/ps2_gs_memory.h"
+#include "runtime/ps2_memory.h"
+#include "rlgl.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace
+{
+    constexpr uint32_t kSourceWidth = 64u;
+    constexpr uint32_t kSourceHeight = 96u;
+
+    class Setting
+    {
+        bool present = false;
+        std::string previous;
+    public:
+        explicit Setting(bool shared)
+        {
+            char *value = nullptr;
+            size_t size = 0u;
+            if (_dupenv_s(&value, &size, "PS2X_GS_DIRECT_PRESENT") != 0)
+                throw std::runtime_error("No se pudo leer el modo de presentación");
+            const std::unique_ptr<char, decltype(&std::free)> owned(value, &std::free);
+            present = value != nullptr;
+            if (present)
+                previous = value;
+            if (_putenv_s("PS2X_GS_DIRECT_PRESENT", shared ? "1" : "0") != 0)
+                throw std::runtime_error("No se pudo seleccionar el modo de presentación");
+        }
+        ~Setting() { _putenv_s("PS2X_GS_DIRECT_PRESENT", present ? previous.c_str() : ""); }
+    };
+
+    class HiddenWindow
+    {
+        bool owned = false;
+    public:
+        bool open(TestCase &t, int width, int height)
+        {
+            if (IsWindowReady())
+            {
+                t.Fail("El control necesita su propia ventana raylib, no una ventana ajena");
+                return false;
+            }
+            SetConfigFlags(FLAG_WINDOW_HIDDEN);
+            InitWindow(width, height, "GS host procedural");
+            owned = IsWindowReady();
+            if (!owned)
+            {
+                t.Fail("Ventana raylib oculta requerida");
+                return false;
+            }
+            SetTargetFPS(60);
+            t.Equals(rlGetVersion(), static_cast<int>(RL_OPENGL_33), "Host raylib con la API OpenGL 3.3 del juego");
+            return true;
+        }
+        ~HiddenWindow()
+        {
+            if (owned)
+                CloseWindow();
+        }
+    };
+
+    struct Capture
+    {
+        std::vector<uint8_t> pixels;
+        uint32_t width = 0u, height = 0u;
+        bool operator==(const Capture &other) const
+        {
+            return width == other.width && height == other.height && pixels == other.pixels;
+        }
+    };
+
+    class Source
+    {
+        bool started = false;
+    public:
+        GS gs;
+        GSHostPresentation host;
+        GSRegisters registers{};
+        std::vector<uint8_t> memory = std::vector<uint8_t>(GSSwizzle::kMemorySize);
+        uint64_t tick = 0u;
+
+        void initialize(bool shared)
+        {
+            GSMem::InitLookupTables();
+            for (uint32_t y = 0u; y < kSourceHeight; ++y)
+                for (uint32_t x = 0u; x < kSourceWidth; ++x)
+                {
+                    uint32_t color = 0xff000000u | ((x * 13u + 17u) & 255u) |
+                                     (((y * 7u + 29u) & 255u) << 8u) |
+                                     ((((x + y) * 11u + 41u) & 255u) << 16u);
+                    if ((y & 1u) == 0u)
+                        color ^= 0x00804020u; // Líneas alternas que hacen visible LINEAR.
+                    if (x < 4u && y < 4u) color = 0xff0037d0u;
+                    if (x >= kSourceWidth - 4u && y < 4u) color = 0xffe03020u;
+                    if (x < 4u && y >= kSourceHeight - 4u) color = 0xff60f030u;
+                    if (x >= kSourceWidth - 4u && y >= kSourceHeight - 4u) color = 0xff3020e0u;
+                    GSMem::WriteCT32(memory.data(), 0u, 1u, x, y, color);
+                }
+            host.captureHostContext();
+            started = true;
+            if (shared)
+            {
+                auto gpu = std::make_unique<GSGpuBackend>();
+                gpu->SetHardwareRasterAllowed(false);
+                gs.setRasterBackend(std::make_unique<GSThreadedBackend>(std::move(gpu)));
+            }
+            else
+                gs.setRasterBackend(std::make_unique<GSCpuBackend>());
+            gs.init(memory.data(), static_cast<uint32_t>(memory.size()), &registers);
+            registers.pmode = 1u;
+            registers.dispfb1 = 1ull << 9u;
+            registers.display1 = (uint64_t{kSourceWidth - 1u} << 32u) | (uint64_t{kSourceHeight - 1u} << 44u);
+            host.restoreHostContext();
+        }
+
+        GSHostPresentation::View render(TestCase &t, Capture &capture)
+        {
+            registers.vsyncTick.store(++tick, std::memory_order_release);
+            return host.renderFrame(gs, tick, [&]
+            {
+                // GOW-Port: observar el backbuffer después del mismo DrawTexturePro.
+                // EndDrawing de producción sigue cerrando el batch y el cuadro.
+                rlDrawRenderBatchActive();
+                Image image = LoadImageFromScreen();
+                if (!image.data || image.width <= 0 || image.height <= 0)
+                {
+                    t.Fail("No se pudo leer el framebuffer real del host");
+                    return;
+                }
+                ImageFormat(&image, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+                capture.width = static_cast<uint32_t>(image.width);
+                capture.height = static_cast<uint32_t>(image.height);
+                const auto *bytes = static_cast<const uint8_t *>(image.data);
+                capture.pixels.assign(bytes, bytes + static_cast<size_t>(capture.width) * capture.height * 4u);
+                UnloadImage(image);
+            });
+        }
+
+        GSHostPresentation::View await(TestCase &t, Capture &capture, bool blank, uint64_t after = 0u)
+        {
+            const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(15);
+            GSHostPresentation::View view;
+            do
+            {
+                view = render(t, capture);
+                if (view.shared && view.frame.sequence > after && view.blank == blank)
+                    return view;
+            } while (std::chrono::steady_clock::now() < deadline);
+            t.Fail("No se adquirió un frame compartido efectivo con el estado solicitado");
+            return view;
+        }
+
+        void close()
+        {
+            if (!started)
+                return;
+            host.shutdown(gs); // Destruye y une el worker antes de cerrar raylib.
+            started = false;
+        }
+        ~Source() { close(); }
+    };
+
+    Capture cpuReference(TestCase &t, int width, int height, bool blank)
+    {
+        Setting setting(false);
+        HiddenWindow window;
+        Capture capture;
+        if (!window.open(t, width, height))
+            return capture;
+        Source source;
+        source.initialize(false);
+        t.IsFalse(source.gs.usesSharedPresentation(), "El control usa el compositor CPU/RAM");
+        if (blank)
+            source.registers.pmode = 0u;
+        const auto view = source.render(t, capture);
+        t.IsFalse(view.shared, "La UI de referencia no consume una textura compartida");
+        t.Equals(view.blank, blank, "El placeholder CPU corresponde al display apagado");
+        return capture;
+    }
+
+    void scaledHost(TestCase &t, int width, int height)
+    {
+        const Capture reference = cpuReference(t, width, height, false);
+        if (reference.pixels.empty())
+            return;
+        Setting setting(true);
+        HiddenWindow window;
+        if (!window.open(t, width, height))
+            return;
+        Source source;
+        source.initialize(true);
+        t.IsTrue(source.gs.usesSharedPresentation(), "Backend GPU/worker efectivamente compartido");
+        Capture actual;
+        const auto view = source.await(t, actual, false);
+        t.IsTrue(view.borrowed && view.texture.id == view.frame.texture && view.frame.texture != 0u,
+                 "El helper dibuja la textura prestada del productor");
+        t.Equals(view.width, kSourceWidth, "Usa el ancho efectivo publicado");
+        t.Equals(view.height, kSourceHeight, "Usa el alto efectivo publicado");
+        t.IsTrue(actual == reference, "Framebuffer escalado, filas, filtro y franjas coinciden exactamente con CPU");
+        Capture retained;
+        const auto again = source.render(t, retained);
+        t.Equals(again.frame.sequence, view.frame.sequence, "Sin cambios conserva el mismo frame");
+        t.IsTrue(again.borrowed && retained == reference, "Repetir el cuadro no hace readback ni pierde el slot");
+        const uint32_t borrowedId = view.texture.id;
+        source.close(); source.close(); // El segundo cierre no vuelve a descargar la textura.
+        t.IsFalse(GSSharedPresent::Active(), "El cierre limpia el share group con el host vivo");
+        t.IsFalse(source.gs.usesSharedPresentation(), "El backend de cierre es CPU y no conserva un contexto muerto");
+        Image probe = GenImageColor(2, 2, RED);
+        Texture2D owned = LoadTextureFromImage(probe);
+        UnloadImage(probe);
+        t.IsTrue(owned.id != 0u, "El contexto host sigue operativo después de destruir el worker");
+        UnloadTexture(owned);
+        t.IsTrue(borrowedId != 0u, "El control había utilizado una textura compartida real");
+    }
+
+    void blankTransition(TestCase &t)
+    {
+        constexpr int width = 160, height = 192;
+        const Capture displayed = cpuReference(t, width, height, false);
+        const Capture placeholder = cpuReference(t, width, height, true);
+        t.IsFalse(displayed == placeholder, "El control distingue escena y placeholder magenta");
+        Setting setting(true);
+        HiddenWindow window;
+        if (!window.open(t, width, height))
+            return;
+        Source source;
+        source.initialize(true);
+        Capture capture;
+        const auto first = source.await(t, capture, false);
+        t.IsTrue(capture == displayed, "Comienza con la imagen procedural");
+        source.registers.pmode = 0u;
+        const auto blank = source.await(t, capture, true, first.frame.sequence);
+        t.IsTrue(blank.frame.blank && !blank.borrowed && blank.texture.id != blank.frame.texture,
+                 "Display apagado usa placeholder propio, no la textura negra ni la escena anterior");
+        t.Equals(blank.width, 640u, "Mantiene el ancho del placeholder RAM");
+        t.Equals(blank.height, 448u, "Mantiene el alto del placeholder RAM");
+        t.IsTrue(capture == placeholder, "La transición a magenta y las franjas coinciden con CPU");
+        source.registers.pmode = 1u;
+        const auto recovered = source.await(t, capture, false, blank.frame.sequence);
+        t.IsTrue(recovered.borrowed && capture == displayed, "Reactivar PMODE recupera el frame correcto");
+    }
+}
+#endif
+
+void runGsHostPresentTests()
+{
+#ifdef _WIN32
+    const char *setting = std::getenv("GOW_GS_GPU_TEST");
+    if (!setting || *setting != '1')
+        return;
+    MiniTest::Case("GS consumidor host raylib real", [](TestCase &suite)
+    {
+        suite.Run("Escala 1 conserva filas y franjas", [](TestCase &t) { scaledHost(t, 96, 96); });
+        suite.Run("Escala 2 conserva NEAREST y franjas", [](TestCase &t) { scaledHost(t, 160, 192); });
+        suite.Run("Escala no entera conserva NEAREST y filas", [](TestCase &t) { scaledHost(t, 123, 157); });
+        suite.Run("PMODE apagado muestra placeholder magenta y vuelve a la escena", blankTransition);
+    });
+#endif
+}
diff --git a/ps2xTest/src/ps2_gs_shared_queue_tests.cpp b/ps2xTest/src/ps2_gs_shared_queue_tests.cpp
new file mode 100644
index 0000000..1eabf09
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_shared_queue_tests.cpp
@@ -0,0 +1,332 @@
+// GOW-Port: frontend y cola reales; backend procedural detenido sin sleeps ni assets.
+#include "MiniTest.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/gs_threaded_backend.h"
+#include "runtime/gs/gs_shared_present.h"
+#include "runtime/gs/gs_swizzle.h"
+#include "runtime/ps2_memory.h"
+
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace
+{
+    enum Event { Draw = 1, Present = 2, Read = 3, Finish = 4, Capture = 5, Flush = 6 };
+    struct Recording
+    {
+        std::mutex mutex;
+        std::condition_variable cv;
+        bool holdDraw = false;
+        bool drawEntered = false;
+        bool drawReleased = false;
+        bool hostReturned = false;
+        std::vector<int> events;
+        std::vector<GSPresentationRequest> requests;
+        uint32_t drawCount = 0u;
+        uint32_t finishCount = 0u;
+        uint32_t captures = 0u;
+        std::thread::id owner;
+        std::thread::id captureOwner;
+
+        template<class Predicate>
+        bool wait(Predicate predicate)
+        {
+            std::unique_lock<std::mutex> lock(mutex);
+            // GOW-Port: limite anti-deadlock del control negativo, no una espera para medir asincronia.
+            return cv.wait_for(lock, std::chrono::seconds(5), predicate);
+        }
+        void release()
+        {
+            { std::lock_guard<std::mutex> lock(mutex); drawReleased = true; }
+            cv.notify_all();
+        }
+    };
+
+    class ProceduralBackend final : public GSRasterBackend
+    {
+        Recording &r;
+        bool shared;
+    public:
+        ProceduralBackend(Recording &recording, bool isShared) : r(recording), shared(isShared) {}
+        bool UsesSharedPresentation() const override { return shared; }
+        void Initialize(uint8_t *, uint32_t) override { r.owner = std::this_thread::get_id(); }
+        void Reset() override {}
+        void Submit(const GSPrimitiveBatch &) override
+        {
+            std::unique_lock<std::mutex> lock(r.mutex);
+            if (r.holdDraw)
+            {
+                r.drawEntered = true;
+                r.cv.notify_all();
+                r.cv.wait(lock, [&] { return r.drawReleased; });
+            }
+            ++r.drawCount;
+            r.events.push_back(Draw);
+        }
+        void LoadClut(const GSTex0Reg &, const GSTexClutReg &) override {}
+        void BeginTransfer(const GSTransferCommand &) override {}
+        void UploadImage(const uint8_t *, uint32_t) override {}
+        void Flush() override { std::lock_guard<std::mutex> lock(r.mutex); r.events.push_back(::Flush); }
+        void TextureFlush() override {}
+        void Sync(GSSyncReason reason) override
+        {
+            if (reason == GSSyncReason::Finish)
+            {
+                std::lock_guard<std::mutex> lock(r.mutex);
+                ++r.finishCount;
+                r.events.push_back(Finish);
+            }
+        }
+        PresentationFrame Present(const GSPresentationRequest &request) override
+        {
+            std::lock_guard<std::mutex> lock(r.mutex);
+            r.requests.push_back(request);
+            if (request.forceReadback)
+            {
+                r.events.push_back(Capture);
+                ++r.captures;
+                r.captureOwner = std::this_thread::get_id();
+            }
+            else r.events.push_back(::Present);
+            if ((shared && !request.forceReadback) || (request.pmode & 3u) == 0u)
+                return {};
+            PresentationFrame frame;
+            frame.width = 64u;
+            frame.height = 2u;
+            frame.displayFbp = static_cast<uint32_t>(request.dispfb1 & 0x1ffu);
+            frame.usedPreferred = request.hasPreferredSource;
+            frame.sourceFbp = request.hasPreferredSource ? request.preferredSource.fbp : frame.displayFbp;
+            frame.pixels.resize(640u * frame.height * 4u, 0xeeu);
+            const uint32_t color = 0x80302000u | (frame.displayFbp & 0xffu);
+            for (uint32_t y = 0u; y < frame.height; ++y)
+                for (uint32_t x = 0u; x < frame.width; ++x)
+                {
+                    const uint32_t value = color + (y << 8u) + x;
+                    std::memcpy(frame.pixels.data() + (y * 640u + x) * 4u, &value, 4u);
+                }
+            return frame;
+        }
+        bool ClearFramebuffer(const GSContext &, uint32_t) override { return false; }
+        uint32_t ConsumeLocalToHostBytes(uint8_t *, uint32_t) override { return 0u; }
+        uint32_t ReadVram(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) const override
+        {
+            std::lock_guard<std::mutex> lock(r.mutex);
+            r.events.push_back(Read);
+            return (r.finishCount << 16u) | r.drawCount;
+        }
+        void WriteVram(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) override {}
+        void SnapshotVram(std::vector<uint8_t> &out) const override { out.clear(); }
+        GSTransferSnapshot GetTransferSnapshot() const override { return {}; }
+    };
+
+    struct Fixture
+    {
+        Recording recording;
+        std::vector<uint8_t> vram = std::vector<uint8_t>(GSSwizzle::kMemorySize);
+        GSRegisters registers{};
+        GS gs;
+        GSThreadedBackend *threaded = nullptr;
+        explicit Fixture(bool shared = true)
+        {
+            registers.pmode = 1u;
+            registers.dispfb1 = 12u;
+            registers.vsyncTick.store(31u);
+            gs.init(vram.data(), static_cast<uint32_t>(vram.size()), &registers);
+            auto backend = std::make_unique<GSThreadedBackend>(std::make_unique<ProceduralBackend>(recording, shared));
+            threaded = backend.get();
+            gs.setRasterBackend(std::move(backend));
+            recording.events.clear();
+        }
+        ~Fixture() { recording.release(); }
+        void point()
+        {
+            gs.writeRegister(GS_REG_PRIM, GS_PRIM_POINT);
+            gs.writeRegister(GS_REG_RGBAQ, 0x3f80000080403020ull);
+            gs.writeRegister(GS_REG_XYZ2, 0x00100010u);
+        }
+    };
+}
+
+void runGsSharedQueueTests()
+{
+    MiniTest::Case("GS shared presentation queue", [](TestCase &t)
+    {
+        t.Run("shared frontend returns before held draw and preserves FIFO requests", [](TestCase &t)
+        {
+            Fixture f;
+            f.recording.holdDraw = true;
+            f.point();
+            std::thread host([&]
+            {
+                f.gs.latchHostPresentationFrame();
+                { std::lock_guard<std::mutex> lock(f.recording.mutex); f.recording.hostReturned = true; }
+                f.recording.cv.notify_all();
+            });
+            const bool entered = f.recording.wait([&] { return f.recording.drawEntered; });
+            const bool returnedWhileHeld = f.recording.wait([&] { return f.recording.hostReturned; });
+            if (returnedWhileHeld)
+            {
+                f.registers.dispfb1 = 19u;
+                f.registers.vsyncTick.store(32u);
+                f.gs.latchHostPresentationFrame();
+            }
+            f.recording.release();
+            host.join();
+            f.threaded->ReadVram(0u, 0u, 1u, 0u, 0u);
+            t.IsTrue(entered, "El worker se detuvo dentro del dibujo real encolado por GS");
+            t.IsTrue(returnedWhileHeld, "El latch retorna sin liberar al worker");
+            t.IsTrue(f.recording.events == std::vector<int>({Draw, Present, Present, Read}),
+                     "Draw y requests anteriores conservan FIFO sin Flush del host");
+            t.Equals(f.recording.captures, 0u, "Presentacion normal no descarga pixeles");
+            t.Equals(f.recording.requests.size(), size_t(2u), "Ambas presentaciones llegaron al worker");
+            if (f.recording.requests.size() == 2u)
+            {
+                t.Equals(f.recording.requests[0].dispfb1, 12ull, "Primer request copiado al encolar");
+                t.Equals(f.recording.requests[0].vsyncTick, 31ull, "Primer tick no recibe el posterior");
+                t.Equals(f.recording.requests[1].dispfb1, 19ull, "Segundo CRTC mantiene su orden");
+                t.Equals(f.recording.requests[1].vsyncTick, 32ull, "Segundo tick pertenece a su request");
+            }
+        });
+
+        t.Run("shared diagnostics read on worker with latched CRTC and cache generation", [](TestCase &t)
+        {
+            Fixture f;
+            std::vector<uint8_t> pixels;
+            uint32_t width = 0u, height = 0u, display = 0u, source = 0u;
+            bool preferred = true;
+            t.IsFalse(f.gs.copyLatchedHostPresentationFrame(pixels, width, height),
+                      "Sin latch anterior no se inventa un request para capturar");
+            t.Equals(f.recording.captures, 0u, "Sin latch no se consulta al worker");
+            f.gs.latchHostPresentationFrame();
+            f.registers.dispfb1 = 25u;
+            f.registers.vsyncTick.store(41u);
+            t.IsTrue(f.gs.copyLatchedHostPresentationFrame(pixels, width, height, &display, &source, &preferred),
+                     "La captura explicita conserva la API de copia en modo shared");
+            t.Equals(width, 64u, "Ancho del compositor capturado");
+            t.Equals(height, 2u, "Alto del compositor capturado");
+            t.Equals(display, 12u, "La captura usa el CRTC latched, no los registros posteriores");
+            t.Equals(source, 12u, "Fuente devuelta por el compositor");
+            t.IsFalse(preferred, "No se inventa preferredSource");
+            t.Equals(pixels.size(), size_t(64u * 2u * 4u), "Filas de 640 compactadas sin padding");
+            if (pixels.size() == 64u * 2u * 4u)
+            {
+                uint32_t first = 0u, secondRow = 0u;
+                std::memcpy(&first, pixels.data(), 4u);
+                std::memcpy(&secondRow, pixels.data() + 64u * 4u, 4u);
+                t.Equals(first, 0x8030200cu, "Contenido real de la captura");
+                t.Equals(secondRow, 0x8030210cu, "La segunda fila no toma el padding");
+            }
+            t.IsTrue(f.recording.captureOwner == f.recording.owner, "Lectura en el mismo hilo propietario");
+            t.IsFalse(f.recording.captureOwner == std::this_thread::get_id(), "Nunca descarga desde EE/host");
+            t.Equals(f.recording.captures, 1u, "Una descarga explicita");
+            f.gs.copyLatchedHostPresentationFrame(pixels, width, height);
+            t.Equals(f.recording.captures, 1u, "Repetir la copia no repite el readback del mismo latch");
+            f.gs.latchHostPresentationFrame();
+            f.gs.copyLatchedHostPresentationFrame(pixels, width, height, &display);
+            t.Equals(f.recording.captures, 2u, "Un nuevo latch invalida la captura anterior");
+            t.Equals(display, 25u, "La nueva captura incorpora el CRTC del nuevo latch");
+            f.registers.pmode = 0u;
+            f.gs.latchHostPresentationFrame();
+            t.IsFalse(f.gs.copyLatchedHostPresentationFrame(pixels, width, height, &display, &source, &preferred),
+                      "PMODE deshabilitado no conserva una captura vieja");
+            t.IsTrue(pixels.empty() && width == 0u && height == 0u && display == 0u && source == 0u && !preferred,
+                     "La captura vacia limpia todos sus outputs");
+        });
+
+        t.Run("shared FINISH and reads retain barriers after held draws", [](TestCase &t)
+        {
+            Fixture f;
+            f.recording.holdDraw = true;
+            f.point();
+            f.gs.latchHostPresentationFrame();
+            const bool entered = f.recording.wait([&] { return f.recording.drawEntered; });
+            uint32_t result = 0u;
+            uint32_t observedAfterFinish = 0u;
+            std::thread reader([&]
+            {
+                f.threaded->Sync(GSSyncReason::Finish);
+                {
+                    std::lock_guard<std::mutex> lock(f.recording.mutex);
+                    observedAfterFinish = (f.recording.finishCount << 16u) | f.recording.drawCount;
+                    f.recording.hostReturned = true;
+                }
+                f.recording.cv.notify_all();
+                result = f.gs.ReadVram(0u, 0u, 1u, 0u, 0u);
+            });
+            // GOW-Port: si FINISH retorna antes de soltar el draw, el estado observado sera cero.
+            // En la ruta correcta el limite del control libera el worker para que la prueba cierre.
+            const bool returnedWhileHeld = f.recording.wait([&] { return f.recording.hostReturned; });
+            f.recording.release();
+            reader.join();
+            t.IsTrue(entered, "El dibujo anterior estaba detenido");
+            t.IsFalse(returnedWhileHeld, "FINISH no retorna con el dibujo anterior detenido");
+            t.Equals(observedAfterFinish, 0x00010001u, "Al retornar FINISH sus efectos ya son visibles");
+            t.Equals(result, 0x00010001u, "Lectura solo retorna despues del dibujo y FINISH");
+            t.IsTrue(f.recording.events == std::vector<int>({Draw, Present, Finish, Read}),
+                     "FINISH conserva la barrera y orden en la misma cola compartida");
+        });
+
+        t.Run("nonshared frontend retains synchronous pixel path", [](TestCase &t)
+        {
+            Fixture f(false);
+            f.point();
+            f.gs.latchHostPresentationFrame();
+            std::vector<uint8_t> pixels;
+            uint32_t width = 0u, height = 0u, display = 0u;
+            t.IsFalse(f.gs.usesSharedPresentation(), "La instancia CPU no toma sharing de otro backend");
+            t.IsTrue(f.gs.copyLatchedHostPresentationFrame(pixels, width, height, &display),
+                     "El latch sin sharing conserva pixeles disponibles al retornar");
+            t.Equals(display, 12u, "Metadata normal del backend");
+            t.Equals(f.recording.captures, 0u, "No fuerza otra presentacion para copiar pixeles CPU");
+            t.IsTrue(f.recording.events == std::vector<int>({Draw, Flush, Present}),
+                     "CPU conserva Flush y composicion sincrona");
+        });
+
+        t.Run("shared acquired metadata belongs to displayed frame not next request", [](TestCase &t)
+        {
+            Fixture f;
+            f.gs.setDebugHistoryPaused(false);
+            f.gs.latchHostPresentationFrame();
+            GSSharedPresent::Frame shared;
+            shared.sequence = 8u;
+            shared.vsyncTick = 28u;
+            shared.width = 64u;
+            shared.height = 96u;
+            shared.displayFbp = 17u;
+            shared.sourceFbp = 29u;
+            shared.usedPreferred = true;
+            f.gs.recordAcquiredSharedFrame(shared);
+            f.registers.dispfb1 = 31u;
+            f.gs.latchHostPresentationFrame();
+            f.gs.recordAcquiredSharedFrame(shared);
+            const auto snapshot = f.gs.getDebugSnapshot();
+            t.Equals(snapshot.hostPresentationDisplayFbp, 17u, "Se muestran metadatos del frame retenido");
+            t.Equals(snapshot.hostPresentationSourceFbp, 29u, "Fuente correcta del compositor adquirido");
+            t.IsTrue(snapshot.hostPresentationUsedPreferred, "Preferred del frame adquirido");
+            t.IsTrue(snapshot.hasHostPresentationFrame, "Shared tiene frame aunque no haya pixeles RAM");
+            const auto history = f.gs.getDebugHistory();
+            uint32_t presents = 0u;
+            for (const auto &event : history)
+                if (event.kind == GSDebugEventKind::Present)
+                {
+                    ++presents;
+                    t.Equals(event.displayFbp, 17u, "Evento del frame adquirido");
+                    t.Equals(event.sourceFbp, 29u, "Evento conserva fuente adquirida");
+                    t.Equals(event.vsyncTick, 28ull, "Tick del frame adquirido, no del request posterior");
+                }
+            t.Equals(presents, 1u, "Repetir slot no duplica eventos de presentacion");
+            shared.sequence = 9u;
+            shared.blank = true;
+            f.gs.recordAcquiredSharedFrame(shared);
+            const auto blank = f.gs.getDebugSnapshot();
+            t.IsFalse(blank.hasHostPresentationFrame, "Blank invalida estado de display previo");
+            t.Equals(blank.hostPresentationWidth, 0u, "Blank equivale a frame RAM vacio");
+            t.Equals(blank.hostPresentationDisplayFbp, 0u, "Blank limpia metadata previa");
+        });
+    });
+}
