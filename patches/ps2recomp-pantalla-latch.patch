+    const uint64_t field[7] = {m_privRegs->pmode, m_privRegs->smode2, m_privRegs->dispfb1, m_privRegs->display1,
+                               m_privRegs->dispfb2, m_privRegs->display2, m_privRegs->bgcolor};
