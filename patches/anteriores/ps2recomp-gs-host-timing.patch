diff --git a/ps2xRuntime/cmake/GowRaylibEndDrawing.cmake b/ps2xRuntime/cmake/GowRaylibEndDrawing.cmake
new file mode 100644
index 0000000..e4ee85a
--- /dev/null
+++ b/ps2xRuntime/cmake/GowRaylibEndDrawing.cmake
@@ -0,0 +1,62 @@
+# GOW-Port: instrumentar una copia de rcore.c, nunca el source de FetchContent.
+function(ps2x_instrument_end_drawing)
+    get_target_property(ray_source raylib SOURCE_DIR)
+    set(original "${ray_source}/rcore.c")
+    file(READ "${original}" core)
+    string(REPLACE "\r\n" "\n" core "${core}")
+    string(SHA256 digest "${core}")
+    if(NOT digest STREQUAL "cb8d42cb286e9c5fa1666296b3e82d28d4e39469bd588c9b3643ad3564a98d9e")
+        message(FATAL_ERROR "GOW-Port: rcore.c no corresponde al source raylib 5.5 comprobado")
+    endif()
+    # La huella del archivo completo fija también condiciones, orden y anchors.
+    set(hook [=[// GOW-Port: callback opcional del hilo host; sin reloj si es nulo.
+typedef void (*GowEndDrawingPhaseHook)(void *user, int phase, int begin);
+static GowEndDrawingPhaseHook gowEndDrawingPhaseHook = NULL;
+static void *gowEndDrawingPhaseUser = NULL;
+RLAPI void GowSetEndDrawingPhaseHook(GowEndDrawingPhaseHook hook, void *user)
+{
+    gowEndDrawingPhaseHook = hook;
+    gowEndDrawingPhaseUser = user;
+}
+static void GowEndDrawingPhase(int phase, int begin)
+{
+    if (gowEndDrawingPhaseHook != NULL)
+        gowEndDrawingPhaseHook(gowEndDrawingPhaseUser, phase, begin);
+}
+
+]=])
+    string(REPLACE "// End canvas drawing and swap buffers (double buffering)"
+        "${hook}// End canvas drawing and swap buffers (double buffering)" core "${core}")
+    string(REPLACE "void EndDrawing(void)\n{\n    rlDrawRenderBatchActive();      // Update and draw internal render batch"
+        "void EndDrawing(void)\n{\n    GowEndDrawingPhase(0, 1);\n    rlDrawRenderBatchActive();      // Update and draw internal render batch\n    GowEndDrawingPhase(0, 0);" core "${core}")
+    string(REPLACE "    SwapScreenBuffer();                  // Copy back buffer to front buffer (screen)"
+        "    GowEndDrawingPhase(1, 1);\n    SwapScreenBuffer();                  // Copy back buffer to front buffer (screen)\n    GowEndDrawingPhase(1, 0);" core "${core}")
+    string(REPLACE "        WaitTime(CORE.Time.target - CORE.Time.frame);"
+        "        GowEndDrawingPhase(2, 1);\n        WaitTime(CORE.Time.target - CORE.Time.frame);\n        GowEndDrawingPhase(2, 0);" core "${core}")
+    string(REPLACE "    PollInputEvents();      // Poll user events (before next frame update)"
+        "    GowEndDrawingPhase(3, 1);\n    PollInputEvents();      // Poll user events (before next frame update)\n    GowEndDrawingPhase(3, 0);" core "${core}")
+    set(generated "${CMAKE_CURRENT_BINARY_DIR}/gow-raylib/rcore.c")
+    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/gow-raylib")
+    # configure_file evita recompilar si la copia generada no cambia.
+    set(temporary "${CMAKE_CURRENT_BINARY_DIR}/gow-raylib/rcore.input.c")
+    file(WRITE "${temporary}" "${core}")
+    configure_file("${temporary}" "${generated}" COPYONLY)
+    get_target_property(sources raylib SOURCES)
+    set(replaced 0)
+    set(instrumented)
+    foreach(source IN LISTS sources)
+        get_filename_component(leaf "${source}" NAME)
+        if(leaf STREQUAL "rcore.c")
+            list(APPEND instrumented "${generated}")
+            math(EXPR replaced "${replaced} + 1")
+        else()
+            list(APPEND instrumented "${source}")
+        endif()
+    endforeach()
+    if(NOT replaced EQUAL 1)
+        message(FATAL_ERROR "GOW-Port: se esperaba un solo rcore.c en raylib")
+    endif()
+    set_property(TARGET raylib PROPERTY SOURCES "${instrumented}")
+    target_include_directories(raylib PRIVATE "${ray_source}")
+    message(STATUS "GOW-Port: EndDrawing optativo en copia privada: ${generated}")
+endfunction()
diff --git a/ps2xRuntime/include/runtime/gs/gs_host_perf.h b/ps2xRuntime/include/runtime/gs/gs_host_perf.h
new file mode 100644
index 0000000..63f3d6c
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_host_perf.h
@@ -0,0 +1,141 @@
+// GOW-Port: subtotales incluidos en HostWait; sólo el hilo host escribe/lee.
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstdio>
+
+namespace GSHostPerf
+{
+    enum class Phase : uint32_t { Batch, Swap, Limiter, Events, Count };
+    constexpr uint32_t phaseCount = static_cast<uint32_t>(Phase::Count);
+    struct TimingTotals
+    {
+        std::array<uint64_t, phaseCount> nanos{}, calls{};
+        uint64_t endNanos = 0u, endCalls = 0u, otherNanos = 0u, errors = 0u;
+    };
+    // Reloj inyectado por el llamador: no sleeps ni scopes ps2_perf anidados.
+    class Timing
+    {
+        bool running = false;
+        int active = -1, last = -1;
+        uint64_t frameSince = 0u, phaseSince = 0u, charged = 0u;
+        uint64_t elapsed(uint64_t since, uint64_t now)
+        {
+            if (now < since) { ++totals.errors; return 0u; }
+            return now - since;
+        }
+    public:
+        TimingTotals totals;
+        void begin(uint64_t now)
+        {
+            if (running) { ++totals.errors; return; }
+            running = true;
+            active = last = -1;
+            frameSince = now;
+            charged = 0u;
+        }
+        void edge(int phase, bool start, uint64_t now)
+        {
+            if (!running || phase < 0 || phase >= static_cast<int>(phaseCount))
+            { ++totals.errors; return; }
+            if (start)
+            {
+                if (active != -1 || phase <= last) { ++totals.errors; return; }
+                active = phase;
+                phaseSince = now;
+            }
+            else
+            {
+                if (active != phase) { ++totals.errors; return; }
+                const uint64_t value = elapsed(phaseSince, now);
+                totals.nanos[phase] += value;
+                ++totals.calls[phase];
+                charged += value;
+                last = phase;
+                active = -1;
+            }
+        }
+        void end(uint64_t now)
+        {
+            if (!running) { ++totals.errors; return; }
+            if (active != -1)
+            {
+                ++totals.errors;
+                edge(active, false, now);
+            }
+            const uint64_t value = elapsed(frameSince, now);
+            totals.endNanos += value;
+            ++totals.endCalls;
+            if (charged > value) ++totals.errors;
+            else totals.otherNanos += value - charged;
+            running = false;
+        }
+        void reset() { *this = {}; }
+    };
+
+    struct Sends
+    {
+        uint64_t total = 0u, sharedTexture = 0u, sharedBlank = 0u, sharedFallback = 0u;
+        uint64_t changed = 0u, reused = 0u, ram = 0u, ramBlank = 0u, epochs = 0u;
+    };
+    struct Sample
+    {
+        bool shared, acquired, borrowed, blank, frameBlank;
+        uint64_t sequence;
+    };
+    class Sequences
+    {
+        bool known = false;
+        uint64_t previous = 0u;
+    public:
+        Sends totals;
+        void beginEpoch() { known = false; previous = 0u; ++totals.epochs; }
+        void observe(const Sample &sample)
+        {
+            ++totals.total;
+            if (!sample.shared)
+            {
+                ++totals.ram;
+                if (sample.blank) ++totals.ramBlank;
+                return;
+            }
+            if (sample.acquired && sample.sequence != 0u)
+            {
+                if (known && previous == sample.sequence) ++totals.reused;
+                else ++totals.changed;
+                previous = sample.sequence;
+                known = true;
+            }
+            if (sample.acquired && sample.frameBlank) ++totals.sharedBlank;
+            else if (sample.acquired && sample.borrowed && !sample.blank) ++totals.sharedTexture;
+            else ++totals.sharedFallback;
+        }
+        void reset() { *this = {}; }
+    };
+    struct Diagnostics { Timing timing; Sequences sequences; };
+    inline thread_local Diagnostics diagnostics;
+
+    // Misma frontera de report que gow-perf; fases exclusivas ENTRE SÍ e incluidas
+    // en HostWait. Cambios de secuencia no prueban RGB distinto ni scanout físico.
+    inline void report(double t, double window)
+    {
+        static thread_local TimingTotals before;
+        static thread_local Sends old;
+        const auto &a = diagnostics.timing.totals;
+        const auto &s = diagnostics.sequences.totals;
+        std::fprintf(stderr, "[gow-perf:host] t=%.2f window=%.2f end_ms=%.2f batch_ms=%.2f swap_ms=%.2f limiter_ms=%.2f events_ms=%.2f other_ms=%.2f end_calls=%llu batch_calls=%llu swap_calls=%llu limiter_calls=%llu events_calls=%llu errors=%llu sends=%llu shared_texture=%llu shared_blank=%llu shared_fallback=%llu shared_changed=%llu shared_reused=%llu ram=%llu ram_blank=%llu epochs=%llu\n",
+            t, window, (a.endNanos-before.endNanos)*1e-6,
+            (a.nanos[0]-before.nanos[0])*1e-6, (a.nanos[1]-before.nanos[1])*1e-6,
+            (a.nanos[2]-before.nanos[2])*1e-6, (a.nanos[3]-before.nanos[3])*1e-6,
+            (a.otherNanos-before.otherNanos)*1e-6,
+            (unsigned long long)(a.endCalls-before.endCalls),
+            (unsigned long long)(a.calls[0]-before.calls[0]), (unsigned long long)(a.calls[1]-before.calls[1]),
+            (unsigned long long)(a.calls[2]-before.calls[2]), (unsigned long long)(a.calls[3]-before.calls[3]),
+            (unsigned long long)(a.errors-before.errors), (unsigned long long)(s.total-old.total),
+            (unsigned long long)(s.sharedTexture-old.sharedTexture), (unsigned long long)(s.sharedBlank-old.sharedBlank),
+            (unsigned long long)(s.sharedFallback-old.sharedFallback), (unsigned long long)(s.changed-old.changed),
+            (unsigned long long)(s.reused-old.reused), (unsigned long long)(s.ram-old.ram),
+            (unsigned long long)(s.ramBlank-old.ramBlank), (unsigned long long)(s.epochs-old.epochs));
+        before = a; old = s;
+    }
+}
