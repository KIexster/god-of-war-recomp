diff --git a/ps2xTest/src/ps2_gs_host_timing_tests.cpp b/ps2xTest/src/ps2_gs_host_timing_tests.cpp
new file mode 100644
index 0000000..7804cb1
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_host_timing_tests.cpp
@@ -0,0 +1,138 @@
+// GOW-Port: regresión del desglose inclusivo, sin depender del reloj real.
+#include "MiniTest.h"
+#include "runtime/gs/gs_host_perf.h"
+#include "runtime/ps2_perf.h"
+#include "raylib.h"
+#include <cstdlib>
+#include <vector>
+
+#if !defined(PLATFORM_VITA)
+extern "C" RLAPI void GowSetEndDrawingPhaseHook(void (*hook)(void *, int, int), void *user);
+#endif
+namespace
+{
+    void phases(TestCase &t)
+    {
+        GSHostPerf::Timing time;
+        time.begin(100u);
+        time.edge(0, true, 101u); time.edge(0, false, 111u);
+        time.edge(1, true, 112u); time.edge(1, false, 132u);
+        time.edge(2, true, 133u); time.edge(2, false, 163u);
+        time.edge(3, true, 164u); time.edge(3, false, 204u);
+        time.end(210u);
+        t.IsTrue(time.totals.nanos == std::array<uint64_t,4>{10u,20u,30u,40u}, "Carga exclusiva de cada fase");
+        t.IsTrue(time.totals.calls == std::array<uint64_t,4>{1u,1u,1u,1u}, "Una llamada por fase ejecutada");
+        t.Equals(time.totals.endNanos, 110u, "Total inclusivo EndDrawing");
+        t.Equals(time.totals.otherNanos, 10u, "Resto no atribuido a cuatro fases");
+        t.Equals(time.totals.errors, 0u, "Secuencia válida sin errores");
+        // Omitir WaitTime conserva el resto, no inventa una llamada de limitador.
+        time.begin(300u);
+        time.edge(0,true,301u); time.edge(0,false,303u);
+        time.edge(1,true,304u); time.edge(1,false,307u);
+        time.edge(3,true,308u); time.edge(3,false,312u);
+        time.end(320u);
+        t.IsTrue(time.totals.calls == std::array<uint64_t,4>{2u,2u,1u,2u}, "WaitTime condicional no cuenta al omitirse");
+        t.Equals(time.totals.endNanos,130u,"Segunda ventana acumula total");
+        t.Equals(time.totals.otherNanos,21u,"Segunda ventana acumula residual");
+    }
+    void invalid(TestCase &t)
+    {
+        GSHostPerf::Timing time;
+        time.edge(0,true,1u); time.end(2u); // Sin frame.
+        time.begin(10u); time.begin(11u); // Reentrada rechazada.
+        time.edge(0,true,12u);
+        time.edge(1,true,13u); time.edge(1,false,14u); // Anidamiento rechazado.
+        time.edge(0,false,15u);
+        time.edge(0,true,16u); // Orden repetido rechazado.
+        time.edge(4,true,17u); // Fuera de rango.
+        time.edge(3,true,18u); time.end(20u); // Fase incompleta cerrada con error.
+        t.Equals(time.totals.errors,8u,"Errores de contrato detectados, sin doble carga");
+        t.Equals(time.totals.endNanos,10u,"Reentrada no reemplaza el comienzo original");
+        t.Equals(time.totals.nanos[0],3u,"Anidamiento no sustrae ni duplica batch");
+        t.Equals(time.totals.nanos[3],2u,"Fase incompleta sólo carga su intervalo");
+        t.Equals(time.totals.otherNanos,5u,"Fases siguen siendo exclusivas");
+        time.reset();
+        t.Equals(time.totals.endCalls,0u,"Reset elimina totales");
+        time.begin(30u); time.edge(0,true,35u); time.edge(0,false,34u); time.end(40u);
+        t.Equals(time.totals.errors,1u,"Reloj hacia atrás detectado");
+        t.Equals(time.totals.nanos[0],0u,"Reloj hacia atrás no desborda");
+    }
+    void inclusive(TestCase &t)
+    {
+        ps2_perf::Accounting old;
+        old.switchTo(ps2_perf::Bucket::HostWait,100u);
+        GSHostPerf::Timing time;
+        time.begin(101u); time.edge(1,true,102u); time.edge(1,false,202u); time.end(209u);
+        const auto charge=old.switchTo(ps2_perf::Bucket::None,210u);
+        t.Equals(charge.bucket,ps2_perf::Bucket::HostWait,"Bucket original sigue activo");
+        t.Equals(charge.nanos,110u,"Swap no sustrae su tiempo de HostWait");
+        t.Equals(time.totals.nanos[1],100u,"Detalle mide el mismo swap por separado");
+    }
+    void sequences(TestCase &t)
+    {
+        GSHostPerf::Sequences count;
+        count.beginEpoch();
+        count.observe({true,true,true,false,false,7u});
+        count.observe({true,true,true,false,false,7u});
+        count.observe({true,true,false,true,true,8u});
+        count.observe({true,true,false,true,true,8u});
+        count.observe({true,false,false,true,false,8u}); // Metadata previa no acredita Acquire.
+        count.observe({true,true,false,true,false,9u}); // Publicación inválida usa fallback.
+        count.beginEpoch();
+        count.observe({false,false,false,false,false,0u});
+        count.observe({false,false,false,true,false,0u});
+        count.beginEpoch();
+        count.observe({true,true,true,false,false,7u}); // Misma secuencia en epoch nueva.
+        const auto &c=count.totals;
+        t.Equals(c.total,9u,"Un envío por View devuelto");
+        t.Equals(c.sharedTexture,3u,"Tres envíos de textura efectiva");
+        t.Equals(c.sharedBlank,2u,"Blank adquirido contado separadamente");
+        t.Equals(c.sharedFallback,2u,"Ausencia y textura inválida usan fallback");
+        t.Equals(c.changed,4u,"Cambio/primero en cada epoch, incluso blank");
+        t.Equals(c.reused,2u,"Reutilización adquirida efectiva");
+        t.Equals(c.ram,2u,"RAM sin confundirla con shared");
+        t.Equals(c.ramBlank,1u,"RAM blank es subconjunto de RAM");
+        t.Equals(c.epochs,3u,"Cambio de modo/reset separa identidades");
+        t.Equals(c.sharedTexture+c.sharedBlank+c.sharedFallback+c.ram,c.total,"Clasificación disjunta suma envíos");
+        count.reset(); t.Equals(count.totals.total,0u,"Reset de contadores");
+    }
+#if !defined(PLATFORM_VITA)
+    void collect(void *user,int phase,int begin)
+    { static_cast<std::vector<int> *>(user)->push_back(phase*2+(begin?0:1)); }
+    void realHooks(TestCase &t)
+    {
+        if(IsWindowReady()) { t.Fail("Se requiere ventana propia"); return; }
+        SetConfigFlags(FLAG_WINDOW_HIDDEN);
+        InitWindow(64,64,"EndDrawing procedural");
+        if(!IsWindowReady()) { t.Fail("No hay contexto host efectivo"); return; }
+        struct Close { ~Close() { GowSetEndDrawingPhaseHook(nullptr,nullptr); CloseWindow(); } } close;
+        std::vector<int> events;
+        GowSetEndDrawingPhaseHook(collect,&events);
+        SetTargetFPS(0); // Sin limitador: conserva la condición original.
+        BeginDrawing(); ClearBackground(RED); EndDrawing();
+        t.IsTrue(events==std::vector<int>{0,1,2,3,6,7},"EndDrawing real llama batch, swap y eventos en orden");
+        events.clear(); SetTargetFPS(10);
+        // Primer BeginDrawing tras la inicialización puede incluir su coste.
+        BeginDrawing(); EndDrawing(); events.clear();
+        BeginDrawing(); EndDrawing();
+        t.IsTrue(events==std::vector<int>{0,1,2,3,4,5,6,7},"WaitTime ejecutado llama ambos edges en su posición");
+        events.clear(); GowSetEndDrawingPhaseHook(nullptr,nullptr);
+        BeginDrawing(); EndDrawing();
+        t.IsTrue(events.empty(),"Hook desactivado no llama al usuario ni a su reloj");
+    }
+#endif
+}
+void runGsHostTimingTests()
+{
+    MiniTest::Case("GS tiempos y envios host",[](TestCase &suite)
+    {
+        suite.Run("Fases y limitador condicional con reloj inyectado",phases);
+        suite.Run("Contrato, reentrada, reloj y reset",invalid);
+        suite.Run("HostWait conserva contabilidad inclusiva",inclusive);
+        suite.Run("View nuevo, reutilizado, blank, fallback y epoch",sequences);
+#if !defined(PLATFORM_VITA)
+        const char *gpu=std::getenv("GOW_GS_GPU_TEST");
+        if(gpu && *gpu=='1') suite.Run("Hooks reales EndDrawing activos y desactivados",realHooks);
+#endif
+    });
+}
