diff --git a/ps2xTest/src/ps2_gs_pcrtc_blend_tests.cpp b/ps2xTest/src/ps2_gs_pcrtc_blend_tests.cpp
new file mode 100644
index 0000000..40de846
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_pcrtc_blend_tests.cpp
@@ -0,0 +1,100 @@
+// GOW-Port: 32 patrones contrastados con GSRendererSW original2954ebe/DX11 merge, sin assets.
+#include "MiniTest.h"
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/gs_gpu_backend.h"
+#include "runtime/gs/gs_threaded_backend.h"
+#include "runtime/gs/gs_swizzle.h"
+#include <cstdlib>
+#include <memory>
+#include <vector>
+
+namespace {
+struct Pattern {uint32_t en1,en2,mmod,slbg,alp,alpha,rgb;};
+constexpr Pattern patterns[]={
+    {1,0,0,0,255,64,0x6d39dcu},
+    {0,1,0,0,255,64,0x20a010u},
+    {1,1,0,0,255,64,0x507080u},
+    {1,1,0,1,255,64,0x6d39dcu},
+    {1,0,1,0,64,128,0x6436d2u},
+    {1,1,1,0,64,128,0x388848u},
+    {1,1,1,1,64,128,0x6436d2u},
+    {1,0,1,0,255,128,0x8040f0u},
+    {1,0,0,0,255,128,0x8040f0u},
+    {1,1,0,0,255,128,0x8040f0u},
+    {1,0,0,0,255,0,0x5a32c8u},
+    {1,1,0,0,255,0,0x20a010u},
+    {1,1,1,0,0,128,0x20a010u},
+    {1,1,1,1,0,128,0x5a32c8u},
+    {1,0,1,0,0,128,0x5a32c8u},
+    {1,1,1,0,255,128,0x8040f0u},
+    {1,0,1,0,0,128,0x5a32c8u},
+    {1,0,1,0,1,128,0x5a32c8u},
+    {1,0,1,0,37,128,0x6034ceu},
+    {1,0,1,0,64,128,0x6436d2u},
+    {1,0,1,0,127,128,0x6d39dcu},
+    {1,0,1,0,128,128,0x6d39dcu},
+    {1,0,1,0,129,128,0x6d39dcu},
+    // GOW-Port: UNORM ideal232/61/120; DX11 local231/61/120 (precisión permitida D3D11 17.5).
+    {1,0,1,0,201,128,0x783de8u},
+    {1,0,1,0,254,128,0x8040f0u},
+    {1,0,1,0,255,128,0x8040f0u},
+    {1,1,1,1,1,128,0x5a32c8u},
+    {1,1,1,1,37,128,0x6034ceu},
+    {1,1,1,1,127,128,0x6d39dcu},
+    {1,1,1,1,129,128,0x6d39dcu},
+    {1,0,0,0,255,1,0x5a32c8u},
+    {1,0,0,0,255,127,0x8040f0u},
+};
+void upload(GSRasterBackend&backend,uint32_t base,uint32_t rgba){
+    std::vector<uint32_t> pixels(64u*64u,rgba);
+    GSTransferCommand command{};command.direction=0;command.bitbltbuf.dbp=base;
+    command.bitbltbuf.dbw=1;command.bitbltbuf.dpsm=GS_PSM_CT32;command.trxreg={64,64};
+    backend.BeginTransfer(command);
+    backend.UploadImage(reinterpret_cast<const uint8_t*>(pixels.data()),uint32_t(pixels.size()*4u));
+}
+void check(TestCase&t,GSRasterBackend&backend,unsigned first){
+    for(unsigned index=first;index<first+16;++index){
+        const auto&p=patterns[index];upload(backend,0,0x008040f0u|(p.alpha<<24));
+        upload(backend,32u*32u,0x8020a010u);
+        GSPresentationRequest request{};
+        request.pmode=p.en1|(p.en2<<1)|(p.mmod<<5)|(p.slbg<<7)|(p.alp<<8);
+        request.dispfb1=1ull<<9;request.dispfb2=32ull|(1ull<<9);
+        request.display1=request.display2=(25ull<<12)|(3ull<<23)|(255ull<<32)|(63ull<<44);
+        request.bgcolor=200u|(50u<<8)|(90u<<16);request.forceReadback=true;
+        const auto frame=backend.Present(request);
+        if(!frame || frame.width!=64 || frame.height!=64 || frame.pixels.size()<640u*64u*4u){
+            t.Fail("Salida64x64 requerida para caso "+std::to_string(index));continue;
+        }
+        bool exact=true;
+        for(unsigned y=0;y<64;++y)for(unsigned x=0;x<64;++x){
+            const auto*pixel=frame.pixels.data()+(y*640u+x)*4u;
+            const uint32_t color=uint32_t(pixel[0])|(uint32_t(pixel[1])<<8)|(uint32_t(pixel[2])<<16);
+            exact=exact&&color==p.rgb&&pixel[3]==255;
+        }
+        t.IsTrue(exact,"RGB UNORM contrastado y alpha normalizado del caso "+std::to_string(index));
+    }
+}
+void cpu(TestCase&t,unsigned first){
+    std::vector<uint8_t>vram(GSSwizzle::kMemorySize);GSCpuBackend backend;
+    backend.Initialize(vram.data(),uint32_t(vram.size()));check(t,backend,first);
+}
+void gpu(TestCase&t,bool hardware){
+    std::vector<uint8_t>vram(GSSwizzle::kMemorySize);
+    auto inner=std::make_unique<GSGpuBackend>();auto*actual=inner.get();actual->SetHardwareRasterAllowed(hardware);
+    GSThreadedBackend backend(std::move(inner));backend.Initialize(vram.data(),uint32_t(vram.size()));
+    if(dynamic_cast<GSGpuBackend*>(&backend.Inner())!=actual||!actual->IsReady()){
+        t.Fail("Compositor OpenGL efectivo requerido, sin fallbackCPU");return;
+    }
+    check(t,backend,0);check(t,backend,16);
+}
+}
+void register_gs_pcrtc_blend_tests(){
+    MiniTest::Case("GS mezcla PCRTC original",[](TestCase&t){
+        t.Run("CPU EN/MMOD/SLBG/alpha",[](TestCase&t){cpu(t,0);});
+        t.Run("CPU BGCOLOR y factores de frontera",[](TestCase&t){cpu(t,16);});
+        if(const char*enabled=std::getenv("GOW_GS_GPU_TEST");enabled&&enabled[0]=='1'){
+            t.Run("Compositor OpenGL con modo compute",[](TestCase&t){gpu(t,false);});
+            t.Run("Compositor OpenGL con modo hardware",[](TestCase&t){gpu(t,true);});
+        }
+    });
+}
