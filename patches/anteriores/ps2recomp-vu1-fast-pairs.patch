+    const __m128 mask = _mm_load_ps(reinterpret_cast<const float *>(kMasks[dest]));
+    _mm_storeu_ps(dst, _mm_blendv_ps(_mm_loadu_ps(dst), _mm_loadu_ps(src), mask));
+#else
+    if (dest & 0x8u)
+        dst[0] = src[0];
+    if (dest & 0x4u)
+        dst[1] = src[1];
+    if (dest & 0x2u)
+        dst[2] = src[2];
+    if (dest & 0x1u)
+        dst[3] = src[3];
+#endif
+}
