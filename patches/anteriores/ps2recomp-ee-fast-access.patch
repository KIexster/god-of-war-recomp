@@ -423,6 +423,50 @@ void register_ps2_runtime_expansion_tests()
 {
     MiniTest::Case("PS2RuntimeExpansion", [](TestCase &tc)
     {
+        // GOW-Port: adaptado de Waffle565/God-Of-War-Native-Port runtime@96f61ab (con permiso del autor). Las
+        // macros de acceso escriben y leen el scratchpad directamente; deben ver lo mismo que la ruta del runtime.
+        tc.Run("access macros reach the scratchpad directly and agree with the runtime path", [](TestCase &t)
+        {
+            PS2Runtime runtimeObject;
+            PS2Runtime *runtime = &runtimeObject;
+            t.IsTrue(runtime->memory().initialize(), "memory initialize should succeed");
+            uint8_t *rdram = runtime->memory().getRDRAM();
+            R5900Context context{};
+            R5900Context *ctx = &context;
+            WRITE32(0x70000010u, 0x12345678u);
+            t.Equals(runtime->memory().read32(0x70000010u), 0x12345678u, "a macro store must land in the scratchpad");
+            runtime->memory().write64(0x70000020u, 0x1122334455667788ull);
+            t.Equals(READ64(0x70000020u), 0x1122334455667788ull, "a macro load must read the scratchpad");
+            t.Equals(READ32(0xF0000010u), 0x12345678u, "the 0xF0000000 alias must reach the same scratchpad bytes");
+            WRITE16(0x70003FFEu, 0xBEEFu);
+            t.Equals(runtime->memory().read16(0x70003FFEu), static_cast<uint16_t>(0xBEEFu), "the last halfword of the scratchpad");
+            (void)ctx;
+        });
+
+        // GOW-Port: adaptado de Waffle565/God-Of-War-Native-Port runtime@e96ee58 (con permiso del autor). Las
+        // escrituras de GPR de 32/64 bits son un único almacenamiento de 8 bytes: los 64 bits altos no cambian.
+        tc.Run("scalar GPR stores keep the upper 64 bits and never write $zero", [](TestCase &t)
+        {
+            R5900Context context{};
+            R5900Context *ctx = &context;
+            for (int r = 0; r < 32; ++r)
+                ctx->r[r] = _mm_set_epi64x(0x0123456789ABCDEFll, 0x7766554433221100ll);
+            SET_GPR_U32(ctx, 5, 0x80000000u);
+            SET_GPR_ZE32(ctx, 6, 0x80000000u);
+            SET_GPR_S32(ctx, 7, -2);
+            SET_GPR_U64(ctx, 8, 0xFEDCBA9876543210ull);
+            SET_GPR_U32(ctx, 0, 0xFFFFFFFFu);
+            const auto lo = [&](int r) { return static_cast<uint64_t>(_mm_cvtsi128_si64(ctx->r[r])); };
+            const auto hi = [&](int r) { return static_cast<uint64_t>(_mm_cvtsi128_si64(_mm_unpackhi_epi64(ctx->r[r], ctx->r[r]))); };
+            t.Equals(lo(5), 0xFFFFFFFF80000000ull, "SET_GPR_U32 sign-extends into the low 64 bits");
+            t.Equals(lo(6), 0x0000000080000000ull, "SET_GPR_ZE32 zero-extends");
+            t.Equals(lo(7), 0xFFFFFFFFFFFFFFFEull, "SET_GPR_S32 sign-extends");
+            t.Equals(lo(8), 0xFEDCBA9876543210ull, "SET_GPR_U64 writes 64 bits");
+            for (int r : {5, 6, 7, 8})
+                t.Equals(hi(r), 0x0123456789ABCDEFull, "the upper 64 bits must stay untouched");
+            t.Equals(lo(0), 0x7766554433221100ull, "$zero must never be written");
+        });
+
         tc.Run("R5900Context initializes VU0 VF0 to its constant value", [](TestCase &t)
