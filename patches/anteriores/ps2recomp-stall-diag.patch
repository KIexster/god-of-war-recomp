diff --git a/ps2xRuntime/src/lib/ps2_stall_diag.cpp b/ps2xRuntime/src/lib/ps2_stall_diag.cpp
new file mode 100644
index 0000000..e91f97b
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_stall_diag.cpp
@@ -0,0 +1,319 @@
+// GOW-Port: diagnóstico opcional de atascos. Ver runtime/ps2_stall_diag.h.
+#include "runtime/ps2_stall_diag.h"
+
+#include "runtime/ee_scheduler.h"
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <map>
+#include <mutex>
+#include <set>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace ps2_stall
+{
+    namespace
+    {
+        using Clock = std::chrono::steady_clock;
+
+        const Clock::time_point &origin()
+        {
+            static const Clock::time_point value = Clock::now();
+            return value;
+        }
+
+        std::mutex g_milestoneMutex;
+        std::set<std::pair<const char *, uint32_t>> g_milestones;
+
+        std::atomic<StateProvider> g_stateProvider{nullptr};
+
+        std::mutex g_iopMutex;
+        std::condition_variable g_iopReady;
+        std::string g_iopText;
+        bool g_iopTextReady = false;
+
+        std::mutex g_threadMutex;
+        std::condition_variable g_stopSignal;
+        std::thread g_thread;
+        bool g_stop = false;
+
+        const char *counterName(size_t index)
+        {
+            static constexpr const char *names[counterCount] = {
+                "flip", "vblank", "alarma", "rpc", "bind", "sifdma", "iop", "vif1",
+                "sema_signal", "sema_wait", "sema_poll", "wakeup"};
+            return names[index];
+        }
+
+        const char *statusName(EeThreadStatus status)
+        {
+            switch (status)
+            {
+            case EeThreadStatus::Running: return "run";
+            case EeThreadStatus::Ready: return "ready";
+            case EeThreadStatus::Waiting: return "wait";
+            case EeThreadStatus::WaitingSuspended: return "wait+susp";
+            case EeThreadStatus::Suspended: return "susp";
+            case EeThreadStatus::Dormant: return "dormant";
+            }
+            return "?";
+        }
+
+        const char *waitName(EeWaitReason reason)
+        {
+            switch (reason)
+            {
+            case EeWaitReason::None: return "-";
+            case EeWaitReason::Sleep: return "sleep";
+            case EeWaitReason::Semaphore: return "sema";
+            case EeWaitReason::EventFlag: return "evf";
+            case EeWaitReason::VSync: return "vsync";
+            case EeWaitReason::External: return "ext";
+            case EeWaitReason::Mpeg: return "mpeg";
+            }
+            return "?";
+        }
+
+        std::string describeEe(const EeKernelSnapshot &snapshot)
+        {
+            std::string out;
+            char line[256];
+            std::snprintf(line, sizeof(line), "[gow-stall]   ee seq=%llu ciclo=%llu hilo_actual=%d\n",
+                          static_cast<unsigned long long>(snapshot.sequence),
+                          static_cast<unsigned long long>(snapshot.eeCycle), snapshot.runningThreadId);
+            out += line;
+            for (const auto &thread : snapshot.threads)
+            {
+                if (thread.status == EeThreadStatus::Dormant)
+                    continue;
+                std::snprintf(line, sizeof(line),
+                              "[gow-stall]   ee hilo=%d %s espera=%s id=%d prio=%d pc=%08x ra=%08x wakeups=%u invocaciones=%u\n",
+                              thread.id, statusName(thread.status), waitName(thread.waitReason), thread.waitId,
+                              thread.currentPriority, thread.pc, thread.ra, thread.wakeupCount, thread.invocationDepth);
+                out += line;
+            }
+            for (const auto &sema : snapshot.semaphores)
+            {
+                if (sema.waiters == 0u)
+                    continue;
+                std::snprintf(line, sizeof(line), "[gow-stall]   ee sema=%d cuenta=%d/%d esperan=%u\n",
+                              sema.id, sema.count, sema.maxCount, sema.waiters);
+                out += line;
+            }
+            for (const auto &flag : snapshot.eventFlags)
+            {
+                if (flag.waiters == 0u)
+                    continue;
+                std::snprintf(line, sizeof(line), "[gow-stall]   ee evf=%d bits=%08x esperan=%u\n",
+                              flag.id, flag.bits, flag.waiters);
+                out += line;
+            }
+            return out;
+        }
+
+        // Muestras de la PC y RA publicadas en cada despacho del EE durante unos 200 ms.
+        std::string samplePcs(const Sources &sources)
+        {
+            std::map<std::pair<uint32_t, uint32_t>, unsigned> histogram;
+            unsigned samples = 0;
+            const auto end = Clock::now() + std::chrono::milliseconds(200);
+            while (Clock::now() < end)
+            {
+                const uint32_t pc = sources.debugPc->load(std::memory_order_relaxed);
+                const uint32_t ra = sources.debugRa->load(std::memory_order_relaxed);
+                ++histogram[{pc, ra}];
+                ++samples;
+                std::this_thread::sleep_for(std::chrono::microseconds(500));
+            }
+            std::vector<std::pair<unsigned, std::pair<uint32_t, uint32_t>>> sorted;
+            for (const auto &[key, hits] : histogram)
+                sorted.push_back({hits, key});
+            std::sort(sorted.begin(), sorted.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+            std::string out;
+            char line[160];
+            std::snprintf(line, sizeof(line), "[gow-stall]   pc muestras=%u distintas=%zu\n", samples, sorted.size());
+            out += line;
+            for (size_t i = 0; i < sorted.size() && i < 8u; ++i)
+            {
+                std::snprintf(line, sizeof(line), "[gow-stall]   pc=%08x ra=%08x veces=%u\n",
+                              sorted[i].second.first, sorted[i].second.second, sorted[i].first);
+                out += line;
+            }
+            return out;
+        }
+
+        std::string requestIopDescription()
+        {
+            std::unique_lock lock(g_iopMutex);
+            g_iopTextReady = false;
+            iopDescriptionRequested.store(true, std::memory_order_release);
+            if (!g_iopReady.wait_for(lock, std::chrono::seconds(2), [] { return g_iopTextReady; }))
+            {
+                iopDescriptionRequested.store(false, std::memory_order_release);
+                return "[gow-stall]   iop sin respuesta del hilo EE en 2 s\n";
+            }
+            return g_iopText;
+        }
+
+        void dump(const Sources &sources, double stalledSeconds, unsigned index)
+        {
+            std::string text;
+            char line[160];
+            std::snprintf(line, sizeof(line), "[gow-stall] volcado=%u t=%.3f sin_flips=%.1fs\n",
+                          index, seconds(), stalledSeconds);
+            text += line;
+            text += describeEe(sources.eeSnapshot());
+            text += samplePcs(sources);
+            text += sources.recentRpc(12u);
+            text += requestIopDescription();
+            std::fputs(text.c_str(), stderr);
+            std::fflush(stderr);
+        }
+
+        void watch(Sources sources)
+        {
+            const uint8_t *rdram = sources.rdram;
+            std::array<uint64_t, counterCount> previous{};
+            double lastFlipSeconds = -1.0;
+            double nextHeartbeat = 5.0;
+            double nextDump = 0.0;
+            unsigned dumps = 0;
+            bool stalled = false;
+            uint32_t lastState = 0xFFFFFFFFu;
+            for (;;)
+            {
+                {
+                    std::unique_lock lock(g_threadMutex);
+                    if (g_stopSignal.wait_for(lock, std::chrono::seconds(1), [] { return g_stop; }))
+                        return;
+                }
+                const double now = seconds();
+                std::array<uint64_t, counterCount> current{};
+                for (size_t i = 0; i < counterCount; ++i)
+                    current[i] = counters[i].load(std::memory_order_relaxed);
+                const uint64_t flips = current[static_cast<size_t>(Counter::Flip)];
+
+                char state[192] = "";
+                if (const StateProvider provider = g_stateProvider.load(std::memory_order_acquire); provider && rdram)
+                {
+                    const uint32_t key = provider(rdram, state, sizeof(state));
+                    if (key != lastState)
+                    {
+                        lastState = key;
+                        milestone("estado_juego_vigia", key);
+                    }
+                }
+
+                if (flips != previous[static_cast<size_t>(Counter::Flip)] || lastFlipSeconds < 0.0)
+                {
+                    if (stalled)
+                        std::fprintf(stderr, "[gow-stall] reanuda t=%.3f tras %.1fs sin flips\n", now, now - lastFlipSeconds);
+                    stalled = false;
+                    dumps = 0;
+                    if (flips != 0u)
+                        lastFlipSeconds = now;
+                }
+
+                if (now >= nextHeartbeat)
+                {
+                    nextHeartbeat = now + 5.0;
+                    std::string text;
+                    char item[64];
+                    std::snprintf(item, sizeof(item), "[gow-stall] latido t=%.3f", now);
+                    text += item;
+                    for (size_t i = 0; i < counterCount; ++i)
+                    {
+                        std::snprintf(item, sizeof(item), " %s=+%llu", counterName(i),
+                                      static_cast<unsigned long long>(current[i] - previous[i]));
+                        text += item;
+                    }
+                    std::snprintf(item, sizeof(item), " pc=%08x ra=%08x ",
+                                  sources.debugPc->load(std::memory_order_relaxed),
+                                  sources.debugRa->load(std::memory_order_relaxed));
+                    text += item;
+                    text += state;
+                    text += '\n';
+                    std::fputs(text.c_str(), stderr);
+                }
+                previous = current;
+
+                // Solo tras el primer flip: antes, el arranque no tiene un ritmo de cuadros de referencia.
+                if (lastFlipSeconds >= 0.0 && now - lastFlipSeconds >= 3.0)
+                {
+                    if (!stalled)
+                    {
+                        stalled = true;
+                        nextDump = now;
+                    }
+                    if (now >= nextDump && dumps < 8u)
+                    {
+                        dump(sources, now - lastFlipSeconds, ++dumps);
+                        static constexpr double delays[] = {7.0, 20.0, 30.0};
+                        nextDump = now + (dumps <= 3u ? delays[dumps - 1u] : 60.0);
+                    }
+                }
+            }
+        }
+    }
+
+    double seconds()
+    {
+        return std::chrono::duration<double>(Clock::now() - origin()).count();
+    }
+
+    void milestone(const char *name, uint32_t key, uint32_t value)
+    {
+        if (!enabled())
+            return;
+        {
+            std::lock_guard lock(g_milestoneMutex);
+            if (g_milestones.size() >= 512u || !g_milestones.insert({name, key}).second)
+                return;
+        }
+        std::fprintf(stderr, "[gow-stall] hito t=%.6f %s clave=0x%x valor=0x%x\n", seconds(), name, key, value);
+    }
+
+    void setStateProvider(StateProvider provider)
+    {
+        g_stateProvider.store(provider, std::memory_order_release);
+    }
+
+    void start(Sources sources)
+    {
+        if (!enabled() || !sources.eeSnapshot || !sources.debugPc || !sources.debugRa || !sources.recentRpc)
+            return;
+        (void)origin();
+        std::lock_guard lock(g_threadMutex);
+        if (g_thread.joinable())
+            return;
+        g_stop = false;
+        g_thread = std::thread(watch, std::move(sources));
+        std::fprintf(stderr, "[gow-stall] vigia activo (latido 5 s, volcado tras 3 s sin flips)\n");
+    }
+
+    void stop()
+    {
+        {
+            std::lock_guard lock(g_threadMutex);
+            g_stop = true;
+        }
+        g_stopSignal.notify_all();
+        if (g_thread.joinable())
+            g_thread.join();
+    }
+
+    void provideIopDescription(std::string text)
+    {
+        {
+            std::lock_guard lock(g_iopMutex);
+            g_iopText = std::move(text);
+            g_iopTextReady = true;
+        }
+        iopDescriptionRequested.store(false, std::memory_order_release);
+        g_iopReady.notify_all();
+    }
+}
