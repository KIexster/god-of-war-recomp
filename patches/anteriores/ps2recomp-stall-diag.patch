--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_stall_diag.h
@@ -0,0 +1,96 @@
+#ifndef PS2_STALL_DIAG_H
+#define PS2_STALL_DIAG_H
+
+// GOW-Port: diagnóstico opcional de atascos (GOW_STALL_DIAG=1, etiqueta [gow-stall]).
+// Registra hitos la primera vez que ocurren y, desde un hilo vigía propio, imprime un latido
+// cada pocos segundos y un volcado cuando los flips del juego se detienen. No cambia el
+// planificador: los hilos del emulador solo incrementan contadores atómicos y el estado del
+// IOP se copia en el hilo EE cuando el vigía lo pide.
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <string>
+
+struct EeKernelSnapshot;
+
+namespace ps2_stall
+{
+    enum class Counter : size_t
+    {
+        Flip,
+        VBlank,
+        Alarm,
+        RpcCall,
+        RpcBind,
+        SifDma,
+        IopSlice,
+        Vif1Chunk,
+        SemaSignal,
+        SemaWait,
+        SemaPoll,
+        Wakeup,
+        Count
+    };
+    constexpr size_t counterCount = static_cast<size_t>(Counter::Count);
+
+    inline bool enabled()
+    {
+        static const bool on = [] {
+            const char *value = std::getenv("GOW_STALL_DIAG");
+            return value && std::strcmp(value, "1") == 0;
+        }();
+        return on;
+    }
+
+    inline std::array<std::atomic<uint64_t>, counterCount> counters{};
+    inline void count(Counter counter)
+    {
+        if (enabled())
+            counters[static_cast<size_t>(counter)].fetch_add(1u, std::memory_order_relaxed);
+    }
+
+    // Segundos monotónicos desde el primer uso (steady_clock); comunes a todos los hilos.
+    double seconds();
+
+    // Imprime "[gow-stall] hito" la primera vez que aparece cada par (nombre, clave); como
+    // máximo 512 hitos por ejecución. El nombre debe ser una cadena literal.
+    void milestone(const char *name, uint32_t key = 0u, uint32_t value = 0u);
+
+    // Para sitios frecuentes: evita el mutex de hitos tras la primera vez.
+    inline void milestoneOnce(std::atomic<bool> &done, const char *name, uint32_t key = 0u, uint32_t value = 0u)
+    {
+        if (enabled() && !done.load(std::memory_order_relaxed) && !done.exchange(true, std::memory_order_relaxed))
+            milestone(name, key, value);
+    }
+
+    // Estado del juego que aporta el código específico del juego (por ejemplo, gow_overrides).
+    // Escribe texto en buffer y devuelve un número que identifica el estado: un cambio se
+    // registra como hito. Se llama desde el hilo vigía; debe limitarse a leer memoria.
+    using StateProvider = uint32_t (*)(const uint8_t *rdram, char *buffer, size_t size);
+    void setStateProvider(StateProvider provider);
+
+    // Fuentes que lee el vigía. Las aporta ps2_runtime.cpp para que este módulo no dependa del
+    // runtime completo (otros ejecutables enlazan ps2_runtime.lib sin el código generado).
+    struct Sources
+    {
+        std::function<EeKernelSnapshot()> eeSnapshot;
+        const std::atomic<uint32_t> *debugPc = nullptr;
+        const std::atomic<uint32_t> *debugRa = nullptr;
+        std::function<std::string(size_t)> recentRpc;
+        const uint8_t *rdram = nullptr;
+    };
+
+    // Arranca o detiene el hilo vigía. No hace nada si el diagnóstico está desactivado.
+    void start(Sources sources);
+    void stop();
+
+    // Petición del vigía para describir el IOP; la atiende el hilo EE al avanzar el IOP.
+    inline std::atomic<bool> iopDescriptionRequested{false};
+    void provideIopDescription(std::string text);
+}
+
+#endif
