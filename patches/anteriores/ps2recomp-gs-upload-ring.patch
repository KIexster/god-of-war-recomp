+            t.Equals(put(1u), SIZE_MAX, "Usa fallback antes de mapear");
+            ring.setStorage(storage.data());
+            t.Equals(put(65u), SIZE_MAX, "No acepta un upload mayor que un chunk");
+            t.Equals(put((std::numeric_limits<size_t>::max)()), SIZE_MAX, "No desborda al calcular el tamaño");
+            t.Equals(storage, before, "Los rechazos conservan toda la memoria");
+            t.Equals(callbacks, 0u, "Los rechazos no consultan sincronización");
+            t.IsTrue(ring.available(), "Un payload grande no deshabilita el ring");
+            t.Equals(put(1u), size_t{0}, "Los rechazos no avanzaron el cursor");
+        });
+        tc.Run("Fuente nula reserva sin escribir y tamaño cero usa el mínimo", [](TestCase &t)
+        {
+            Fixture f;
+            const auto before = f.bytes;
+            t.Equals(f.put(nullptr, 0u), size_t{0}, "Reserva vacía de 16 bytes");
+            t.Equals(f.bytes, before, "La fuente nula conserva los bytes reservados");
+            const uint8_t data = 0x55u;
+            t.Equals(f.put(&data, 0u), size_t{16}, "La siguiente reserva empieza tras el mínimo");
+            for (size_t i = 16u; i < 32u; ++i)
+                t.Equals(f.bytes[i], uint8_t{0u}, "Fuente válida y payload cero inicializan el padding");
+        });
+        tc.Run("Un payload que termina justo en el chunk no crea fence antes de tiempo", [](TestCase &t)
+        {
+            Fixture f;
+            std::array<uint8_t, 48u> data{};
+            t.Equals(f.put(data.data(), 15u), size_t{0}, "Mínimo de 16 bytes");
+            t.Equals(f.put(data.data(), data.size()), size_t{16}, "Termina exactamente en el límite");
+            t.Equals(f.nextFence, 1u, "No crea fence mientras el upload cabe");
+            t.Equals(f.put(data.data(), 1u), size_t{64}, "El siguiente upload abre otro chunk");
+            t.Equals(f.nextFence, 2u, "Protege el chunk cerrado con una fence");
+            t.IsTrue(f.waited.empty(), "No espera un chunk todavía no usado");
+        });
+        tc.Run("Cambiar storage no rearma el ring tras un fallo", [](TestCase &t)
+        {
+            Fixture f;
+            f.fill(t);
+            f.outcome = WaitResult::Timeout;
+            const uint8_t data = 0x66u;
+            t.Equals(f.put(&data, 1u), SIZE_MAX, "Provoca el fallo de sincronización");
+            std::array<uint8_t, 256u> replacement{};
+            replacement.fill(0x37u);
+            const auto before = replacement;
+            f.ring.setStorage(nullptr); f.ring.setStorage(replacement.data());
+            t.Equals(f.put(&data, 1u), SIZE_MAX, "El fallo permanece al reasignar storage");
+            t.Equals(replacement, before, "No escribe en un mapping reasignado");
+            t.Equals(f.ring.failure(), Failure::Timeout, "Mantiene el motivo original");
+        });
+        tc.Run("Handles de tipo puntero siguen el mismo ciclo de propiedad", [](TestCase &t)
+        {
+            std::array<uint8_t, 128u> storage{};
+            std::array<uint8_t, 64u> data{};
+            std::array<uint8_t, 2u> handles{};
+            GSGpuUpload::Ring<const uint8_t *, 64u, 2u, 16u> ring;
+            ring.setStorage(storage.data());
+            size_t created = 0u;
+            std::vector<const uint8_t *> waited, deleted;
+            auto put = [&]
+            {
+                return ring.put(data.data(), data.size(),
+                                [&]() -> const uint8_t * { return &handles[created++]; },
+                                [&](const uint8_t *fence) { waited.push_back(fence); return WaitResult::Signaled; },
+                                [&](const uint8_t *fence) { deleted.push_back(fence); });
+            };
+            t.Equals(put(), size_t{0}, "Primer upload con handles puntero");
+            t.Equals(put(), size_t{64}, "Segundo chunk con fence puntero");
+            t.Equals(put(), size_t{0}, "Espera antes de volver al primer chunk");
+            t.Equals(waited, std::vector<const uint8_t *>({&handles[0]}), "Consulta la fence correcta");
+            ring.releaseFences([&](const uint8_t *fence) { deleted.push_back(fence); });
+            ring.releaseFences([&](const uint8_t *fence) { deleted.push_back(fence); });
+            t.Equals(deleted, std::vector<const uint8_t *>({&handles[0], &handles[1]}), "Libera cada puntero una vez");
+        });
+    });
+}
diff --git a/ps2xTest/src/ps2_gpu_ring_gl_tests.cpp b/ps2xTest/src/ps2_gpu_ring_gl_tests.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xTest/src/ps2_gpu_ring_gl_tests.cpp
@@ -0,0 +1,230 @@
+// GOW-Port: comprobar la liberacion del ring en un share group que sigue vivo.
+// Sin assets ni getters de produccion: se observan objetos del driver OpenGL.
+#include "MiniTest.h"
+
+#include <cstdlib>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/gs_gpu_backend.h"
+#include "runtime/gs/gs_shared_present.h"
+#include "runtime/gs/gs_swizzle.h"
+#include "gs/gpu/gs_gl.h"
+
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace
+{
+    constexpr GSGL::GLenum kShaderStorageBufferBinding = 0x90D3;
+    constexpr GSGL::GLenum kBufferSize = 0x8764;
+    constexpr GSGL::GLenum kBufferMapped = 0x88BC;
+    using GetIntegerIndexed = void (APIENTRY *)(GSGL::GLenum, GSGL::GLuint, GSGL::GLint *);
+    using GetBufferParameter = void (APIENTRY *)(GSGL::GLenum, GSGL::GLenum, GSGL::GLint *);
+    using IsBuffer = GSGL::GLboolean (APIENTRY *)(GSGL::GLuint);
+
+    std::string readSetting(const char *name, bool &present)
+    {
+        char *value = nullptr;
+        size_t size = 0u;
+        if (_dupenv_s(&value, &size, name) != 0)
+            throw std::runtime_error(std::string("No se pudo leer ") + name);
+        const std::unique_ptr<char, decltype(&std::free)> owned(value, &std::free);
+        present = value != nullptr;
+        return present ? std::string(value) : std::string();
+    }
+
+    class SharedHost
+    {
+        GSGL::Context context;
+        HDC previousDc = wglGetCurrentDC();
+        HGLRC previousContext = wglGetCurrentContext();
+        bool hadSetting = false;
+        bool captured = false;
+        std::string oldSetting;
+
+    public:
+        SharedHost()
+        {
+            oldSetting = readSetting("PS2X_GS_DIRECT_PRESENT", hadSetting);
+        }
+
+        ~SharedHost()
+        {
+            if (captured)
+            {
+                GSSharedPresent::RestoreHostContext();
+                GSSharedPresent::ShutdownHost();
+            }
+            context.Destroy();
+            wglMakeCurrent(previousDc, previousContext);
+            _putenv_s("PS2X_GS_DIRECT_PRESENT", hadSetting ? oldSetting.c_str() : "");
+            // GOW-Port: reponer tambien la captura del host anterior si la tenia.
+            if (captured && previousContext && hadSetting && oldSetting == "1")
+            {
+                GSSharedPresent::CaptureHostContext();
+                GSSharedPresent::RestoreHostContext();
+            }
+        }
+
+        bool initialize(TestCase &t)
+        {
+            if (GSSharedPresent::Active())
+            {
+                t.Fail("El control requiere un host compartido propio, sin otro backend activo");
+                return false;
+            }
+            if (_putenv_s("PS2X_GS_DIRECT_PRESENT", "1") != 0)
+            {
+                t.Fail("No se pudo configurar la presentacion compartida del control");
+                return false;
+            }
+            std::string error;
+            if (!context.Create(error))
+            {
+                t.Fail("Contexto host OpenGL requerido: " + error);
+                return false;
+            }
+            GSSharedPresent::CaptureHostContext();
+            captured = true;
+            GSSharedPresent::RestoreHostContext();
+            if (wglGetCurrentContext() == nullptr)
+            {
+                t.Fail("No se pudo restaurar el host oculto despues de capturarlo");
+                return false;
+            }
+            return true;
+        }
+    };
+
+    GSPrimitiveBatch ringSprite()
+    {
+        GSPrimitiveBatch draw{};
+        draw.vertexCount = 2u;
+        draw.state.prim.type = GS_PRIM_SPRITE;
+        draw.state.colclamp = 1u;
+        draw.state.context.frame.fbp = 2u;
+        draw.state.context.frame.fbw = 1u;
+        draw.state.context.frame.psm = GS_PSM_CT32;
+        draw.state.context.zbuf.zbp = 68u;
+        draw.state.context.zbuf.zmask = true;
+        draw.state.context.scissor = {0u, 63u, 0u, 31u};
+        draw.state.context.test = 1ull << 17u; // ZTST=ALWAYS, como los controles GS.
+        for (GSVertex &vertex : draw.vertices)
+        {
+            vertex.r = 32u;
+            vertex.g = 64u;
+            vertex.b = 96u;
+            vertex.a = 128u;
+            vertex.q = 1.0f;
+        }
+        draw.vertices[0].x = 1.0f;
+        draw.vertices[0].y = 1.0f;
+        draw.vertices[1].x = 17.0f;
+        draw.vertices[1].y = 17.0f;
+        return draw;
+    }
+
+    void sharedRingDeleted(TestCase &t)
+    {
+        SharedHost host;
+        if (!host.initialize(t))
+            return;
+
+        std::vector<uint8_t> cpuRam(GSSwizzle::kMemorySize);
+        std::vector<uint8_t> gpuRam(GSSwizzle::kMemorySize);
+        GSCpuBackend cpu;
+        cpu.Initialize(cpuRam.data(), static_cast<uint32_t>(cpuRam.size()));
+        const GSPrimitiveBatch draw = ringSprite();
+        cpu.Submit(draw);
+        std::vector<uint8_t> expected;
+        cpu.SnapshotVram(expected);
+        t.Equals(cpu.ReadVram(GS_PSM_CT32, 2u << 5u, 1u, 5u, 7u),
+                 0x80604020u, "El control CPU dibuja color no nulo");
+
+        auto gpu = std::make_unique<GSGpuBackend>();
+        gpu->SetHardwareRasterAllowed(false);
+        gpu->Initialize(gpuRam.data(), static_cast<uint32_t>(gpuRam.size()));
+        if (!gpu->IsReady())
+        {
+            t.Fail("Backend OpenGL requerido; no se admite fallback CPU");
+            return;
+        }
+        if (!GSSharedPresent::Active())
+        {
+            t.Fail("El contexto del backend debe compartir objetos con el host vivo");
+            return;
+        }
+        const auto getIntegerIndexed = reinterpret_cast<GetIntegerIndexed>(wglGetProcAddress("glGetIntegeri_v"));
+        const auto getBufferParameter = reinterpret_cast<GetBufferParameter>(wglGetProcAddress("glGetBufferParameteriv"));
+        const auto isBuffer = reinterpret_cast<IsBuffer>(wglGetProcAddress("glIsBuffer"));
+        if (!getIntegerIndexed || !getBufferParameter || !isBuffer)
+        {
+            t.Fail("glGetIntegeri_v y glIsBuffer requeridos para observar objetos reales");
+            return;
+        }
+
+        gpu->Submit(draw);
+        gpu->Flush();
+        t.Equals(gpu->GetStats().prims, uint64_t{1}, "OpenGL procesa el sprite real");
+        GSGL::GLint ringId = 0;
+        getIntegerIndexed(kShaderStorageBufferBinding, 3u, &ringId);
+        if (ringId <= 0 || !isBuffer(static_cast<GSGL::GLuint>(ringId)))
+        {
+            t.Fail("El upload de primitivas debe enlazar un buffer OpenGL valido");
+            return;
+        }
+        // GOW-Port: binding 3 tambien tiene fallback; exigir el ring persistente real.
+        auto bindBuffer = reinterpret_cast<void (APIENTRY *)(GSGL::GLenum, GSGL::GLuint)>(wglGetProcAddress("glBindBuffer"));
+        if (!bindBuffer)
+        {
+            t.Fail("glBindBuffer requerido para comprobar el ring persistente");
+            return;
+        }
+        bindBuffer(GSGL::kShaderStorageBuffer, static_cast<GSGL::GLuint>(ringId));
+        GSGL::GLint size = 0, mapped = 0;
+        getBufferParameter(GSGL::kShaderStorageBuffer, kBufferSize, &size);
+        getBufferParameter(GSGL::kShaderStorageBuffer, kBufferMapped, &mapped);
+        if (size != 64 * 1024 * 1024 || !mapped)
+        {
+            t.Fail("El control requiere el ring mapeado de 64 MiB, no el buffer fallback");
+            return;
+        }
+        // GOW-Port: descartar una sonda vacia: el upload debe producir VRAM exacta.
+        std::vector<uint8_t> actual;
+        gpu->SnapshotVram(actual);
+        t.IsTrue(actual == expected, "Los 4 MiB de VRAM coinciden exactamente con CPU");
+
+        // El host queda vivo: borrar solo el contexto del backend no libera el ring.
+        gpu.reset();
+        GSSharedPresent::RestoreHostContext();
+        if (!wglGetCurrentContext())
+        {
+            t.Fail("Host requerido despues de destruir el backend");
+            return;
+        }
+        t.IsFalse(isBuffer(static_cast<GSGL::GLuint>(ringId)) != 0u,
+                  "El destructor elimina el ring de uploads aunque siga vivo el share group");
+    }
+}
+#endif
+
+void runGpuRingGlTests()
+{
+#ifdef _WIN32
+    bool present = false;
+    const std::string setting = readSetting("GOW_GS_GPU_TEST", present);
+    if (!present || setting != "1")
+        return;
+    MiniTest::Case("GS GPU ring compartido", [](TestCase &suite)
+    {
+        suite.Run("Destruir backend elimina el ring sin cerrar el host", sharedRingDeleted);
+    });
+#endif
+}
diff --git a/ps2xTest/src/ps2_gpu_streaming_gl_tests.cpp b/ps2xTest/src/ps2_gpu_streaming_gl_tests.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xTest/src/ps2_gpu_streaming_gl_tests.cpp
@@ -0,0 +1,242 @@
+// GOW-Port: fallback real por tamaño y capacidad del buffer de entrada/salida.
+// API pública y píxeles procedurales; sin hooks del driver ni getters del backend.
+#include "MiniTest.h"
+
+#include <cstdlib>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+#include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/gs_gpu_backend.h"
+#include "runtime/gs/gs_shared_present.h"
+#include "runtime/gs/gs_swizzle.h"
+#include "gs/gpu/gs_gl.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace
+{
+    constexpr GSGL::GLenum kStorageBinding = 0x90D3;
+    constexpr GSGL::GLenum kBufferSize = 0x8764;
+    constexpr uint32_t kWidth = 2048u;
+    constexpr uint32_t kReadHeight = 4095u;
+    constexpr uint32_t kUploadHeight = 2049u;
+    constexpr uint32_t kReadBytes = kWidth * kReadHeight * 4u;
+    constexpr uint32_t kUploadBytes = kWidth * kUploadHeight * 4u;
+    constexpr uint32_t kBeforeColor = 0x40201080u;
+    constexpr uint32_t kAfterColor = 0x90d06030u;
+
+    using GetIntegerIndexed = void (APIENTRY *)(GSGL::GLenum, GSGL::GLuint, GSGL::GLint *);
+    using GetBufferParameter = void (APIENTRY *)(GSGL::GLenum, GSGL::GLenum, GSGL::GLint *);
+    using BindBuffer = void (APIENTRY *)(GSGL::GLenum, GSGL::GLuint);
+
+    class DirectPresentSetting
+    {
+        bool present = false;
+        std::string previous;
+    public:
+        DirectPresentSetting()
+        {
+            char *value = nullptr;
+            size_t size = 0u;
+            if (_dupenv_s(&value, &size, "PS2X_GS_DIRECT_PRESENT") != 0)
+                throw std::runtime_error("No se pudo leer PS2X_GS_DIRECT_PRESENT");
+            const std::unique_ptr<char, decltype(&std::free)> owned(value, &std::free);
+            present = value != nullptr;
+            if (present)
+                previous = value;
+            if (_putenv_s("PS2X_GS_DIRECT_PRESENT", "0") != 0)
+                throw std::runtime_error("No se pudo seleccionar presentación por RAM");
+        }
+        ~DirectPresentSetting()
+        {
+            _putenv_s("PS2X_GS_DIRECT_PRESENT", present ? previous.c_str() : "");
+        }
+    };
+
+    struct BufferObservation
+    {
+        GetIntegerIndexed indexed = reinterpret_cast<GetIntegerIndexed>(wglGetProcAddress("glGetIntegeri_v"));
+        GetBufferParameter parameter = reinterpret_cast<GetBufferParameter>(wglGetProcAddress("glGetBufferParameteriv"));
+        BindBuffer bind = reinterpret_cast<BindBuffer>(wglGetProcAddress("glBindBuffer"));
+
+        bool ready() const { return indexed && parameter && bind; }
+        GSGL::GLint size(GSGL::GLint &id) const
+        {
+            indexed(kStorageBinding, 7u, &id);
+            if (id <= 0)
+                return -1;
+            bind(GSGL::kShaderStorageBuffer, static_cast<GSGL::GLuint>(id));
+            GSGL::GLint bytes = 0;
+            parameter(GSGL::kShaderStorageBuffer, kBufferSize, &bytes);
+            return bytes;
+        }
+    };
+
+    GSTransferCommand readCommand()
+    {
+        GSTransferCommand cmd{};
+        cmd.direction = 1u;
+        cmd.bitbltbuf.spsm = GS_PSM_CT32;
+        cmd.bitbltbuf.sbw = 32u;
+        cmd.trxreg.rrw = static_cast<uint16_t>(kWidth);
+        cmd.trxreg.rrh = static_cast<uint16_t>(kReadHeight);
+        return cmd;
+    }
+
+    GSTransferCommand uploadCommand()
+    {
+        GSTransferCommand cmd{};
+        cmd.direction = 0u;
+        cmd.bitbltbuf.dpsm = GS_PSM_CT32;
+        cmd.bitbltbuf.dbw = 32u;
+        cmd.trxreg.rrw = static_cast<uint16_t>(kWidth);
+        cmd.trxreg.rrh = static_cast<uint16_t>(kUploadHeight);
+        return cmd;
+    }
+
+    void compareReadback(TestCase &t, GSCpuBackend &cpu, GSGpuBackend &gpu, bool changed)
+    {
+        t.Equals(cpu.GetTransferSnapshot().localToHostPendingBytes, uint64_t{kReadBytes}, "CPU prepara toda la lectura grande");
+        t.Equals(gpu.GetTransferSnapshot().localToHostPendingBytes, uint64_t{kReadBytes}, "OpenGL prepara toda la lectura grande");
+        std::array<uint8_t, 65536u> expected{}, actual{};
+        std::array<uint8_t, 4u> beforePixel{}, expectedPixel{};
+        const uint32_t color = changed ? kAfterColor : kBeforeColor;
+        std::memcpy(beforePixel.data(), &kBeforeColor, sizeof(kBeforeColor));
+        std::memcpy(expectedPixel.data(), &color, sizeof(color));
+        uint32_t consumed = 0u;
+        uint64_t differentBytes = 0u;
+        bool reportedMismatch = false;
+        while (consumed < kReadBytes)
+        {
+            const uint32_t request = std::min<uint32_t>(static_cast<uint32_t>(expected.size()), kReadBytes - consumed);
+            const uint32_t expectedCount = cpu.ConsumeLocalToHostBytes(expected.data(), request);
+            const uint32_t actualCount = gpu.ConsumeLocalToHostBytes(actual.data(), request);
+            if (expectedCount != request || actualCount != request)
+            {
+                t.Fail("La lectura grande terminó antes de recuperar todos los bytes");
+                break;
+            }
+            if (!reportedMismatch && !std::equal(expected.begin(), expected.begin() + request, actual.begin()))
+            {
+                t.Fail("OpenGL difiere del CPU en la lectura grande, desde byte " + std::to_string(consumed));
+                reportedMismatch = true;
+            }
+            for (uint32_t i = 0u; i < request; ++i)
+            {
+                if (actual[i] != beforePixel[(consumed + i) & 3u])
+                    ++differentBytes;
+                if (!reportedMismatch && expected[i] != expectedPixel[(consumed + i) & 3u])
+                {
+                    t.Fail("El control CPU no contiene el color procedural esperado");
+                    reportedMismatch = true;
+                }
+            }
+            consumed += request;
+        }
+        t.Equals(consumed, kReadBytes, "Se comparan todos los bytes, no una muestra de la lectura");
+        t.Equals(differentBytes, changed ? uint64_t{kReadBytes} : uint64_t{0},
+                 "La segunda lectura debe cambiar cada byte respecto al color anterior");
+        t.Equals(cpu.GetTransferSnapshot().localToHostPendingBytes, uint64_t{0}, "Se vacía la lectura CPU");
+        t.Equals(gpu.GetTransferSnapshot().localToHostPendingBytes, uint64_t{0}, "Se vacía la lectura OpenGL");
+    }
+
+    void streamingCapacity(TestCase &t)
+    {
+        DirectPresentSetting setting;
+        if (GSSharedPresent::Active())
+        {
+            t.Fail("El control requiere un contexto propio sin otro host compartido activo");
+            return;
+        }
+        std::vector<uint8_t> cpuRam(GSSwizzle::kMemorySize), gpuRam(GSSwizzle::kMemorySize);
+        for (size_t offset = 0u; offset < cpuRam.size(); offset += sizeof(kBeforeColor))
+            std::memcpy(cpuRam.data() + offset, &kBeforeColor, sizeof(kBeforeColor));
+        gpuRam = cpuRam;
+        GSCpuBackend cpu;
+        cpu.Initialize(cpuRam.data(), static_cast<uint32_t>(cpuRam.size()));
+        GSGpuBackend gpu;
+        gpu.SetHardwareRasterAllowed(false);
+        gpu.Initialize(gpuRam.data(), static_cast<uint32_t>(gpuRam.size()));
+        if (!gpu.IsReady())
+        {
+            t.Fail("OpenGL efectivo requerido; no se permite fallback CPU");
+            return;
+        }
+        BufferObservation observed;
+        if (!observed.ready())
+        {
+            t.Fail("Funciones OpenGL requeridas para acreditar la capacidad real del buffer");
+            return;
+        }
+
+        const GSTransferCommand read = readCommand();
+        cpu.BeginTransfer(read); gpu.BeginTransfer(read);
+        GSGL::GLint dataId = 0;
+        const GSGL::GLint initialSize = observed.size(dataId);
+        t.IsTrue(initialSize >= static_cast<GSGL::GLint>(kReadBytes), "La primera lectura reserva casi 32 MiB efectivos");
+        compareReadback(t, cpu, gpu, false);
+
+        // GOW-Port: una entrada mayor que el chunk de 16 MiB obliga al fallback real.
+        // Los píxeles repetidos hacen idempotentes los aliases de la VRAM de 4 MiB.
+        std::vector<uint32_t> payload(kUploadBytes / 4u, kAfterColor);
+        const GSTransferCommand upload = uploadCommand();
+        cpu.BeginTransfer(upload); gpu.BeginTransfer(upload);
+        cpu.UploadImage(reinterpret_cast<const uint8_t *>(payload.data()), kUploadBytes);
+        gpu.UploadImage(reinterpret_cast<const uint8_t *>(payload.data()), kUploadBytes);
+        gpu.Flush();
+        GSGL::GLint uploadId = 0;
+        const GSGL::GLint uploadSize = observed.size(uploadId);
+        t.Equals(uploadId, dataId, "La entrada oversized usa el mismo buffer de entrada/salida");
+        t.IsTrue(uploadSize > 16 * 1024 * 1024 && uploadSize < initialSize,
+                 "Streaming reduce de verdad el buffer; no pasó por el ring ni conservó el tamaño anterior");
+        std::vector<uint8_t> expectedVram, actualVram;
+        cpu.SnapshotVram(expectedVram); gpu.SnapshotVram(actualVram);
+        t.IsTrue(expectedVram == actualVram, "Upload oversized produce 4 MiB exactamente iguales al CPU");
+        t.IsTrue(expectedVram != gpuRam, "El upload cambia la VRAM inicial");
+
+        cpu.BeginTransfer(read); gpu.BeginTransfer(read);
+        GSGL::GLint finalId = 0;
+        const GSGL::GLint finalSize = observed.size(finalId);
+        t.Equals(finalId, dataId, "La segunda lectura usa el mismo objeto OpenGL");
+        t.IsTrue(finalSize >= static_cast<GSGL::GLint>(kReadBytes) && finalSize > uploadSize,
+                 "La lectura posterior realoca después de achicar el buffer en streaming");
+        compareReadback(t, cpu, gpu, true);
+    }
+}
+#endif
+
+void runGpuStreamingGlTests()
+{
+#ifdef _WIN32
+    const char *setting = std::getenv("GOW_GS_GPU_TEST");
+    if (!setting || *setting != '1')
+        return;
+    MiniTest::Case("GS GPU streaming capacidad real", [](TestCase &suite)
+    {
+        suite.Run("Entrada oversized no deja obsoleta la capacidad de la siguiente lectura", streamingCapacity);
+    });
+#endif
+}
+
+// GOW-Port: sonda aislada de regresión; la suite normal registra la función anterior.
+#ifdef GOW_STREAMING_PROBE_MAIN
+int main()
+{
+    runGpuStreamingGlTests();
+    return MiniTest::Run();
+}
+#endif
