+        uint64_t settleLatePresentation(MpegPlaybackState &playback,
+                                        const MpegDecodedFrame &frame,
+                                        uint64_t currentTickQ32,
+                                        uint64_t presentationTargetQ32)
+        {
+            if (currentTickQ32 <= presentationTargetQ32)
