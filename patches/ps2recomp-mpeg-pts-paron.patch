+                if (frame.pts90k >= 0 && playback.firstPresentedPts90k >= 0)
+                    playback.ptsPresentationBaseTickQ32 += currentTickQ32 - presentationTargetQ32;
+                playback.nextPictureTickQ32 = currentTickQ32;
+            }
+            return currentTickQ32;
+        }
