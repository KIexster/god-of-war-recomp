diff --git a/ps2xRuntime/cmake/ReleaseMode.cmake b/ps2xRuntime/cmake/ReleaseMode.cmake
index 92ef0d5..e202676 100644
--- a/ps2xRuntime/cmake/ReleaseMode.cmake
+++ b/ps2xRuntime/cmake/ReleaseMode.cmake
@@ -15,13 +15,18 @@ function(EnableFastReleaseMode TargetName)
                 /Gw # global data in COMDAT
                 /GF # string pooling
                 /Zc:inline # remove unreferenced inline
-                /fp:fast # fast math (graphics friendly)
                 /DNDEBUG
                 /arch:AVX2 # Advanced Vector Extensions 2
                 /GS- # Disable Buffer Security Check (faster)
-                /Qspectre- # Disable Spectre mitigations (faster)
             >
         )
+        # GOW-Port: clang-cl (compilar.ps1 con GOW_LLVM) no conoce /Qspectre- y su /fp:fast es -ffast-math, que supone
+        # que no hay NaN ni infinitos (la emulación de la VU sí los trata); sin análisis de alias por tipos, como MSVC.
+        if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+            target_compile_options(${TargetName} PRIVATE $<$<CONFIG:Release>:/clang:-fno-strict-aliasing>)
+        else()
+            target_compile_options(${TargetName} PRIVATE $<$<CONFIG:Release>:/fp:fast /Qspectre->)
+        endif()
 
         if(TARGET ${TargetName})
             target_link_options(${TargetName} PRIVATE
diff --git a/ps2xRuntime/include/runtime/ps2_vu1.h b/ps2xRuntime/include/runtime/ps2_vu1.h
index b8c9e18..6dccaa4 100644
--- a/ps2xRuntime/include/runtime/ps2_vu1.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1.h
@@ -15,6 +15,11 @@
 #pragma float_control(precise, on, push)
 #pragma fp_contract(off)
 #endif
+#if defined(__clang__)
+// GOW-Port: clang-cl no aplica el fp_contract(off) de MSVC y float_control(precise) le deja contraer a*b+c en FMA
+// (resultados distintos del motor exacto en ~15 % de las ejecuciones de la VU1).
+#pragma clang fp contract(off)
+#endif
 
 // GOW-Port: funciones pequeñas que el código de VU1 generado debe expandir siempre (en funciones de bloque
 // grandes MSVC agota su presupuesto de expansión y las llama).
