+                const uint64_t r = timer.clockRemainder - q * clockHz;
+                const uint64_t units = eeCycles + q;
+                ticks = units >> shift;
+                timer.clockRemainder = (units & ((1ull << shift) - 1u)) * clockHz + r;
+            };
+            if (clockSource == 0u)
