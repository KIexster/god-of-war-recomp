diff --git a/ps2xRuntime/include/runtime/ps2_sampler.h b/ps2xRuntime/include/runtime/ps2_sampler.h
new file mode 100644
index 0000000..5b0549c
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_sampler.h
@@ -0,0 +1,22 @@
+#ifndef PS2_SAMPLER_H
+#define PS2_SAMPLER_H
+
+// GOW-Port: perfilador opcional por muestreo (solo Windows). GOW_SAMPLER=inicio:fin (segundos desde el
+// arranque del vigía, por ejemplo "50:145") o GOW_SAMPLER=1 (toda la ejecución). Un hilo propio suspende
+// cada hilo registrado unas 1000 veces por segundo, copia su pila (RIP + desenrollado x64) en un búfer
+// preasignado sin reservar memoria y lo reanuda. Al terminar simboliza con DbgHelp (PDB junto al exe) e
+// imprime "[gow-sampler]" con las funciones con más muestras propias e inclusivas por hilo.
+// Las muestras son tiempo de reloj del hilo (incluye esperas), no uso exclusivo de CPU. Suspender el hilo
+// tiene un coste propio pequeño; se informa el intervalo real conseguido.
+
+namespace ps2_sampler
+{
+    bool enabled();
+    // Registrar el hilo actual con un nombre literal. Sin GOW_SAMPLER no hace nada.
+    void registerCurrentThread(const char *name);
+    void start();
+    // Detiene el muestreo e imprime el informe. Idempotente.
+    void stopAndReport();
+}
+
+#endif
