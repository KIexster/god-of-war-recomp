diff --git a/ps2xRuntime/src/lib/ps2_sampler.cpp b/ps2xRuntime/src/lib/ps2_sampler.cpp
new file mode 100644
index 0000000..21dd496
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_sampler.cpp
@@ -0,0 +1,299 @@
+// GOW-Port: perfilador opcional por muestreo. Ver runtime/ps2_sampler.h.
+#include "runtime/ps2_sampler.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <dbghelp.h>
+#pragma comment(lib, "dbghelp.lib")
+#pragma comment(lib, "winmm.lib")
+#endif
+
+namespace ps2_sampler
+{
+    namespace
+    {
+        struct Window
+        {
+            bool on = false;
+            double begin = 0.0;
+            double end = 1e30;
+        };
+
+        Window window()
+        {
+            static const Window value = []
+            {
+                Window w;
+                const char *text = std::getenv("GOW_SAMPLER");
+                if (!text || !*text || std::strcmp(text, "0") == 0)
+                    return w;
+                w.on = true;
+                if (const char *colon = std::strchr(text, ':'))
+                {
+                    w.begin = std::atof(text);
+                    w.end = std::atof(colon + 1);
+                }
+                return w;
+            }();
+            return value;
+        }
+    }
+
+    bool enabled()
+    {
+        return window().on;
+    }
+}
+
+#if defined(_WIN32) && defined(_M_X64)
+
+namespace ps2_sampler
+{
+    namespace
+    {
+        constexpr size_t kMaxFrames = 24u;
+        constexpr size_t kMaxSamplesPerThread = 400000u; // ~400 s a 1 kHz
+
+        struct Target
+        {
+            const char *name = "";
+            HANDLE handle = nullptr;
+            DWORD id = 0;
+            std::vector<uint64_t> frames; // kMaxFrames por muestra; 0 = fin de pila
+            size_t samples = 0;
+            size_t failed = 0;
+        };
+
+        std::mutex g_mutex;
+        std::vector<Target *> g_targets;
+        std::thread g_thread;
+        std::atomic<bool> g_stop{false};
+        bool g_reported = false;
+        std::chrono::steady_clock::time_point g_origin;
+        double g_firstSample = -1.0, g_lastSample = -1.0;
+        uint64_t g_ticks = 0;
+
+        // Desenrollado x64 del hilo suspendido. Sin reservas de memoria ni bloqueos de DbgHelp.
+        size_t unwind(CONTEXT context, uint64_t *out)
+        {
+            size_t count = 0;
+            __try
+            {
+                while (count < kMaxFrames && context.Rip != 0)
+                {
+                    out[count++] = context.Rip;
+                    DWORD64 imageBase = 0;
+                    PRUNTIME_FUNCTION function = RtlLookupFunctionEntry(context.Rip, &imageBase, nullptr);
+                    if (!function)
+                    {
+                        context.Rip = *reinterpret_cast<const DWORD64 *>(context.Rsp);
+                        context.Rsp += 8;
+                        continue;
+                    }
+                    PVOID handlerData = nullptr;
+                    DWORD64 establisher = 0;
+                    RtlVirtualUnwind(UNW_FLAG_NHANDLER, imageBase, context.Rip, function, &context, &handlerData,
+                                     &establisher, nullptr);
+                }
+            }
+            __except (EXCEPTION_EXECUTE_HANDLER)
+            {
+            }
+            return count;
+        }
+
+        void sampleLoop()
+        {
+            timeBeginPeriod(1);
+            while (!g_stop.load(std::memory_order_acquire))
+            {
+                Sleep(1);
+                const double now = std::chrono::duration<double>(std::chrono::steady_clock::now() - g_origin).count();
+                if (now < window().begin)
+                    continue;
+                if (now > window().end)
+                    break;
+                std::lock_guard lock(g_mutex);
+                ++g_ticks;
+                if (g_firstSample < 0.0)
+                    g_firstSample = now;
+                g_lastSample = now;
+                for (Target *target : g_targets)
+                {
+                    if (target->samples >= kMaxSamplesPerThread)
+                        continue;
+                    if (SuspendThread(target->handle) == static_cast<DWORD>(-1))
+                    {
+                        ++target->failed;
+                        continue;
+                    }
+                    CONTEXT context{};
+                    context.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+                    uint64_t *out = target->frames.data() + target->samples * kMaxFrames;
+                    if (GetThreadContext(target->handle, &context))
+                    {
+                        const size_t count = unwind(context, out);
+                        if (count < kMaxFrames)
+                            out[count] = 0;
+                        ++target->samples;
+                    }
+                    else
+                    {
+                        ++target->failed;
+                    }
+                    ResumeThread(target->handle);
+                }
+            }
+            timeEndPeriod(1);
+        }
+
+        std::string symbolName(uint64_t address, std::unordered_map<uint64_t, std::string> &cache)
+        {
+            if (auto it = cache.find(address); it != cache.end())
+                return it->second;
+            alignas(SYMBOL_INFO) char buffer[sizeof(SYMBOL_INFO) + 512] = {};
+            auto *symbol = reinterpret_cast<SYMBOL_INFO *>(buffer);
+            symbol->SizeOfStruct = sizeof(SYMBOL_INFO);
+            symbol->MaxNameLen = 511;
+            DWORD64 displacement = 0;
+            std::string name;
+            if (SymFromAddr(GetCurrentProcess(), address, &displacement, symbol))
+            {
+                name = symbol->Name;
+            }
+            else
+            {
+                char module[MAX_PATH] = "?";
+                HMODULE handle = nullptr;
+                if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                       reinterpret_cast<LPCSTR>(address), &handle))
+                {
+                    GetModuleFileNameA(handle, module, MAX_PATH);
+                    const char *slash = std::strrchr(module, '\\');
+                    name = std::string("[") + (slash ? slash + 1 : module) + "]";
+                }
+                else
+                {
+                    name = "[desconocido]";
+                }
+            }
+            cache.emplace(address, name);
+            return name;
+        }
+
+        void printTop(const char *label, const std::unordered_map<std::string, size_t> &counts, size_t samples)
+        {
+            std::vector<std::pair<size_t, std::string>> sorted;
+            sorted.reserve(counts.size());
+            for (const auto &[name, count] : counts)
+                sorted.push_back({count, name});
+            std::sort(sorted.begin(), sorted.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+            for (size_t i = 0; i < sorted.size() && i < 40u; ++i)
+                std::fprintf(stderr, "[gow-sampler]   %s %6.2f%% %7zu %s\n", label,
+                             100.0 * static_cast<double>(sorted[i].first) / static_cast<double>(samples),
+                             sorted[i].first, sorted[i].second.c_str());
+        }
+    }
+
+    void registerCurrentThread(const char *name)
+    {
+        if (!enabled())
+            return;
+        auto *target = new Target();
+        target->name = name;
+        target->id = GetCurrentThreadId();
+        target->handle = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE,
+                                    target->id);
+        target->frames.assign(kMaxSamplesPerThread * kMaxFrames, 0u);
+        std::lock_guard lock(g_mutex);
+        g_targets.push_back(target);
+    }
+
+    void start()
+    {
+        if (!enabled() || g_thread.joinable())
+            return;
+        g_origin = std::chrono::steady_clock::now();
+        g_thread = std::thread(sampleLoop);
+        std::fprintf(stderr, "[gow-sampler] activo: ventana %.1f..%.1f s, ~1 kHz\n", window().begin, window().end);
+    }
+
+    void stopAndReport()
+    {
+        if (!enabled())
+            return;
+        g_stop.store(true, std::memory_order_release);
+        if (g_thread.joinable())
+            g_thread.join();
+        std::lock_guard lock(g_mutex);
+        if (g_reported)
+            return;
+        g_reported = true;
+        const HANDLE process = GetCurrentProcess();
+        SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS);
+        SymInitialize(process, nullptr, TRUE);
+        std::unordered_map<uint64_t, std::string> cache;
+        const double span = g_lastSample - g_firstSample;
+        std::fprintf(stderr, "[gow-sampler] ventana real %.2f..%.2f s, %llu ticks, intervalo medio %.3f ms\n",
+                     g_firstSample, g_lastSample, static_cast<unsigned long long>(g_ticks),
+                     g_ticks > 1 ? span * 1000.0 / static_cast<double>(g_ticks - 1) : 0.0);
+        for (Target *target : g_targets)
+        {
+            std::unordered_map<std::string, size_t> self, inclusive;
+            for (size_t s = 0; s < target->samples; ++s)
+            {
+                const uint64_t *frames = target->frames.data() + s * kMaxFrames;
+                std::unordered_set<std::string> seen;
+                for (size_t f = 0; f < kMaxFrames && frames[f] != 0; ++f)
+                {
+                    const std::string name = symbolName(frames[f], cache);
+                    if (f == 0)
+                        ++self[name];
+                    if (seen.insert(name).second)
+                        ++inclusive[name];
+                }
+            }
+            std::fprintf(stderr, "[gow-sampler] hilo=%s muestras=%zu fallidas=%zu\n", target->name, target->samples,
+                         target->failed);
+            if (target->samples == 0)
+                continue;
+            printTop("propio", self, target->samples);
+            printTop("inclusivo", inclusive, target->samples);
+        }
+        SymCleanup(process);
+        std::fflush(stderr);
+    }
+}
+
+#else
+
+namespace ps2_sampler
+{
+    void registerCurrentThread(const char *) {}
+    void start()
+    {
+        if (enabled())
+            std::fprintf(stderr, "[gow-sampler] solo disponible en Windows x64\n");
+    }
+    void stopAndReport() {}
+}
+
+#endif
