diff --git a/ps2xRecomp/src/lib/code_generator.cpp b/ps2xRecomp/src/lib/code_generator.cpp
index 68b0984..dd0cf42 100644
--- a/ps2xRecomp/src/lib/code_generator.cpp
+++ b/ps2xRecomp/src/lib/code_generator.cpp
@@ -260,7 +260,22 @@ namespace ps2recomp
 
     std::string CodeGenerator::translateVUInstruction(const Instruction &inst)
     {
-        return VuTranslator(*this).translate(inst);
+        std::string code = VuTranslator(*this).translate(inst);
+        // GOW-Port: VF0 is immutable. Remove only its generated assignment so other
+        // effects of the same VU instruction (such as ACC updates) are preserved.
+        const std::string vf0Write = "ctx->vu0_vf[0] =";
+        std::size_t write = code.find(vf0Write);
+        while (write != std::string::npos)
+        {
+            const std::size_t end = code.find(';', write);
+            if (end == std::string::npos)
+            {
+                break;
+            }
+            code.replace(write, end - write + 1, "/* VF0 write ignored */;");
+            write = code.find(vf0Write, write + 1);
+        }
+        return code;
     }
 
     CodeGenerator::AnalysisResult CodeGenerator::collectInternalBranchTargets(
