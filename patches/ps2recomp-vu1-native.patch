+        uint32_t b;
+        std::memcpy(&b, &x, 4);
+        const uint32_t e = (b >> 23) & 0xFFu;
+        if (e == 0u) b &= 0x80000000u;
+        else if (e == 255u) b = (b & 0x80000000u) | 0x7F7FFFFFu;
