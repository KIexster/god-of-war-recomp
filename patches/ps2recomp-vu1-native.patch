+                    {
+                        uint32_t w3 = 0;
+                        std::memcpy(&w3, pk + off + 12u, 4u);
+                        ++(((w3 >> 15) & 1u) ? noKicks : kicks);
+                    }
+            }
+            else if (flg == 1u)
+                off += ((nloop * nreg * 8u) + 15u) & ~15u;
+            else
+                off += nloop * 16u;
+        }
+        if (match && kickShown < 60)
