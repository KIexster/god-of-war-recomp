+        if (v[0] > w) f |= 0x01u;
+        if (v[0] < -w) f |= 0x02u;
+        if (v[1] > w) f |= 0x04u;
+        if (v[1] < -w) f |= 0x08u;
+        if (v[2] > w) f |= 0x10u;
+        if (v[2] < -w) f |= 0x20u;
+        return ((prev << 6) | f) & 0xFFFFFFu;
+    }
