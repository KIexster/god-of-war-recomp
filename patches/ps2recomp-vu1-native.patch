+
 void VU1Interpreter::finishXgkick()
 {
     if (!m_xgkick.active)
         return;
+    if (m_verifySilent)
+    {
+        if (g_vuVerifyCapture)
+            g_vuVerifyPackets.insert(g_vuVerifyPackets.end(), m_xgkick.packet.data(), m_xgkick.packet.data() + m_xgkick.totalBytes);
