+    VU1N_INLINE uint32_t clipVal(const VU1State &s, int fs, int ft, uint32_t prev)
+    {
+        alignas(16) float v[4], t[4];
+        _mm_store_ps(v, ldn(s, fs));
+        _mm_store_ps(t, ldn(s, ft));
