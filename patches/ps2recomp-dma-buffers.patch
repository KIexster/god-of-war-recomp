+            {
+                std::vector<uint8_t> packet;
+                appendU32(packet, 0u); // NOP
+                appendU32(packet, 0u);
+                appendU32(packet, 0u);
+                appendU32(packet, makeVifCmd(0x6Cu, static_cast<uint8_t>(vectors), static_cast<uint16_t>(vuAddr))); // UNPACK V4-32
+                for (uint32_t i = 0; i < vectors * 4u; ++i)
