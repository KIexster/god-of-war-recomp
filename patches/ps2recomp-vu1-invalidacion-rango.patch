+void PS2Memory::markVU1CodeModified(uint32_t lo, uint32_t hi)
+{
+    std::lock_guard<std::mutex> lock(m_vu1CodeLogMutex);
+    const uint64_t generation = m_vu1CodeGeneration.load(std::memory_order_relaxed) + 1u;
+    m_vu1CodeLog[generation % kVu1CodeLog] = Vu1CodeWrite{generation, lo, hi};
+    m_vu1CodeGeneration.store(generation, std::memory_order_relaxed);
+}
+
+bool PS2Memory::vu1CodeWritesSince(uint64_t from, uint64_t to, Vu1CodeWrite *out, size_t &count) const
+{
+    std::lock_guard<std::mutex> lock(m_vu1CodeLogMutex);
+    if (to <= from || to - from > kVu1CodeLog || to - from > count)
+        return false;
+    count = 0;
+    for (uint64_t g = from + 1u; g <= to; ++g)
+    {
+        const Vu1CodeWrite &w = m_vu1CodeLog[g % kVu1CodeLog];
+        if (w.generation != g)
+            return false;
+        out[count++] = w;
+    }
+    return true;
+}
