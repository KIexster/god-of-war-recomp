+        if (splitRuns && verts.size() > 3u && !s.prim.tme && s.prim.abe && (s.colclamp & 1u) == 0u &&
+            (s.context.alpha & 0xFFu) == 0x68u)
+        {
+            gs_colour_runs::build(&verts[0].x, sizeof(HwVertex) / sizeof(float), offsetof(HwVertex, r) / sizeof(float),
+                                  verts.size(), colourRunEnds);
+            if (colourRunEnds.size() > 1u)
+            {
+                uint32_t first = 0;
+                for (uint32_t end : colourRunEnds)
+                {
+                    colourRun.assign(verts.begin() + first, verts.begin() + end);
+                    drawOne(s, colourRun);
+                    first = end;
+                }
+                return;
+            }
+        }
+        drawOne(s, verts);
+    }
