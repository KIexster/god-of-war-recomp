diff --git a/ps2xTest/src/ps2_gs_tests.cpp b/ps2xTest/src/ps2_gs_tests.cpp
index eb4ce1f..c2c1e6e 100644
--- a/ps2xTest/src/ps2_gs_tests.cpp
+++ b/ps2xTest/src/ps2_gs_tests.cpp
@@ -1,3 +1,4 @@
+#include "runtime/gs/gs_tri_groups.h"
 #include "MiniTest.h"
 #include "runtime/ps2_memory.h"
 #include "ps2_runtime.h"
@@ -1233,5 +1234,29 @@ void register_ps2_gs_tests()
             t.Equals(whileWaiting, 0u, "the stage should not process packets while a priority waiter is registered");
             t.Equals(processed.load(), 3u, "the stage should process them once the waiter is gone");
         });
+
+        tc.Run("shadow-volume triangles share a draw only when their pixels are disjoint", [](TestCase &t)
+        {
+            // GOW-Port: ps2recomp-gs-volumenes-agrupados. Los volúmenes de sombra se dibujaban un triángulo por llamada con
+            // una barrera entre cada uno; ahora los consecutivos que no se solapan van juntos.
+            const auto groups = [](std::vector<float> xy)
+            {
+                std::vector<uint32_t> ends;
+                gs_tri_groups::build(xy.data(), 2u, xy.size() / 6u, ends);
+                return ends;
+            };
+            // a quad split along its diagonal (shared edge) and a triangle far away: one group
+            t.IsTrue(groups({0, 0, 10, 0, 0, 10, 10, 0, 10, 10, 0, 10, 50, 50, 60, 50, 50, 60}) == std::vector<uint32_t>{3u},
+                     "adjacent and disjoint triangles should share one draw");
+            // the second triangle covers part of the first: two groups
+            t.IsTrue(groups({0, 0, 10, 0, 0, 10, 2, 2, 12, 2, 2, 12}) == std::vector<uint32_t>({1u, 2u}),
+                     "overlapping triangles should be split by a barrier");
+            // touching at a vertex only, without a shared edge, still counts as overlap (rounding of the rasteriser)
+            t.IsTrue(groups({0, 0, 10, 0, 0, 10, 10, 0, 20, 0, 10, 10}) == std::vector<uint32_t>({1u, 2u}),
+                     "a contact that is not a shared edge should be treated as overlap");
+            // order is kept: A, B over A, C over A but not B -> [A] [B C]
+            t.IsTrue(groups({0, 0, 20, 0, 0, 20, 1, 1, 5, 1, 1, 5, 10, 1, 14, 1, 10, 5}) == std::vector<uint32_t>({1u, 3u}),
+                     "groups should be consecutive triangles in draw order");
+        });
     });
