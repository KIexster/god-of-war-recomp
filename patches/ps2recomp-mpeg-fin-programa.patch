+        // GOW-Port: como libmpeg, la demultiplexacion se detiene en el fin de programa (0x1B9). God of War lee el PSS
+        // en bloques de 0x4000 y su callback sceMpegCbNodata solo vuelve cuando la demultiplexacion devuelve 0; si el
+        // ultimo bloque (0x1B9 y datos viejos) se daba por consumido, pedia datos para siempre.
+        tc.Run("sceMpegDemuxPssRing stops at the program end code", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+            ps2_stubs::resetMpegStubState();
+            constexpr uint32_t kMpegAddr = 0x00123000u;
+            constexpr uint32_t kDataAddr = 0x00128000u;
+            const std::vector<uint8_t> payload = {0x00u, 0x00u, 0x01u, 0xB3u, 0x14u, 0x00u, 0xF0u, 0x13u};
+            const uint16_t packetLen = static_cast<uint16_t>(payload.size() + 3u);
+            std::vector<uint8_t> data = {0x00u, 0x00u, 0x01u, 0xE0u, static_cast<uint8_t>(packetLen >> 8u),
+                                         static_cast<uint8_t>(packetLen & 0xFFu), 0x80u, 0x00u, 0x00u};
+            data.insert(data.end(), payload.begin(), payload.end());
+            const size_t programEnd = data.size();
+            data.insert(data.end(), {0x00u, 0x00u, 0x01u, 0xB9u});
+            data.insert(data.end(), {0x00u, 0x00u, 0x01u, 0xE0u, 0x00u, 0x04u, 0x80u, 0x00u, 0x00u, 0x55u}); // datos viejos
+            std::memcpy(rdram.data() + kDataAddr, data.data(), data.size());
+
+            auto demux = [&](uint32_t addr, uint32_t size)
+            {
+                R5900Context ctx{};
+                setRegU32(ctx, 4, kMpegAddr);
+                setRegU32(ctx, 5, addr);
+                setRegU32(ctx, 6, size);
+                setRegU32(ctx, 7, 0u);
+                setRegU32(ctx, 8, 0xFFFFFFFFu);
+                ps2_stubs::sceMpegDemuxPssRing(rdram.data(), &ctx, &runtime);
+                return getRegS32(ctx, 2);
+            };
+            t.Equals(demux(kDataAddr, static_cast<uint32_t>(data.size())), static_cast<int32_t>(programEnd),
+                     "the bytes before the program end code should be consumed, and no more");
+            t.Equals(demux(kDataAddr + static_cast<uint32_t>(programEnd), static_cast<uint32_t>(data.size() - programEnd)), 0,
+                     "input that starts with the program end code should not be consumed");
+            runtime.requestStop();
+        });
+
