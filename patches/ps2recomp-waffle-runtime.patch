-        f.palette(tex, 0, kRed);
-        f.bind(tex);
-        auto direct = tex;
-        direct.psm = GS_PSM_CT32;
-        direct.cbp = 192;
-        f.bind(direct);
-        f.palette(tex, 0, kGreen);
-        f.flush();
