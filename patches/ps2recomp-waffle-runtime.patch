-
-    uint8_t toBcd(uint32_t value)
-    {
-        const uint32_t clamped = value % 100;
-        return static_cast<uint8_t>(((clamped / 10) << 4) | (clamped % 10));
-    }
-
-    uint32_t fromBcd(uint8_t value)
-    {
