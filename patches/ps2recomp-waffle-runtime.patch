+            case 0x01:
+                branch(static_cast<int32_t>(cpu.gpr[rs]) >= 0);
+                break;
+            case 0x10:
+                write(31u, pc + 8u);
+                branch(static_cast<int32_t>(cpu.gpr[rs]) < 0);
+                break;
+            case 0x11:
+                write(31u, pc + 8u);
+                branch(static_cast<int32_t>(cpu.gpr[rs]) >= 0);
