+        void initPacketBuilderState(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+        {
+            const uint32_t stateAddr = getRegU32(ctx, 4);
+            const uint32_t baseAddr = getRegU32(ctx, 5);
