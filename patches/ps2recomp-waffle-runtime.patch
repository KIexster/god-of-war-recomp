+		dst = &RDzero;
+	else
+		dst = &VU->VF[_Fd_];
+
+	ftx = vuDouble(VU->VF[_Ft_].i.x);
+	fty = vuDouble(VU->VF[_Ft_].i.y);
+	ftz = vuDouble(VU->VF[_Ft_].i.z);
+	fsx = vuDouble(VU->VF[_Fs_].i.x);
+	fsy = vuDouble(VU->VF[_Fs_].i.y);
