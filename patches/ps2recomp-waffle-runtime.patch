diff --git a/ps2xRuntime/src/lib/ee_ref/ee_diff.cpp b/ps2xRuntime/src/lib/ee_ref/ee_diff.cpp
new file mode 100644
index 0000000..e0d1f15
--- /dev/null
+++ b/ps2xRuntime/src/lib/ee_ref/ee_diff.cpp
@@ -0,0 +1,258 @@
+// GOW-Port: EE differential tester hookup (ported from our PAL stack's main.cpp).
+// PS2X_EE_DIFF=<hex addr>[,...] or PS2X_EE_DIFF=all: wraps recompiled functions; the first PS2X_EE_DIFF_MAX calls
+// (default 3, "all": 1) are re-run on PCSX2's EE interpreter (eeref) from an entry snapshot and every differing
+// register / written word is printed. PS2X_EE_DIFF_START=<s>: only calls made at least <s> seconds after start
+// are checked (e.g. while a scripted walk runs). PS2X_EE_DIFF_STEPS limits interpreter steps (default 2M).
+#include "ps2_runtime.h"
+#include "eeref.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+namespace
+{
+    std::unordered_map<uint32_t, PS2Runtime::RecompiledFunction> g_originals;
+    PS2Runtime *g_runtime = nullptr;
+    bool g_quiet = false;
+    std::chrono::steady_clock::time_point g_startTime;
+    double g_startDelay = 0.0;
+    std::mutex g_mutex; // one comparison at a time (guest threads may run on several host threads)
+
+    eeref::CpuSnapshot snapshotCpu(const R5900Context *ctx)
+    {
+        eeref::CpuSnapshot s{};
+        for (int i = 0; i < 32; ++i)
+        {
+            std::memcpy(s.gpr[i], &ctx->r[i], 16);
+            std::memcpy(&s.f[i], &ctx->f[i], 4);
+            std::memcpy(s.vf[i], &ctx->vu0_vf[i], 16);
+        }
+        s.hi = ctx->hi;
+        s.lo = ctx->lo;
+        s.hi1 = ctx->hi1;
+        s.lo1 = ctx->lo1;
+        s.sa = ctx->sa;
+        std::memcpy(&s.facc, &ctx->f_acc, 4);
+        s.fcr31 = ctx->fcr31;
+        for (int i = 0; i < 16; ++i)
+            s.vi[i] = ctx->vi[i];
+        std::memcpy(s.acc, &ctx->vu0_acc, 16);
+        std::memcpy(&s.q, &ctx->vu0_q, 4);
+        std::memcpy(&s.p, &ctx->vu0_p, 4);
+        std::memcpy(&s.i, &ctx->vu0_i, 4);
+        std::memcpy(&s.r, &ctx->vu0_r, 4);
+        s.status = ctx->vu0_status;
+        s.mac = ctx->vu0_mac_flags;
+        s.clip = ctx->vu0_clip_flags;
+        return s;
+    }
+
+    void diffCallWrapper(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t address = ctx->pc;
+        const PS2Runtime::RecompiledFunction original = g_originals.at(address);
+        static std::unordered_map<uint32_t, int> calls;
+        static const int maxCalls = std::getenv("PS2X_EE_DIFF_MAX") ? std::atoi(std::getenv("PS2X_EE_DIFF_MAX"))
+                                                                    : (g_quiet ? 1 : 3);
+        const double elapsed =
+            std::chrono::duration<double>(std::chrono::steady_clock::now() - g_startTime).count();
+        std::unique_lock<std::mutex> lock(g_mutex, std::try_to_lock);
+        // GOW-Port: PS2X_EE_DIFF_EVERY=<n>: compare only every n-th call of a function (spreads the checked calls over
+        // many frames / animation phases instead of the first few calls); PS2X_EE_DIFF_MAX then bounds the checked ones.
+        static const int every = std::getenv("PS2X_EE_DIFF_EVERY") ? std::max(1, std::atoi(std::getenv("PS2X_EE_DIFF_EVERY"))) : 1;
+        static std::unordered_map<uint32_t, int> seenCalls;
+        static std::unordered_map<uint32_t, int> checked;
+        const int seq = seenCalls[address]++;
+        const bool skipThis = elapsed < g_startDelay || !lock.owns_lock() || ((seq + static_cast<int>(address >> 2)) % every) != 0 || checked[address] >= maxCalls;
+        if (!skipThis) { ++checked[address]; ++calls[address]; }
+        if (skipThis)
+        {
+            if (lock.owns_lock())
+                lock.unlock();
+            original(rdram, ctx, runtime);
+            return;
+        }
+        const uint32_t returnPc = getRegU32(ctx, 31);
+        const eeref::CpuSnapshot before = snapshotCpu(ctx);
+        uint8_t *scratch = g_runtime->memory().getScratchpad();
+        std::vector<uint8_t> ramBefore(rdram, rdram + PS2_RAM_SIZE);
+        std::vector<uint8_t> scratchBefore(scratch, scratch + PS2_SCRATCHPAD_SIZE);
+        lock.unlock(); // the call may block on other guest threads that also enter wrappers
+        original(rdram, ctx, runtime);
+        lock.lock();
+        const eeref::CpuSnapshot after = snapshotCpu(ctx);
+        if (after.gpr[29][0] != before.gpr[29][0] || ctx->pc != returnPc)
+        {
+            static std::unordered_map<uint32_t, bool> skippedOnce;
+            if (g_quiet && !skippedOnce[address])
+            {
+                skippedOnce[address] = true;
+                std::fprintf(stderr, "[eediff] %08X (ra %08X) skipped: did not return normally (pc %08X sp %08X->%08X)\n", address, returnPc, ctx->pc, static_cast<uint32_t>(before.gpr[29][0]), static_cast<uint32_t>(after.gpr[29][0]));
+            }
+            if (!g_quiet)
+                std::fprintf(stderr, "[eediff] %08X: call did not return normally, skipped\n", address);
+            return;
+        }
+        static const unsigned long long maxSteps =
+            std::getenv("PS2X_EE_DIFF_STEPS") ? std::strtoull(std::getenv("PS2X_EE_DIFF_STEPS"), nullptr, 10) : 2'000'000ull;
+        const eeref::Result result = eeref::run(before, ramBefore.data(), scratchBefore.data(), address, returnPc,
+                                                after, rdram, scratch, maxSteps);
+        static unsigned identical = 0, stopped = 0, differing = 0;
+        if (!result.completed)
+        {
+            ++stopped;
+            // Report each not-comparable function once, so unchecked code is visible.
+            static std::unordered_map<uint32_t, bool> reported;
+            if (!reported[address])
+            {
+                reported[address] = true;
+                std::fprintf(stderr, "[eediff] %08X (ra %08X) not comparable: %s (%llu steps)\n", address, returnPc,
+                             result.stopReason.c_str(), (unsigned long long)result.steps);
+            }
+        }
+        else if (result.differences.empty())
+            ++identical;
+        else
+            ++differing;
+        // GOW-Port: differences written above the entry stack pointer land in a caller's frame (outputs or the
+        // locals of a never-returning loop); report them separately, they are invisible in the caller's own diff.
+        if (result.completed)
+        {
+            const uint32_t entrySp = static_cast<uint32_t>(before.gpr[29][0]) & 0x01FFFFFFu;
+            static unsigned callerFrame = 0;
+            for (const std::string &line : result.differences)
+            {
+                unsigned long addr = 0;
+                if (line.rfind("mem ", 0) == 0 && std::sscanf(line.c_str() + 4, "%lx", &addr) == 1 &&
+                    addr >= entrySp && addr < 0x02000000ul && callerFrame < 200u)
+                {
+                    ++callerFrame;
+                    std::fprintf(stderr, "[eediff-callerframe] %08X (ra %08X) sp=%08X %s\n", address, returnPc, entrySp,
+                                 line.c_str());
+                }
+            }
+        }
+        if (result.completed && !result.differences.empty())
+        {
+            std::fprintf(stderr, "[eediff] %08X (ra %08X) call %d: %zu+ differences (%llu steps)\n", address, returnPc,
+                         calls[address], result.differences.size(), (unsigned long long)result.steps);
+            for (const std::string &line : result.differences)
+                std::fprintf(stderr, "[eediff]    %s\n", line.c_str());
+        }
+        else if (!g_quiet)
+            std::fprintf(stderr, "[eediff] %08X call %d: %s (%llu steps)\n", address, calls[address],
+                         result.completed ? "identical" : result.stopReason.c_str(), (unsigned long long)result.steps);
+        if (((identical + stopped + differing) % 200u) == 0u)
+            std::fprintf(stderr, "[eediff] tally: %u identical, %u differing, %u not comparable\n", identical,
+                         differing, stopped);
+    }
+}
+
+void ps2InstallEeDiff(PS2Runtime &runtime)
+{
+    const char *list = std::getenv("PS2X_EE_DIFF");
+    if (!list || !*list)
+        return;
+    g_runtime = &runtime;
+    g_startTime = std::chrono::steady_clock::now();
+    if (const char *start = std::getenv("PS2X_EE_DIFF_START"))
+        g_startDelay = std::atof(start);
+    unsigned hooked = 0;
+    auto hook = [&](uint32_t address)
+    {
+        if (g_originals.count(address) != 0u)
+            return;
+        if (const PS2Runtime::RecompiledFunction original = runtime.lookupFunction(address))
+        {
+            g_originals[address] = original;
+            runtime.replaceFunction(address, diffCallWrapper);
+            ++hooked;
+        }
+    };
+    if (std::strcmp(list, "all") == 0)
+    {
+        g_quiet = true;
+        for (uint32_t address = 0x00100000u; address < 0x002C0000u; address += 4u)
+            hook(address);
+    }
+    else
+        for (const char *cursor = list; cursor && *cursor;)
+        {
+            char *end = nullptr;
+            hook(static_cast<uint32_t>(std::strtoul(cursor, &end, 16)));
+            cursor = (end && *end == ',') ? end + 1 : nullptr;
+        }
+    std::fprintf(stderr, "[eediff] hooked %u functions (start after %.1f s)\n", hooked, g_startDelay);
+}
+
+// GOW-Port: PS2X_EE_WATCH_WORD=<hex addr>: every recompiled function is wrapped; after a call returns, if the
+// watched 32-bit word changed, "[eewatch] <func> (ra) old -> new" is printed (first 40 changes). Nested calls
+// report first, so the first line of a change names the innermost function that wrote it.
+namespace
+{
+    uint32_t g_watchAddress = 0;
+    std::unordered_map<uint32_t, PS2Runtime::RecompiledFunction> g_watchOriginals;
+    void watchWrapper(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t address = ctx->pc, ra = getRegU32(ctx, 31);
+        uint32_t before;
+        std::memcpy(&before, rdram + g_watchAddress, 4);
+        g_watchOriginals.at(address)(rdram, ctx, runtime);
+        uint32_t after;
+        std::memcpy(&after, rdram + g_watchAddress, 4);
+        static unsigned reports = 0;
+        if (after != before && reports < 40u)
+        {
+            ++reports;
+            float fb, fa;
+            std::memcpy(&fb, &before, 4);
+            std::memcpy(&fa, &after, 4);
+            std::fprintf(stderr, "[eewatch] %08X (ra %08X) %08X (%g) -> %08X (%g)\n", address, ra, before, fb, after, fa);
+        }
+    }
+}
+
+void ps2InstallEeWatch(PS2Runtime &runtime)
+{
+    const char *value = std::getenv("PS2X_EE_WATCH_WORD");
+    if (!value || !*value)
+        return;
+    g_watchAddress = static_cast<uint32_t>(std::strtoul(value, nullptr, 16)) & 0x01FFFFFCu;
+    unsigned hooked = 0;
+    for (uint32_t address = 0x00100000u; address < 0x002C0000u; address += 4u)
+        if (const PS2Runtime::RecompiledFunction original = runtime.lookupFunction(address))
+        {
+            g_watchOriginals[address] = original;
+            runtime.replaceFunction(address, watchWrapper);
+            ++hooked;
+        }
+    std::fprintf(stderr, "[eewatch] watching %08X in %u functions\n", g_watchAddress, hooked);
+}
+
+#include "../ee_watch.h"
+#include "runtime/ee_scheduler.h"
+
+// GOW-Port: PS2X_EE_WATCH=<hex addr>[:<hex len>]: page-guard write watchpoint (ported from the PAL stack); logs the
+// guest pc/ra of every store into the range, also from code that never returns (thread main loops).
+void ps2InstallEePageWatch(PS2Runtime &runtime)
+{
+    const char *spec = std::getenv("PS2X_EE_WATCH");
+    if (!spec)
+        return;
+    char *end = nullptr;
+    const uint32_t guest = static_cast<uint32_t>(std::strtoul(spec, &end, 16)) & 0x1FFFFFFu;
+    uint32_t length = 16;
+    if (end && *end == ':')
+        length = static_cast<uint32_t>(std::strtoul(end + 1, nullptr, 16));
+    eewatch::install(runtime.memory().getRDRAM(), guest, length, [&runtime](uint32_t &pc, uint32_t &ra)
+                     {
+                         R5900Context *ctx = runtime.eeScheduler().currentContext();
+                         pc = ctx ? ctx->pc : 0u;
+                         ra = ctx ? getRegU32(ctx, 31) : 0u; });
+}
diff --git a/ps2xRuntime/src/lib/ee_ref/eeref.cpp b/ps2xRuntime/src/lib/ee_ref/eeref.cpp
new file mode 100644
index 0000000..56fb18d
--- /dev/null
+++ b/ps2xRuntime/src/lib/ee_ref/eeref.cpp
@@ -0,0 +1,342 @@
+#include <cstdlib>
+// EE differential tester core: memory model, execute loop, branches (PCSX2 Interpreter.cpp), COP2 moves
+// (PCSX2 VU0.cpp) and the comparison. PCSX2-derived parts are GPL-3.0+.
+#include "Common.h"
+#include "R5900OpcodeTables.h"
+#include "eeref.h"
+
+#include <set>
+
+alignas(16) cpuRegistersPack _cpuRegistersPack;
+alignas(16) tlbs tlb[48];
+cachedTlbs_t cachedTlbs;
+s32 EEsCycle;
+u64 EEoCycle;
+
+namespace pcsx2vu0
+{
+    void special(u32 code);
+    u32 *vf(int index);
+    u32 &vi(int index);
+    u32 *acc();
+}
+
+namespace
+{
+    constexpr u32 kRamSize = 32u * 1024u * 1024u;
+    constexpr u32 kScratchSize = 16u * 1024u;
+    std::vector<u8> s_ram;
+    std::vector<u8> s_scratch;
+    std::set<u32> s_written; // words written by the reference run (RAM: physical, scratchpad: 0x70000000|offset)
+    const char *s_stop = nullptr;
+
+    u8 *resolve(u32 addr, u32 size, bool write)
+    {
+        if ((addr & 0xF0000000u) == 0x70000000u)
+        {
+            const u32 off = addr & (kScratchSize - 1);
+            if (off + size > kScratchSize)
+                return nullptr;
+            if (write)
+                for (u32 i = 0; i < size; i += 4)
+                    s_written.insert(0x70000000u | ((off + i) & ~3u));
+            return s_scratch.data() + off;
+        }
+        const u32 phys = addr & 0x1FFFFFFFu;
+        if (phys + size > kRamSize)
+            return nullptr;
+        if (write)
+            for (u32 i = 0; i < size; i += 4)
+                s_written.insert((phys + i) & ~3u);
+        return s_ram.data() + phys;
+    }
+
+    template <typename T>
+    T load(u32 addr)
+    {
+        T value{};
+        if (u8 *p = resolve(addr & ~static_cast<u32>(sizeof(T) - 1), sizeof(T), false))
+            std::memcpy(&value, p, sizeof(T));
+        else
+            eeref::stop("read outside RAM/scratchpad");
+        return value;
+    }
+
+    template <typename T>
+    void store(u32 addr, T value)
+    {
+        if (u8 *p = resolve(addr & ~static_cast<u32>(sizeof(T) - 1), sizeof(T), true))
+            std::memcpy(p, &value, sizeof(T));
+        else
+            eeref::stop("write outside RAM/scratchpad");
+    }
+
+    void execI()
+    {
+        cpuRegs.code = memRead32(cpuRegs.pc);
+        cpuRegs.pc += 4;
+        R5900::GetCurrentInstruction().interpret();
+    }
+
+    // PCSX2 Interpreter.cpp _doBranch_shared: run the delay slot, then jump.
+    void doBranch(u32 target)
+    {
+        cpuRegs.branch = 1;
+        execI();
+        cpuRegs.pc = target;
+        cpuRegs.branch = 0;
+    }
+}
+
+u8 memRead8(u32 a) { return load<u8>(a); }
+u16 memRead16(u32 a) { return load<u16>(a); }
+u32 memRead32(u32 a) { return load<u32>(a); }
+u64 memRead64(u32 a) { return load<u64>(a); }
+void memRead128(u32 a, u128 &out) { out = load<u128>(a); }
+void memWrite8(u32 a, u8 v) { store<u8>(a, v); }
+void memWrite16(u32 a, u16 v) { store<u16>(a, v); }
+void memWrite32(u32 a, u32 v) { store<u32>(a, v); }
+void memWrite64(u32 a, u64 v) { store<u64>(a, v); }
+void memWrite128(u32 a, const u128 &v) { store<u128>(a, v); }
+void cpuException(u32, u32) { eeref::stop("cpu exception"); }
+void intUpdateCPUCycles() {}
+void intEventTest() {}
+void intDoBranch(u32 target) { doBranch(target); }
+void intSetBranch() {}
+
+namespace eeref
+{
+    void stop(const char *reason)
+    {
+        if (!s_stop)
+            s_stop = reason;
+    }
+
+    // COP2 (VU0 macro mode). Moves follow PCSX2 VU0.cpp; arithmetic runs PCSX2's VUops via pcsx2vu0::special.
+    void cop2(u32 code)
+    {
+        const u32 rs = (code >> 21) & 0x1F, rt = (code >> 16) & 0x1F, rd = (code >> 11) & 0x1F;
+        switch (rs)
+        {
+        case 1: // QMFC2
+            if (rt)
+                std::memcpy(&cpuRegs.GPR.r[rt].UD[0], pcsx2vu0::vf(rd), 16);
+            break;
+        case 2: // CFC2
+            if (rt)
+            {
+                if (rd == 20)
+                    cpuRegs.GPR.r[rt].UD[0] = pcsx2vu0::vi(20) & 0x7FFFFF;
+                else
+                    cpuRegs.GPR.r[rt].SD[0] = static_cast<s32>(pcsx2vu0::vi(rd));
+            }
+            break;
+        case 5: // QMTC2
+            if (rd)
+                std::memcpy(pcsx2vu0::vf(rd), &cpuRegs.GPR.r[rt].UD[0], 16);
+            break;
+        case 6: // CTC2 (VI registers, R, I, Q)
+            if (rd && rd < 16)
+                pcsx2vu0::vi(rd) = cpuRegs.GPR.r[rt].UL[0] & 0xFFFF;
+            else if (rd == 20)
+                pcsx2vu0::vi(20) = (cpuRegs.GPR.r[rt].UL[0] & 0x7FFFFF) | 0x3F800000;
+            else if (rd == 21 || rd == 22)
+                pcsx2vu0::vi(rd) = cpuRegs.GPR.r[rt].UL[0];
+            else if (rd)
+                stop("CTC2 to a VU control register");
+            break;
+        case 8: // BC2F/BC2T/BC2FL/BC2TL: VU0 is never busy in macro-only code
+        {
+            const bool taken = (rt & 1) == 0; // BC2F taken, BC2T not taken
+            const u32 target = cpuRegs.pc + static_cast<u32>(static_cast<s32>(static_cast<s16>(code)) * 4);
+            if (taken)
+                doBranch(target);
+            else if (rt & 2)
+                cpuRegs.pc += 4; // branch likely, not taken: skip the delay slot
+            break;
+        }
+        default:
+            if (rs >= 16)
+                pcsx2vu0::special(code);
+            else
+                stop("unknown COP2 instruction");
+            break;
+        }
+    }
+
+    Result run(const CpuSnapshot &before, const uint8_t *ram, const uint8_t *scratch, uint32_t entryPc,
+               uint32_t returnPc, const CpuSnapshot &after, const uint8_t *ramAfter, const uint8_t *scratchAfter,
+               uint64_t maxSteps)
+    {
+        Result result;
+        s_ram.assign(ram, ram + kRamSize);
+        s_scratch.assign(scratch, scratch + kScratchSize);
+        s_written.clear();
+        s_stop = nullptr;
+
+        std::memset(&cpuRegs, 0, sizeof(cpuRegs));
+        std::memset(&fpuRegs, 0, sizeof(fpuRegs));
+        for (int i = 0; i < 32; ++i)
+        {
+            cpuRegs.GPR.r[i].UD[0] = before.gpr[i][0];
+            cpuRegs.GPR.r[i].UD[1] = before.gpr[i][1];
+            fpuRegs.fpr[i].UL = before.f[i];
+            std::memcpy(pcsx2vu0::vf(i), before.vf[i], 16);
+        }
+        cpuRegs.HI.UD[0] = before.hi;
+        cpuRegs.HI.UD[1] = before.hi1;
+        cpuRegs.LO.UD[0] = before.lo;
+        cpuRegs.LO.UD[1] = before.lo1;
+        cpuRegs.sa = before.sa;
+        fpuRegs.ACC.UL = before.facc;
+        fpuRegs.fprc[31] = before.fcr31;
+        for (int i = 0; i < 16; ++i)
+            pcsx2vu0::vi(i) = before.vi[i];
+        std::memcpy(pcsx2vu0::acc(), before.acc, 16);
+        pcsx2vu0::vi(22) = before.q;
+        pcsx2vu0::vi(23) = before.p;
+        pcsx2vu0::vi(21) = before.i;
+        pcsx2vu0::vi(20) = before.r;
+        pcsx2vu0::vi(16) = before.status;
+        pcsx2vu0::vi(17) = before.mac;
+        pcsx2vu0::vi(18) = before.clip;
+        pcsx2vu0::vf(0)[0] = pcsx2vu0::vf(0)[1] = pcsx2vu0::vf(0)[2] = 0;
+        pcsx2vu0::vf(0)[3] = 0x3F800000u;
+
+        const u64 entrySp = cpuRegs.GPR.r[29].UD[0];
+        cpuRegs.pc = entryPc;
+        while (result.steps < maxSteps && !s_stop)
+        {
+            if (cpuRegs.pc == returnPc && cpuRegs.GPR.r[29].UD[0] == entrySp)
+            {
+                result.completed = true;
+                break;
+            }
+            execI();
+            ++result.steps;
+        }
+        if (!result.completed)
+        {
+            result.stopReason = s_stop ? s_stop : "step limit";
+            return result;
+        }
+
+        char line[220];
+        const auto note = [&](const char *text)
+        {
+            if (result.differences.size() < (std::getenv("PS2X_EE_DIFF_LINES") ? static_cast<size_t>(std::atoi(std::getenv("PS2X_EE_DIFF_LINES"))) : 24u))
+                result.differences.emplace_back(text);
+        };
+        for (int i = 1; i < 32; ++i)
+        {
+            if (i == 26 || i == 27)
+                continue; // k0/k1
+            if (cpuRegs.GPR.r[i].UD[0] != after.gpr[i][0] || cpuRegs.GPR.r[i].UD[1] != after.gpr[i][1])
+            {
+                std::snprintf(line, sizeof(line), "gpr%-2d ref %016llX_%016llX ours %016llX_%016llX", i,
+                              (unsigned long long)cpuRegs.GPR.r[i].UD[1], (unsigned long long)cpuRegs.GPR.r[i].UD[0],
+                              (unsigned long long)after.gpr[i][1], (unsigned long long)after.gpr[i][0]);
+                note(line);
+            }
+        }
+        for (int i = 0; i < 32; ++i)
+            if (fpuRegs.fpr[i].UL != after.f[i])
+            {
+                std::snprintf(line, sizeof(line), "f%-2d ref %08X (%g) ours %08X (%g)", i, fpuRegs.fpr[i].UL,
+                              fpuRegs.fpr[i].f, after.f[i], std::bit_cast<float>(after.f[i]));
+                note(line);
+            }
+        for (int i = 1; i < 32; ++i)
+            if (std::memcmp(pcsx2vu0::vf(i), after.vf[i], 16) != 0)
+            {
+                const u32 *r = pcsx2vu0::vf(i);
+                std::snprintf(line, sizeof(line), "vf%-2d ref %g %g %g %g ours %g %g %g %g", i,
+                              std::bit_cast<float>(r[0]), std::bit_cast<float>(r[1]), std::bit_cast<float>(r[2]),
+                              std::bit_cast<float>(r[3]), std::bit_cast<float>(after.vf[i][0]),
+                              std::bit_cast<float>(after.vf[i][1]), std::bit_cast<float>(after.vf[i][2]),
+                              std::bit_cast<float>(after.vf[i][3]));
+                note(line);
+            }
+        {
+            struct Ctl { const char *name; int idx; u32 ours; u32 mask; };
+            const Ctl ctls[] = {{"vuQ", 22, after.q, 0xFFFFFFFFu}, {"vuP", 23, after.p, 0xFFFFFFFFu}, {"vuI", 21, after.i, 0xFFFFFFFFu},
+                                {"vuStatus", 16, after.status, 0xFFFu}, {"vuMAC", 17, after.mac, 0xFFFFu}, {"vuClip", 18, after.clip, 0xFFFFFFu}};
+            for (const Ctl &c : ctls)
+            {
+                const u32 ref = pcsx2vu0::vi(c.idx);
+                if ((ref & c.mask) != (c.ours & c.mask))
+                {
+                    std::snprintf(line, sizeof(line), "%s ref %08X ours %08X", c.name, ref & c.mask, c.ours & c.mask);
+                    note(line);
+                }
+            }
+        }
+        for (const u32 word : s_written)
+        {
+            u32 ref, ours;
+            if ((word & 0xF0000000u) == 0x70000000u)
+            {
+                std::memcpy(&ref, s_scratch.data() + (word & (kScratchSize - 1)), 4);
+                std::memcpy(&ours, scratchAfter + (word & (kScratchSize - 1)), 4);
+            }
+            else
+            {
+                std::memcpy(&ref, s_ram.data() + word, 4);
+                std::memcpy(&ours, ramAfter + word, 4);
+            }
+            if (ref != ours)
+            {
+                std::snprintf(line, sizeof(line), "mem %08X ref %08X (%g) ours %08X (%g)", word, ref,
+                              std::bit_cast<float>(ref), ours, std::bit_cast<float>(ours));
+                note(line);
+            }
+        }
+        return result;
+    }
+}
+
+
+void GoemonPreloadTlb() {}
+void GoemonUnloadTlb(u32) {}
+
+namespace R5900::Interpreter::OpcodeImpl
+{
+    // LQC2/SQC2 (PCSX2 VU0.cpp).
+    void LQC2()
+    {
+        const u32 addr = cpuRegs.GPR.r[_Rs_].UL[0] + static_cast<s16>(cpuRegs.code);
+        u128 value;
+        memRead128(addr, value);
+        if (_Rt_)
+            std::memcpy(pcsx2vu0::vf(_Rt_), &value, 16);
+    }
+    void SQC2()
+    {
+        const u32 addr = cpuRegs.GPR.r[_Rs_].UL[0] + static_cast<s16>(cpuRegs.code);
+        u128 value;
+        std::memcpy(&value, pcsx2vu0::vf(_Rt_), 16);
+        memWrite128(addr, value);
+    }
+    void CACHE() {}
+
+    // COP0 (system control) is outside what the differential tester compares: stop the reference run.
+    namespace COP0
+    {
+        void MFC0() { eeref::stop("COP0"); }
+        void MTC0() { eeref::stop("COP0"); }
+        void BC0F() { eeref::stop("COP0"); }
+        void BC0T() { eeref::stop("COP0"); }
+        void BC0FL() { eeref::stop("COP0"); }
+        void BC0TL() { eeref::stop("COP0"); }
+        void TLBR() { eeref::stop("COP0"); }
+        void TLBWI() { eeref::stop("COP0"); }
+        void TLBWR() { eeref::stop("COP0"); }
+        void TLBP() { eeref::stop("COP0"); }
+        void ERET() { eeref::stop("COP0"); }
+        void EI() { eeref::stop("COP0"); }
+        void DI() { eeref::stop("COP0"); }
+    }
+}
