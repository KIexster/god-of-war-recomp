-               (static_cast<uint64_t>(dy & 0x07FF) << 12) |
-               (static_cast<uint64_t>(magh & 0x0F) << 23) |
-               (static_cast<uint64_t>(magv & 0x03) << 27) |
-               (static_cast<uint64_t>(dw & 0x0FFF) << 32) |
