-            return static_cast<uint64_t>(lbn) < totalSectors;
-        }
-
-        return false;
-    }
-
-    bool findRegisteredCdFileForLbn(uint32_t lbn, CdFileEntry &entryOut)
-    {
-        for (const auto &[key, entry] : g_cdFilesByKey)
-        {
-            const uint32_t endLbn = entry.baseLbn + entry.sectors;
