-    uint32_t toDmaPhys(uint32_t addr)
-    {
-        if ((addr & 0x80000000u) != 0)
-        {
-            uint32_t lower = addr & 0x7FFFFFFFu;
-            if (lower >= PS2_SCRATCHPAD_BASE &&
-                lower < PS2_SCRATCHPAD_BASE + PS2_SCRATCHPAD_SIZE)
-            {
-                return lower;
-            }
-        }
-        return addr & 0x1FFFFFFFu;
-    }
