-    bool tryReadByteFromGuest(uint8_t *rdram, PS2Runtime *runtime, uint32_t addr, uint8_t &outByte)
-    {
-        const uint8_t *chPtr = getConstMemPtr(rdram, addr);
-        if (chPtr)
-        {
-            outByte = *chPtr;
-            return true;
-        }
-
-        if (runtime)
-        {
-            try
-            {
-                outByte = runtime->memory().read8(addr);
-                return true;
-            }
-            catch (...)
-            {
-                return false;
-            }
-        }
-        return false;
-    }
