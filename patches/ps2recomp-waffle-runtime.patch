-        std::cerr << "sceCdRead unresolved LBN 0x" << std::hex << lbn
-                  << " sectors=" << std::dec << sectors
-                  << " (no mapped file and no configured CD image)" << std::endl;
-        g_lastCdError = -1;
-        return false;
-    }
