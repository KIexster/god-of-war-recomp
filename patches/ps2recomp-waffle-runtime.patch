diff --git a/ps2xTest/src/ps2_gpu_profile_tests.cpp b/ps2xTest/src/ps2_gpu_profile_tests.cpp
new file mode 100644
index 0000000..9ec0d13
--- /dev/null
+++ b/ps2xTest/src/ps2_gpu_profile_tests.cpp
@@ -0,0 +1,247 @@
+// GOW-Port: timestamps simulados para probar el perfil sin juego ni driver.
+#include "MiniTest.h"
+#include "gs/gs_gpu_profile.h"
+
+#include <set>
+#include <vector>
+
+namespace
+{
+    using GSGpuProfile::Queue;
+    using GSGpuProfile::Window;
+
+    void frames(Queue &queue, unsigned count = 4u)
+    {
+        for (unsigned i = 0u; i < count; ++i)
+            queue.endFrame();
+    }
+
+    bool sample(Queue &queue, uint32_t kind, uint32_t begin, uint32_t end,
+                std::array<uint32_t, 8> info = {})
+    {
+        if (!queue.sampleAllowed())
+            return false;
+        queue.pending.push_back({kind, begin, end, info});
+        return true;
+    }
+}
+
+void register_ps2_gpu_profile_tests()
+{
+    MiniTest::Case("GS GPU perfil diferido", [](TestCase &tc)
+    {
+        tc.Run("GPU ocupada no lee resultados ni recicla consultas", [](TestCase &t)
+        {
+            Queue q;
+            sample(q, 0u, 1u, 2u);
+            frames(q);
+            unsigned probes = 0u, reads = 0u, reports = 0u;
+            q.collect([&](uint32_t id)
+                      {
+                          ++probes;
+                          t.Equals(id, 2u, "Solo consulta disponibilidad del último timestamp");
+                          return false;
+                      },
+                      [&](uint32_t) { ++reads; t.Fail("Lectura prematura"); return uint64_t{0}; },
+                      [&](const Window &) { ++reports; });
+            t.Equals(probes, 1u, "Una consulta, sin bucle de espera");
+            t.Equals(reads, 0u, "No lee QUERY_RESULT pendiente");
+            t.Equals(reports, 0u, "No informa una ventana incompleta");
+            t.Equals(q.waitingWindows(), size_t{1}, "Retiene la ventana");
+            t.IsTrue(q.freeQueries.empty(), "No reutiliza handles pendientes");
+        });
+
+        tc.Run("Recoge ventanas listas en orden y una sola vez", [](TestCase &t)
+        {
+            Queue q;
+            sample(q, 0u, 1u, 2u); q.prims = 11u; frames(q);
+            sample(q, 2u, 3u, 4u); q.prims = 29u; frames(q);
+            std::vector<Window> reports;
+            std::vector<uint32_t> reads;
+            bool secondReady = false;
+            auto collect = [&]
+            {
+                q.collect([&](uint32_t id) { return id == 2u || secondReady; },
+                          [&](uint32_t id)
+                          {
+                              t.IsTrue(id <= 2u || secondReady, "No lee la segunda ventana prematuramente");
+                              reads.push_back(id);
+                              const uint64_t values[] = {0u, 100u, 160u, 200u, 320u};
+                              return values[id];
+                          },
+                          [&](const Window &w) { reports.push_back(w); });
+            };
+            collect();
+            t.Equals(reports.size(), size_t{1}, "Solo recoge la primera ventana");
+            t.Equals(q.waitingWindows(), size_t{1}, "Conserva la segunda");
+            t.Equals(reads, std::vector<uint32_t>({1u, 2u}), "Lee una vez los timestamps listos");
+            secondReady = true;
+            collect(); collect();
+            t.Equals(reports.size(), size_t{2}, "No duplica informes");
+            t.Equals(reads, std::vector<uint32_t>({1u, 2u, 3u, 4u}), "Orden estable");
+            if (reports.size() != 2u)
+                return;
+            t.Equals(reports[0].ns[0], uint64_t{60}, "Tiempo raster original");
+            t.Equals(reports[1].ns[2], uint64_t{120}, "Tiempo upload original");
+            t.Equals(reports[0].prims, uint64_t{11}, "Contadores de la primera ventana");
+            t.Equals(reports[1].prims, uint64_t{29}, "Contadores de la segunda");
+            t.Equals(reports[0].frames, uint64_t{4}, "Cuatro cuadros originales");
+            t.Equals(reports[1].frames, uint64_t{4}, "Cuatro cuadros siguientes");
+            t.Equals(q.freeQueries, std::vector<uint32_t>({1u, 2u, 3u, 4u}), "Recicla tras leer");
+        });
+
+        tc.Run("Preserva metadatos y contadores con sus timestamps", [](TestCase &t)
+        {
+            Queue q;
+            const std::array<uint32_t, 8> info = {7u, 8u, 9u, 10u, 0xd0u, 2u, 0x120u, 0x4bu};
+            sample(q, 0u, 1u, 2u, info); sample(q, 0u, 3u, 4u, info);
+            q.prims = 14u; q.pairs = 18u; q.tiles = 16u;
+            q.maxBin = 10u; q.sumMaxBin = 20u;
+            q.reasons[3] = 2u; q.uploadHazards[1] = 3u;
+            frames(q);
+            t.Equals(q.prims, uint64_t{0}, "Reinicia contadores activos");
+            t.Equals(q.reasons[3], uint64_t{0}, "Reinicia razones activas");
+            q.prims = 999u; q.reasons[3] = 999u; q.uploadHazards[1] = 999u; q.nextInfo.fill(999u);
+            unsigned reports = 0u;
+            q.collect([](uint32_t) { return true; },
+                      [](uint32_t id) { return uint64_t{id} * 50u; },
+                      [&](const Window &w)
+                      {
+                          ++reports;
+                          t.Equals(w.ns[0], uint64_t{100}, "Suma las dos muestras");
+                          t.Equals(w.count[0], uint64_t{2}, "Cuenta las dos muestras");
+                          t.Equals(w.prims, uint64_t{14}, "No mezcla primitivas nuevas");
+                          t.Equals(w.pairs, uint64_t{18}, "Conserva pares");
+                          t.Equals(w.tiles, uint64_t{16}, "Conserva tiles");
+                          t.Equals(w.maxBin, uint64_t{10}, "Conserva máximo");
+                          t.Equals(w.sumMaxBin, uint64_t{20}, "Conserva suma");
+                          t.Equals(w.reasons[3], uint64_t{2}, "Conserva razones");
+                          t.Equals(w.uploadHazards[1], uint64_t{3}, "Conserva hazards");
+                          t.Equals(w.rasterTimes.size(), size_t{2}, "Retiene muestras raster");
+                          for (const auto &entry : w.rasterTimes)
+                          {
+                              t.Equals(entry.first, uint64_t{50}, "Duración correcta");
+                              t.Equals(entry.second, info, "FBP, PSM, ZBP y flags originales");
+                          }
+                      });
+            t.Equals(reports, 1u, "Informa la ventana congelada");
+            t.Equals(q.prims, uint64_t{999}, "No altera contadores nuevos al recoger");
+        });
+
+        tc.Run("Cola llena conserva cuadros sin esperar", [](TestCase &t)
+        {
+            Queue q;
+            for (uint32_t i = 1u; i <= 3u; ++i)
+            {
+                sample(q, 0u, i * 2u - 1u, i * 2u); q.prims = i; frames(q);
+            }
+            sample(q, 0u, 7u, 8u); q.prims = 4u; frames(q);
+            t.Equals(q.waitingWindows(), GSGpuProfile::kMaxWaitingWindows, "Cola limitada");
+            t.Equals(q.frames, uint64_t{4}, "Conserva ventana activa");
+            t.Equals(q.prims, uint64_t{4}, "Conserva contadores activos");
+            std::vector<Window> reports;
+            q.collect([](uint32_t) { return false; },
+                      [&](uint32_t) { t.Fail("No espera con la cola llena"); return uint64_t{0}; },
+                      [&](const Window &) { t.Fail("No informa resultados pendientes"); });
+            auto collect = [&]
+            {
+                q.collect([](uint32_t) { return true; },
+                          [](uint32_t id) { return uint64_t{id} * 10u; },
+                          [&](const Window &w) { reports.push_back(w); });
+            };
+            collect(); q.endFrame(); collect();
+            t.Equals(q.frames, uint64_t{0}, "Sella al liberarse espacio");
+            t.Equals(reports.size(), size_t{4}, "No pierde ventanas");
+            uint64_t totalFrames = 0u, totalPrims = 0u;
+            for (const auto &w : reports)
+            {
+                totalFrames += w.frames; totalPrims += w.prims;
+                t.Equals(w.ns[0], uint64_t{10}, "Cada ventana conserva su muestra");
+            }
+            t.Equals(totalFrames, uint64_t{17}, "Cuenta 17 cuadros reales");
+            t.Equals(totalPrims, uint64_t{10}, "Cuenta 10 primitivas reales");
+            if (reports.size() == 4u)
+                t.Equals(reports[3].frames, uint64_t{5}, "Divisor real con contrapresión");
+        });
+
+        tc.Run("Limita consultas y marca omisiones sin perder contadores", [](TestCase &t)
+        {
+            Queue q;
+            for (uint32_t i = 0u; i < GSGpuProfile::kMaxSamplesPerWindow + 3u; ++i)
+            {
+                sample(q, 0u, i * 2u + 1u, i * 2u + 2u); ++q.prims;
+            }
+            t.Equals(q.pending.size(), GSGpuProfile::kMaxSamplesPerWindow, "Máximo 4096 pares");
+            frames(q);
+            unsigned reports = 0u;
+            q.collect([](uint32_t) { return true; },
+                      [](uint32_t id) { return uint64_t{id} * 100u; },
+                      [&](const Window &w)
+                      {
+                          ++reports;
+                          t.Equals(w.skippedQueries, uint64_t{3}, "Perfil explícitamente parcial");
+                          t.Equals(w.prims, uint64_t{4099}, "Conserva trabajo sin muestra");
+                          t.Equals(w.count[0], uint64_t{4096}, "Cuenta muestras aceptadas");
+                          t.Equals(w.ns[0], uint64_t{409600}, "Tiempo de muestras aceptadas");
+                          t.Equals(w.rasterTimes.size(), size_t{4096}, "Memoria raster limitada");
+                      });
+            t.Equals(reports, 1u, "Informe parcial único");
+            t.Equals(q.freeQueries.size(), size_t{8192}, "Recicla consultas aceptadas");
+            const std::set<uint32_t> handles(q.freeQueries.begin(), q.freeQueries.end());
+            t.Equals(handles.size(), size_t{8192}, "No recicla handles dos veces");
+            t.IsTrue(q.sampleAllowed(), "Siguiente ventana vuelve a medir");
+            t.Equals(q.skippedQueries, uint64_t{0}, "No arrastra omisiones");
+        });
+
+        tc.Run("Cierre recoge ventana corta y recicla todos los handles", [](TestCase &t)
+        {
+            Queue q;
+            sample(q, 0u, 1u, 2u); frames(q);
+            sample(q, 5u, 3u, 4u); frames(q, 2u);
+            q.finish(); q.finish();
+            unsigned probes = 0u;
+            std::vector<Window> reports;
+            q.collect([&](uint32_t) { ++probes; return false; },
+                      [](uint32_t id) { return uint64_t{id} * 10u; },
+                      [&](const Window &w) { reports.push_back(w); }, true);
+            t.Equals(probes, 0u, "Solo el cierre permite lectura forzada");
+            t.Equals(reports.size(), size_t{2}, "Cerrar dos veces no duplica");
+            if (reports.size() == 2u)
+            {
+                t.Equals(reports[0].frames, uint64_t{4}, "Ventana completa");
+                t.Equals(reports[1].frames, uint64_t{2}, "Divisor de ventana corta");
+                t.Equals(reports[1].ns[5], uint64_t{10}, "Timestamp de presentación");
+            }
+            t.Equals(q.waitingWindows(), size_t{0}, "No quedan pendientes");
+            t.Equals(q.freeQueries.size(), size_t{4}, "Handles listos para DeleteQueries");
+        });
+
+        tc.Run("Cierre vacío no inventa cuadros", [](TestCase &t)
+        {
+            Queue q;
+            q.finish();
+            q.collect([](uint32_t) { return true; },
+                      [&](uint32_t) { t.Fail("No hay consultas"); return uint64_t{0}; },
+                      [&](const Window &) { t.Fail("No hay ventanas"); }, true);
+            t.Equals(q.waitingWindows(), size_t{0}, "Cola vacía");
+            t.IsTrue(q.freeQueries.empty(), "No crea handles");
+        });
+
+        tc.Run("Ventana sin muestras conserva cuadros y contadores", [](TestCase &t)
+        {
+            Queue q;
+            q.reasons[5] = 2u; frames(q);
+            unsigned reports = 0u;
+            q.collect([&](uint32_t) { t.Fail("No necesita disponibilidad"); return false; },
+                      [&](uint32_t) { t.Fail("No hay timestamps"); return uint64_t{0}; },
+                      [&](const Window &w)
+                      {
+                          ++reports;
+                          t.Equals(w.frames, uint64_t{4}, "Cuatro cuadros sin consultas");
+                          t.Equals(w.reasons[5], uint64_t{2}, "Conserva flushes");
+                          t.Equals(w.count[0], uint64_t{0}, "No inventa muestras");
+                      });
+            t.Equals(reports, 1u, "Informa contadores reales");
+        });
+    });
+}
diff --git a/ps2xTest/src/ps2_gpu_upload_ring_tests.cpp b/ps2xTest/src/ps2_gpu_upload_ring_tests.cpp
new file mode 100644
index 0000000..11f9f3c
--- /dev/null
+++ b/ps2xTest/src/ps2_gpu_upload_ring_tests.cpp
@@ -0,0 +1,290 @@
+// GOW-Port: memoria real y fences simulados, sin driver ni assets del juego.
+#include "MiniTest.h"
+#include "gs/gs_gpu_upload_ring.h"
+
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <set>
+#include <vector>
+
+namespace
+{
+    using GSGpuUpload::Failure;
+    using GSGpuUpload::WaitResult;
+    using TestRing = GSGpuUpload::Ring<uint32_t, 64u, 4u, 16u>;
+
+    struct Fixture
+    {
+        std::array<uint8_t, 256u> bytes{};
+        TestRing ring;
+        uint32_t nextFence = 1u;
+        bool nullFence = false;
+        WaitResult outcome = WaitResult::Signaled;
+        std::vector<uint32_t> waited, deleted;
+
+        Fixture() { bytes.fill(0xa5u); ring.setStorage(bytes.data()); }
+        size_t put(const void *data, size_t size)
+        {
+            return ring.put(data, size,
+                            [&] { return nullFence ? 0u : nextFence++; },
+                            [&](uint32_t fence) { waited.push_back(fence); return outcome; },
+                            [&](uint32_t fence) { deleted.push_back(fence); });
+        }
+        void fill(TestCase &t)
+        {
+            for (uint8_t chunk = 0u; chunk < 4u; ++chunk)
+            {
+                std::array<uint8_t, 64u> data{};
+                data.fill(static_cast<uint8_t>(0x10u + chunk));
+                t.Equals(put(data.data(), data.size()), size_t{chunk} * 64u, "Llena cuatro chunks distintos");
+            }
+        }
+        void release()
+        {
+            ring.releaseFences([&](uint32_t fence) { deleted.push_back(fence); });
+        }
+    };
+
+    void failedReuse(TestCase &t, WaitResult outcome, Failure expected)
+    {
+        Fixture f;
+        f.fill(t);
+        const auto protectedBytes = f.bytes;
+        f.outcome = outcome;
+        const std::array<uint8_t, 7u> data = {1u, 2u, 3u, 4u, 5u, 6u, 7u};
+        std::vector<uint8_t> fallback;
+        unsigned fallbacks = 0u;
+        auto upload = [&]
+        {
+            const size_t offset = f.put(data.data(), data.size());
+            if (offset == SIZE_MAX)
+            {
+                ++fallbacks;
+                fallback.assign(data.begin(), data.end());
+            }
+            return offset;
+        };
+        t.Equals(upload(), SIZE_MAX, "No reutiliza un chunk cuya fence no se señaló");
+        t.Equals(f.bytes, protectedBytes, "El primer fallo no altera uploads pendientes");
+        t.IsTrue(f.ring.disabled(), "La ruta persistente queda deshabilitada");
+        t.IsFalse(f.ring.available(), "available también impide reusar el ring");
+        t.Equals(f.ring.failure(), expected, "Conserva el motivo de sincronización");
+        t.Equals(upload(), SIZE_MAX, "El segundo upload también usa fallback");
+        t.Equals(f.bytes, protectedBytes, "No escribe en el cursor del fallo anterior");
+        t.Equals(fallbacks, 2u, "Ambos uploads llegan al fallback");
+        t.Equals(fallback, std::vector<uint8_t>(data.begin(), data.end()), "El fallback conserva el payload");
+        t.Equals(f.waited, std::vector<uint32_t>({1u}), "No vuelve a esperar tras deshabilitarse");
+        t.IsTrue(f.deleted.empty(), "Retiene la fence pendiente y la recién creada");
+        t.Equals(f.nextFence, 5u, "No crea una nueva fence en el segundo intento");
+        f.release();
+        t.Equals(f.deleted, std::vector<uint32_t>({1u, 2u, 3u, 4u}), "El cierre libera todos los handles retenidos");
+        f.release();
+        t.Equals(f.deleted.size(), size_t{4}, "El segundo cierre no duplica eliminaciones");
+    }
+}
+
+void runGpuUploadRingTests()
+{
+    MiniTest::Case("GS uploads persistentes protegidos", [](TestCase &tc)
+    {
+        tc.Run("Timeout conserva memoria pendiente y usa fallback para uploads posteriores", [](TestCase &t)
+        {
+            failedReuse(t, WaitResult::Timeout, Failure::Timeout);
+        });
+        tc.Run("WaitFailed conserva memoria pendiente y usa fallback para uploads posteriores", [](TestCase &t)
+        {
+            failedReuse(t, WaitResult::Failed, Failure::WaitFailed);
+        });
+        tc.Run("Fence señalada permite reciclar solo el chunk confirmado", [](TestCase &t)
+        {
+            Fixture f;
+            f.fill(t);
+            const auto before = f.bytes;
+            std::array<uint8_t, 64u> data{};
+            data.fill(0x7bu);
+            t.Equals(f.put(data.data(), data.size()), size_t{0}, "Vuelve al primer chunk");
+            t.IsTrue(std::equal(data.begin(), data.end(), f.bytes.begin()), "Copia el payload tras la confirmación");
+            t.IsTrue(std::equal(before.begin() + 64u, before.end(), f.bytes.begin() + 64u), "Los otros tres chunks no cambian");
+            t.Equals(f.waited, std::vector<uint32_t>({1u}), "Espera la fence del destino");
+            t.Equals(f.deleted, std::vector<uint32_t>({1u}), "Libera solo la fence señalada");
+            t.IsTrue(f.ring.available(), "El éxito conserva el ring disponible");
+            t.Equals(f.ring.failure(), Failure::None, "No registra un fallo");
+        });
+        tc.Run("Fence señalada después de esperar protege memoria hasta el callback", [](TestCase &t)
+        {
+            Fixture f;
+            f.fill(t);
+            const auto before = f.bytes;
+            std::array<uint8_t, 64u> data{};
+            data.fill(0xebu);
+            unsigned simulatedPolls = 0u;
+            bool completed = false;
+            const size_t offset = f.ring.put(data.data(), data.size(),
+                [&] { return f.nextFence++; },
+                [&](uint32_t fence)
+                {
+                    t.Equals(fence, 1u, "Espera el chunk correcto");
+                    // GOW-Port: modelar la espera acotada del driver sin dormir la suite.
+                    for (; simulatedPolls < 3u; ++simulatedPolls)
+                        t.Equals(f.bytes, before, "No copia mientras la fence sigue pendiente");
+                    completed = true;
+                    return WaitResult::Signaled;
+                },
+                [&](uint32_t fence)
+                {
+                    t.IsTrue(completed, "Solo elimina la fence después de la señal");
+                    t.Equals(f.bytes, before, "La copia tampoco precede a la eliminación");
+                    f.deleted.push_back(fence);
+                });
+            t.Equals(simulatedPolls, 3u, "Se modeló la señal tardía");
+            t.Equals(offset, size_t{0}, "Acepta la confirmación después de esperar");
+            t.IsTrue(std::equal(data.begin(), data.end(), f.bytes.begin()), "Finalmente escribe el payload");
+            t.IsTrue(f.ring.available(), "La espera correcta no deshabilita el ring");
+        });
+        tc.Run("Fence nula deshabilita sin copiar ni tocar uploads previos", [](TestCase &t)
+        {
+            Fixture f;
+            std::array<uint8_t, 64u> data{};
+            data.fill(0x27u);
+            t.Equals(f.put(data.data(), data.size()), size_t{0}, "Primer chunk sin fence");
+            const auto before = f.bytes;
+            f.nullFence = true;
+            t.Equals(f.put(data.data(), 1u), SIZE_MAX, "No avanza sin fence de protección");
+            t.Equals(f.ring.failure(), Failure::NullFence, "Registra la creación fallida");
+            t.IsTrue(f.ring.disabled(), "Queda deshabilitado");
+            t.Equals(f.bytes, before, "No copia tras la creación fallida");
+            t.Equals(f.put(data.data(), 1u), SIZE_MAX, "El siguiente upload también falla");
+            t.Equals(f.bytes, before, "El segundo intento conserva todos los bytes");
+            t.IsTrue(f.waited.empty(), "No espera una fence inexistente");
+            f.release(); f.release();
+            t.IsTrue(f.deleted.empty(), "No intenta eliminar handles nulos");
+        });
+        tc.Run("Cierre elimina una sola vez los handles que quedan", [](TestCase &t)
+        {
+            Fixture f;
+            f.fill(t);
+            std::array<uint8_t, 64u> data{};
+            t.Equals(f.put(data.data(), data.size()), size_t{0}, "Recicla un chunk antes del cierre");
+            f.release(); f.release();
+            t.Equals(f.deleted, std::vector<uint32_t>({1u, 2u, 3u, 4u}), "Una eliminación por fence creada");
+            t.Equals(std::set<uint32_t>(f.deleted.begin(), f.deleted.end()).size(), size_t{4}, "No elimina dos veces un handle reciclado");
+        });
+        tc.Run("Padding mínimo y alineación no escriben en huecos ni fuera del ring", [](TestCase &t)
+        {
+            std::array<uint8_t, 272u> guarded{};
+            guarded.fill(0xa5u);
+            GSGpuUpload::Ring<uint32_t, 64u, 4u, 32u> ring;
+            ring.setStorage(guarded.data() + 8u);
+            const std::array<uint8_t, 17u> first = {1u, 2u, 3u, 4u, 5u, 6u, 7u, 8u, 9u, 10u, 11u, 12u, 13u, 14u, 15u, 16u, 17u};
+            const uint8_t one = 0x7du;
+            uint32_t nextFence = 0u;
+            auto put = [&](const void *data, size_t size)
+            {
+                return ring.put(data, size, [&] { return ++nextFence; },
+                                [](uint32_t) { return WaitResult::Signaled; }, [](uint32_t) {});
+            };
+            t.Equals(put(first.data(), first.size()), size_t{0}, "Primer payload en offset cero");
+            t.Equals(put(&one, 1u), size_t{32}, "Alinea la siguiente reserva a 32 bytes");
+            t.Equals(put(first.data(), first.size()), size_t{64}, "Mueve el payload que no cabe al chunk siguiente");
+            t.IsTrue(std::equal(first.begin(), first.end(), guarded.begin() + 8u), "Payload inicial intacto");
+            for (size_t i = 17u; i < 32u; ++i)
+                t.Equals(guarded[8u + i], uint8_t{0xa5u}, "No rellena el hueco de alineación");
+            t.Equals(guarded[8u + 32u], one, "Copia el byte útil");
+            for (size_t i = 33u; i < 48u; ++i)
+                t.Equals(guarded[8u + i], uint8_t{0u}, "Completa la reserva mínima de 16 bytes con ceros");
+            for (size_t i = 48u; i < 64u; ++i)
+                t.Equals(guarded[8u + i], uint8_t{0xa5u}, "No sobrescribe el final del chunk previo");
+            for (size_t i = 0u; i < 8u; ++i)
+            {
+                t.Equals(guarded[i], uint8_t{0xa5u}, "Guardia inicial intacta");
+                t.Equals(guarded[264u + i], uint8_t{0xa5u}, "Guardia final intacta");
+            }
+        });
+        tc.Run("Sin storage y payload sobredimensionado no copian ni crean fences", [](TestCase &t)
+        {
+            TestRing ring;
+            std::array<uint8_t, 256u> storage{};
+            storage.fill(0xa5u);
+            const auto before = storage;
+            const uint8_t data = 1u;
+            unsigned callbacks = 0u;
+            auto put = [&](size_t size)
+            {
+                return ring.put(&data, size, [&] { ++callbacks; return 1u; },
+                                [&](uint32_t) { ++callbacks; return WaitResult::Signaled; },
+                                [&](uint32_t) { ++callbacks; });
+            };
+            t.IsFalse(ring.available(), "Sin mapping no hay ring disponible");
+            t.Equals(put(1u), SIZE_MAX, "Usa fallback antes de mapear");
+            ring.setStorage(storage.data());
+            t.Equals(put(65u), SIZE_MAX, "No acepta un upload mayor que un chunk");
+            t.Equals(put((std::numeric_limits<size_t>::max)()), SIZE_MAX, "No desborda al calcular el tamaño");
+            t.Equals(storage, before, "Los rechazos conservan toda la memoria");
+            t.Equals(callbacks, 0u, "Los rechazos no consultan sincronización");
+            t.IsTrue(ring.available(), "Un payload grande no deshabilita el ring");
+            t.Equals(put(1u), size_t{0}, "Los rechazos no avanzaron el cursor");
+        });
+        tc.Run("Fuente nula reserva sin escribir y tamaño cero usa el mínimo", [](TestCase &t)
+        {
+            Fixture f;
+            const auto before = f.bytes;
+            t.Equals(f.put(nullptr, 0u), size_t{0}, "Reserva vacía de 16 bytes");
+            t.Equals(f.bytes, before, "La fuente nula conserva los bytes reservados");
+            const uint8_t data = 0x55u;
+            t.Equals(f.put(&data, 0u), size_t{16}, "La siguiente reserva empieza tras el mínimo");
+            for (size_t i = 16u; i < 32u; ++i)
+                t.Equals(f.bytes[i], uint8_t{0u}, "Fuente válida y payload cero inicializan el padding");
+        });
+        tc.Run("Un payload que termina justo en el chunk no crea fence antes de tiempo", [](TestCase &t)
+        {
+            Fixture f;
+            std::array<uint8_t, 48u> data{};
+            t.Equals(f.put(data.data(), 15u), size_t{0}, "Mínimo de 16 bytes");
+            t.Equals(f.put(data.data(), data.size()), size_t{16}, "Termina exactamente en el límite");
+            t.Equals(f.nextFence, 1u, "No crea fence mientras el upload cabe");
+            t.Equals(f.put(data.data(), 1u), size_t{64}, "El siguiente upload abre otro chunk");
+            t.Equals(f.nextFence, 2u, "Protege el chunk cerrado con una fence");
+            t.IsTrue(f.waited.empty(), "No espera un chunk todavía no usado");
+        });
+        tc.Run("Cambiar storage no rearma el ring tras un fallo", [](TestCase &t)
+        {
+            Fixture f;
+            f.fill(t);
+            f.outcome = WaitResult::Timeout;
+            const uint8_t data = 0x66u;
+            t.Equals(f.put(&data, 1u), SIZE_MAX, "Provoca el fallo de sincronización");
+            std::array<uint8_t, 256u> replacement{};
+            replacement.fill(0x37u);
+            const auto before = replacement;
+            f.ring.setStorage(nullptr); f.ring.setStorage(replacement.data());
+            t.Equals(f.put(&data, 1u), SIZE_MAX, "El fallo permanece al reasignar storage");
+            t.Equals(replacement, before, "No escribe en un mapping reasignado");
+            t.Equals(f.ring.failure(), Failure::Timeout, "Mantiene el motivo original");
+        });
+        tc.Run("Handles de tipo puntero siguen el mismo ciclo de propiedad", [](TestCase &t)
+        {
+            std::array<uint8_t, 128u> storage{};
+            std::array<uint8_t, 64u> data{};
+            std::array<uint8_t, 2u> handles{};
+            GSGpuUpload::Ring<const uint8_t *, 64u, 2u, 16u> ring;
+            ring.setStorage(storage.data());
+            size_t created = 0u;
+            std::vector<const uint8_t *> waited, deleted;
+            auto put = [&]
+            {
+                return ring.put(data.data(), data.size(),
+                                [&]() -> const uint8_t * { return &handles[created++]; },
+                                [&](const uint8_t *fence) { waited.push_back(fence); return WaitResult::Signaled; },
+                                [&](const uint8_t *fence) { deleted.push_back(fence); });
+            };
+            t.Equals(put(), size_t{0}, "Primer upload con handles puntero");
+            t.Equals(put(), size_t{64}, "Segundo chunk con fence puntero");
+            t.Equals(put(), size_t{0}, "Espera antes de volver al primer chunk");
+            t.Equals(waited, std::vector<const uint8_t *>({&handles[0]}), "Consulta la fence correcta");
+            ring.releaseFences([&](const uint8_t *fence) { deleted.push_back(fence); });
+            ring.releaseFences([&](const uint8_t *fence) { deleted.push_back(fence); });
+            t.Equals(deleted, std::vector<const uint8_t *>({&handles[0], &handles[1]}), "Libera cada puntero una vez");
+        });
+    });
+}
diff --git a/ps2xTest/src/ps2_gs_shared_queue_tests.cpp b/ps2xTest/src/ps2_gs_shared_queue_tests.cpp
new file mode 100644
index 0000000..5ddaa4d
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_shared_queue_tests.cpp
@@ -0,0 +1,348 @@
+// GOW-Port: frontend y cola reales; backend procedural detenido sin sleeps ni assets.
+#include "MiniTest.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/gs_threaded_backend.h"
+#include "runtime/gs/gs_shared_present.h"
+#include "runtime/gs/gs_swizzle.h"
+#include "runtime/ps2_memory.h"
+
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace
+{
+    enum Event { Draw = 1, Present = 2, Read = 3, Finish = 4, Capture = 5, Flush = 6 };
+    struct Recording
+    {
+        std::mutex mutex;
+        std::condition_variable cv;
+        bool holdDraw = false;
+        bool drawEntered = false;
+        bool drawReleased = false;
+        bool hostReturned = false;
+        std::vector<int> events;
+        std::vector<GSPresentationRequest> requests;
+        uint32_t drawCount = 0u;
+        uint32_t finishCount = 0u;
+        uint32_t captures = 0u;
+        std::thread::id owner;
+        std::thread::id captureOwner;
+
+        template<class Predicate>
+        bool wait(Predicate predicate)
+        {
+            std::unique_lock<std::mutex> lock(mutex);
+            // GOW-Port: limite anti-deadlock del control negativo, no una espera para medir asincronia.
+            return cv.wait_for(lock, std::chrono::seconds(5), predicate);
+        }
+        void release()
+        {
+            { std::lock_guard<std::mutex> lock(mutex); drawReleased = true; }
+            cv.notify_all();
+        }
+    };
+
+    class ProceduralBackend final : public GSRasterBackend
+    {
+        Recording &r;
+        bool shared;
+    public:
+        ProceduralBackend(Recording &recording, bool isShared) : r(recording), shared(isShared) {}
+        bool UsesSharedPresentation() const override { return shared; }
+        void Initialize(uint8_t *, uint32_t) override { r.owner = std::this_thread::get_id(); }
+        void Reset() override {}
+        void Submit(const GSPrimitiveBatch &) override
+        {
+            std::unique_lock<std::mutex> lock(r.mutex);
+            if (r.holdDraw)
+            {
+                r.drawEntered = true;
+                r.cv.notify_all();
+                r.cv.wait(lock, [&] { return r.drawReleased; });
+            }
+            ++r.drawCount;
+            r.events.push_back(Draw);
+        }
+        void LoadClut(const GSTex0Reg &, const GSTexClutReg &) override {}
+        void BeginTransfer(const GSTransferCommand &) override {}
+        void UploadImage(const uint8_t *, uint32_t) override {}
+        void Flush() override { std::lock_guard<std::mutex> lock(r.mutex); r.events.push_back(::Flush); }
+        void TextureFlush() override {}
+        void Sync(GSSyncReason reason) override
+        {
+            if (reason == GSSyncReason::Finish)
+            {
+                std::lock_guard<std::mutex> lock(r.mutex);
+                ++r.finishCount;
+                r.events.push_back(Finish);
+            }
+        }
+        PresentationFrame Present(const GSPresentationRequest &request) override
+        {
+            std::lock_guard<std::mutex> lock(r.mutex);
+            r.requests.push_back(request);
+            if (request.forceReadback)
+            {
+                r.events.push_back(Capture);
+                ++r.captures;
+                r.captureOwner = std::this_thread::get_id();
+            }
+            else r.events.push_back(::Present);
+            if ((shared && !request.forceReadback) || (request.pmode & 3u) == 0u)
+                return {};
+            PresentationFrame frame;
+            frame.width = 64u;
+            frame.height = 2u;
+            frame.displayFbp = static_cast<uint32_t>(request.dispfb1 & 0x1ffu);
+            frame.usedPreferred = request.hasPreferredSource;
+            frame.sourceFbp = request.hasPreferredSource ? request.preferredSource.fbp : frame.displayFbp;
+            frame.pixels.resize(640u * frame.height * 4u, 0xeeu);
+            const uint32_t color = 0x80302000u | (frame.displayFbp & 0xffu);
+            for (uint32_t y = 0u; y < frame.height; ++y)
+                for (uint32_t x = 0u; x < frame.width; ++x)
+                {
+                    const uint32_t value = color + (y << 8u) + x;
+                    std::memcpy(frame.pixels.data() + (y * 640u + x) * 4u, &value, 4u);
+                }
+            return frame;
+        }
+        bool ClearFramebuffer(const GSContext &, uint32_t) override { return false; }
+        uint32_t ConsumeLocalToHostBytes(uint8_t *, uint32_t) override { return 0u; }
+        uint32_t ReadVram(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) const override
+        {
+            std::lock_guard<std::mutex> lock(r.mutex);
+            r.events.push_back(Read);
+            return (r.finishCount << 16u) | r.drawCount;
+        }
+        void WriteVram(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) override {}
+        void SnapshotVram(std::vector<uint8_t> &out) const override { out.clear(); }
+        GSTransferSnapshot GetTransferSnapshot() const override { return {}; }
+    };
+
+    struct Fixture
+    {
+        Recording recording;
+        std::vector<uint8_t> vram = std::vector<uint8_t>(GSSwizzle::kMemorySize);
+        GSRegisters registers{};
+        GS gs;
+        GSThreadedBackend *threaded = nullptr;
+        explicit Fixture(bool shared = true)
+        {
+            registers.pmode = 1u;
+            registers.dispfb1 = 12u;
+            registers.vsyncTick.store(31u);
+            gs.init(vram.data(), static_cast<uint32_t>(vram.size()), &registers);
+            auto backend = std::make_unique<GSThreadedBackend>(std::make_unique<ProceduralBackend>(recording, shared));
+            threaded = backend.get();
+            gs.setRasterBackend(std::move(backend));
+            recording.events.clear();
+        }
+        ~Fixture() { recording.release(); }
+        void point()
+        {
+            gs.writeRegister(GS_REG_PRIM, GS_PRIM_POINT);
+            gs.writeRegister(GS_REG_RGBAQ, 0x3f80000080403020ull);
+            gs.writeRegister(GS_REG_XYZ2, 0x00100010u);
+        }
+    };
+}
+
+void runGsSharedQueueTests()
+{
+    MiniTest::Case("GS shared presentation queue", [](TestCase &t)
+    {
+        t.Run("shared frontend returns before held draw and preserves FIFO requests", [](TestCase &t)
+        {
+            Fixture f;
+            f.recording.holdDraw = true;
+            f.point();
+            std::thread host([&]
+            {
+                f.gs.latchHostPresentationFrame();
+                { std::lock_guard<std::mutex> lock(f.recording.mutex); f.recording.hostReturned = true; }
+                f.recording.cv.notify_all();
+            });
+            const bool entered = f.recording.wait([&] { return f.recording.drawEntered; });
+            const bool returnedWhileHeld = f.recording.wait([&] { return f.recording.hostReturned; });
+            if (returnedWhileHeld)
+            {
+                f.registers.dispfb1 = 19u;
+                f.registers.vsyncTick.store(32u);
+                f.gs.latchHostPresentationFrame();
+            }
+            f.recording.release();
+            host.join();
+            f.threaded->ReadVram(0u, 0u, 1u, 0u, 0u);
+            t.IsTrue(entered, "El worker se detuvo dentro del dibujo real encolado por GS");
+            t.IsTrue(returnedWhileHeld, "El latch retorna sin liberar al worker");
+            t.IsTrue(f.recording.events == std::vector<int>({Draw, Present, Present, Read}),
+                     "Draw y requests anteriores conservan FIFO sin Flush del host");
+            t.Equals(f.recording.captures, 0u, "Presentacion normal no descarga pixeles");
+            t.Equals(f.recording.requests.size(), size_t(2u), "Ambas presentaciones llegaron al worker");
+            if (f.recording.requests.size() == 2u)
+            {
+                t.Equals(f.recording.requests[0].dispfb1, 12ull, "Primer request copiado al encolar");
+                t.Equals(f.recording.requests[0].vsyncTick, 31ull, "Primer tick no recibe el posterior");
+                t.Equals(f.recording.requests[1].dispfb1, 19ull, "Segundo CRTC mantiene su orden");
+                t.Equals(f.recording.requests[1].vsyncTick, 32ull, "Segundo tick pertenece a su request");
+            }
+        });
+
+        t.Run("shared diagnostics read on worker with latched CRTC and cache generation", [](TestCase &t)
+        {
+            Fixture f;
+            std::vector<uint8_t> pixels;
+            uint32_t width = 0u, height = 0u, display = 0u, source = 0u;
+            bool preferred = true;
+            t.IsFalse(f.gs.copyLatchedHostPresentationFrame(pixels, width, height),
+                      "Sin latch anterior no se inventa un request para capturar");
+            t.Equals(f.recording.captures, 0u, "Sin latch no se consulta al worker");
+            f.gs.latchHostPresentationFrame();
+            f.registers.dispfb1 = 25u;
+            f.registers.vsyncTick.store(41u);
+            t.IsTrue(f.gs.copyLatchedHostPresentationFrame(pixels, width, height, &display, &source, &preferred),
+                     "La captura explicita conserva la API de copia en modo shared");
+            t.Equals(width, 64u, "Ancho del compositor capturado");
+            t.Equals(height, 2u, "Alto del compositor capturado");
+            t.Equals(display, 12u, "La captura usa el CRTC latched, no los registros posteriores");
+            t.Equals(source, 12u, "Fuente devuelta por el compositor");
+            t.IsFalse(preferred, "No se inventa preferredSource");
+            t.Equals(pixels.size(), size_t(64u * 2u * 4u), "Filas de 640 compactadas sin padding");
+            if (pixels.size() == 64u * 2u * 4u)
+            {
+                uint32_t first = 0u, secondRow = 0u;
+                std::memcpy(&first, pixels.data(), 4u);
+                std::memcpy(&secondRow, pixels.data() + 64u * 4u, 4u);
+                t.Equals(first, 0x8030200cu, "Contenido real de la captura");
+                t.Equals(secondRow, 0x8030210cu, "La segunda fila no toma el padding");
+            }
+            t.IsTrue(f.recording.captureOwner == f.recording.owner, "Lectura en el mismo hilo propietario");
+            t.IsFalse(f.recording.captureOwner == std::this_thread::get_id(), "Nunca descarga desde EE/host");
+            t.Equals(f.recording.captures, 1u, "Una descarga explicita");
+            f.gs.copyLatchedHostPresentationFrame(pixels, width, height);
+            t.Equals(f.recording.captures, 1u, "Repetir la copia no repite el readback del mismo latch");
+            f.gs.latchHostPresentationFrame();
+            f.gs.copyLatchedHostPresentationFrame(pixels, width, height, &display);
+            t.Equals(f.recording.captures, 2u, "Un nuevo latch invalida la captura anterior");
+            t.Equals(display, 25u, "La nueva captura incorpora el CRTC del nuevo latch");
+            f.registers.pmode = 0u;
+            f.gs.latchHostPresentationFrame();
+            t.IsFalse(f.gs.copyLatchedHostPresentationFrame(pixels, width, height, &display, &source, &preferred),
+                      "PMODE deshabilitado no conserva una captura vieja");
+            t.IsTrue(pixels.empty() && width == 0u && height == 0u && display == 0u && source == 0u && !preferred,
+                     "La captura vacia limpia todos sus outputs");
+        });
+
+        t.Run("shared FINISH and reads retain barriers after held draws", [](TestCase &t)
+        {
+            Fixture f;
+            f.recording.holdDraw = true;
+            f.point();
+            // GOW-Port: también el control negativo de Flush debe cerrar sin deadlock.
+            std::thread presenter([&]
+            {
+                f.gs.latchHostPresentationFrame();
+                { std::lock_guard<std::mutex> lock(f.recording.mutex); f.recording.hostReturned = true; }
+                f.recording.cv.notify_all();
+            });
+            const bool latched = f.recording.wait([&] { return f.recording.hostReturned; });
+            if (!latched)
+            {
+                f.recording.release();
+                presenter.join();
+                t.Fail("El latch bloqueó antes del control de FINISH");
+                return;
+            }
+            presenter.join();
+            { std::lock_guard<std::mutex> lock(f.recording.mutex); f.recording.hostReturned = false; }
+            const bool entered = f.recording.wait([&] { return f.recording.drawEntered; });
+            uint32_t result = 0u;
+            uint32_t observedAfterFinish = 0u;
+            std::thread reader([&]
+            {
+                f.threaded->Sync(GSSyncReason::Finish);
+                {
+                    std::lock_guard<std::mutex> lock(f.recording.mutex);
+                    observedAfterFinish = (f.recording.finishCount << 16u) | f.recording.drawCount;
+                    f.recording.hostReturned = true;
+                }
+                f.recording.cv.notify_all();
+                result = f.gs.ReadVram(0u, 0u, 1u, 0u, 0u);
+            });
+            // GOW-Port: si FINISH retorna antes de soltar el draw, el estado observado sera cero.
+            // En la ruta correcta el limite del control libera el worker para que la prueba cierre.
+            const bool returnedWhileHeld = f.recording.wait([&] { return f.recording.hostReturned; });
+            f.recording.release();
+            reader.join();
+            t.IsTrue(entered, "El dibujo anterior estaba detenido");
+            t.IsFalse(returnedWhileHeld, "FINISH no retorna con el dibujo anterior detenido");
+            t.Equals(observedAfterFinish, 0x00010001u, "Al retornar FINISH sus efectos ya son visibles");
+            t.Equals(result, 0x00010001u, "Lectura solo retorna despues del dibujo y FINISH");
+            t.IsTrue(f.recording.events == std::vector<int>({Draw, Present, Finish, Read}),
+                     "FINISH conserva la barrera y orden en la misma cola compartida");
+        });
+
+        t.Run("nonshared frontend retains synchronous pixel path", [](TestCase &t)
+        {
+            Fixture f(false);
+            f.point();
+            f.gs.latchHostPresentationFrame();
+            std::vector<uint8_t> pixels;
+            uint32_t width = 0u, height = 0u, display = 0u;
+            t.IsFalse(f.gs.usesSharedPresentation(), "La instancia CPU no toma sharing de otro backend");
+            t.IsTrue(f.gs.copyLatchedHostPresentationFrame(pixels, width, height, &display),
+                     "El latch sin sharing conserva pixeles disponibles al retornar");
+            t.Equals(display, 12u, "Metadata normal del backend");
+            t.Equals(f.recording.captures, 0u, "No fuerza otra presentacion para copiar pixeles CPU");
+            t.IsTrue(f.recording.events == std::vector<int>({Draw, Flush, Present}),
+                     "CPU conserva Flush y composicion sincrona");
+        });
+
+        t.Run("shared acquired metadata belongs to displayed frame not next request", [](TestCase &t)
+        {
+            Fixture f;
+            f.gs.setDebugHistoryPaused(false);
+            f.gs.latchHostPresentationFrame();
+            GSSharedPresent::Frame shared;
+            shared.sequence = 8u;
+            shared.vsyncTick = 28u;
+            shared.width = 64u;
+            shared.height = 96u;
+            shared.displayFbp = 17u;
+            shared.sourceFbp = 29u;
+            shared.usedPreferred = true;
+            f.gs.recordAcquiredSharedFrame(shared);
+            f.registers.dispfb1 = 31u;
+            f.gs.latchHostPresentationFrame();
+            f.gs.recordAcquiredSharedFrame(shared);
+            const auto snapshot = f.gs.getDebugSnapshot();
+            t.Equals(snapshot.hostPresentationDisplayFbp, 17u, "Se muestran metadatos del frame retenido");
+            t.Equals(snapshot.hostPresentationSourceFbp, 29u, "Fuente correcta del compositor adquirido");
+            t.IsTrue(snapshot.hostPresentationUsedPreferred, "Preferred del frame adquirido");
+            t.IsTrue(snapshot.hasHostPresentationFrame, "Shared tiene frame aunque no haya pixeles RAM");
+            const auto history = f.gs.getDebugHistory();
+            uint32_t presents = 0u;
+            for (const auto &event : history)
+                if (event.kind == GSDebugEventKind::Present)
+                {
+                    ++presents;
+                    t.Equals(event.displayFbp, 17u, "Evento del frame adquirido");
+                    t.Equals(event.sourceFbp, 29u, "Evento conserva fuente adquirida");
+                    t.Equals(event.vsyncTick, 28ull, "Tick del frame adquirido, no del request posterior");
+                }
+            t.Equals(presents, 1u, "Repetir slot no duplica eventos de presentacion");
+            shared.sequence = 9u;
+            shared.blank = true;
+            f.gs.recordAcquiredSharedFrame(shared);
+            const auto blank = f.gs.getDebugSnapshot();
+            t.IsFalse(blank.hasHostPresentationFrame, "Blank invalida estado de display previo");
+            t.Equals(blank.hostPresentationWidth, 0u, "Blank equivale a frame RAM vacio");
+            t.Equals(blank.hostPresentationDisplayFbp, 0u, "Blank limpia metadata previa");
+        });
+    });
+}
diff --git a/ps2xTest/src/ps2_gs_tests.cpp b/ps2xTest/src/ps2_gs_tests.cpp
index 0458a8c..c4192c1 100644
--- a/ps2xTest/src/ps2_gs_tests.cpp
+++ b/ps2xTest/src/ps2_gs_tests.cpp
@@ -1002,7 +1002,8 @@ void register_ps2_gs_tests()
             gs.writeRegister(GS_REG_UV, kUvRow1);
             gs.writeRegister(GS_REG_XYZ2, 0ull);
