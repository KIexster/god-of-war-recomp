+    std::string sanitizeForLog(const std::string &value)
+    {
+        std::string out;
+        out.reserve(value.size());
+        for (unsigned char ch : value)
+        {
+            if (ch == '\n' || ch == '\r' || ch == '\t' || (ch >= 0x20 && ch < 0x7F))
+            {
+                out.push_back(static_cast<char>(ch));
+            }
+            else
+            {
+                out.push_back('.');
+            }
+        }
+        return out;
+    }
