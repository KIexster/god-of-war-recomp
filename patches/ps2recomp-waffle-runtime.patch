-void PS2Runtime::freeGuestBlockLocked(uint32_t guestAddr)
-{
-    const int32_t index = findGuestHeapBlockIndexLocked(guestAddr);
-    if (index < 0)
-    {
-        return;
-    }
-
-    m_guestHeapBlocks[static_cast<size_t>(index)].free = true;
-    coalesceGuestHeapLocked();
-}
