+    std::string normalizePathSeparators(std::string value)
+    {
+        std::replace(value.begin(), value.end(), '\\', '/');
+        return value;
+    }
+
+    void trimLeadingSeparators(std::string &value)
+    {
+        while (!value.empty() && (value.front() == '/' || value.front() == '\\'))
+        {
+            value.erase(value.begin());
+        }
+    }
