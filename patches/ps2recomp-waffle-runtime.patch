+                break;
+            case 0x26:
+                write(rd, cpu.gpr[rs] ^ cpu.gpr[rt]);
+                break;
+            case 0x27:
+                write(rd, ~(cpu.gpr[rs] | cpu.gpr[rt]));
+                break;
+            case 0x2A:
+                write(rd, static_cast<int32_t>(cpu.gpr[rs]) < static_cast<int32_t>(cpu.gpr[rt]) ? 1u : 0u);
+                break;
+            case 0x2B:
+                write(rd, cpu.gpr[rs] < cpu.gpr[rt] ? 1u : 0u);
+                break;
