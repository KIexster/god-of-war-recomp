+        case GS_PSM_CT24:
+            a = (texa.aem && rgbZero) ? 0u : texa.ta0;
+            break;
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+            if ((a & 0x80u) != 0u)
