+            return std::min(std::max(coordinate, static_cast<int>(regionMin)), static_cast<int>(regionMax));
+        case 3:
+            return static_cast<int>((static_cast<uint32_t>(coordinate) & static_cast<uint32_t>(regionMin)) | static_cast<uint32_t>(regionMax));
+        default:
+            return coordinate;
+        }
+    }
+
+    inline bool passesAlphaTest(uint64_t testReg, uint8_t alpha)
+    {
+        if ((testReg & 0x1u) == 0u)
+            return true;
+
+        const uint8_t atst = static_cast<uint8_t>((testReg >> 1) & 0x7u);
+        const uint8_t aref = static_cast<uint8_t>((testReg >> 4) & 0xFFu);
+
+        switch (atst)
+        {
+        case 0:
+            return false;
+        case 1:
+            return true;
+        case 2:
+            return alpha < aref;
+        case 3:
+            return alpha <= aref;
+        case 4:
+            return alpha == aref;
+        case 5:
+            return alpha >= aref;
+        case 6:
+            return alpha > aref;
+        case 7:
+            return alpha != aref;
+        default:
+            return true;
+        }
+    }
+
+    struct PixelWriteMask
+    {
+        bool writeRgb = true;
+        bool writeAlpha = true;
+        bool writeDepth = true;
+
+        bool writesFramebuffer() const
+        {
+            return writeRgb || writeAlpha;
+        }
+
+        bool writesAnything() const
+        {
+            return writesFramebuffer() || writeDepth;
+        }
+    };
+
+    inline PixelWriteMask classifyAlphaTest(uint64_t testReg, uint8_t alpha, uint8_t framePsm)
+    {
+        const bool pass = passesAlphaTest(testReg, alpha);
+        if (pass)
+            return {};
+
+        switch (static_cast<uint8_t>((testReg >> 12) & 0x3u))
+        {
+        case 1:
+            return {true, true, false};
+        case 2:
+            return {false, false, true};
+        case 3:
+            if (framePsm == GS_PSM_CT32)
+                return {true, false, false};
+            return {true, true, false};
+        case 0:
+        default:
+            return {false, false, false};
+        }
+    }
+
+    inline bool passesDestinationAlphaTest(uint64_t testReg, uint8_t framePsm, uint32_t rawFramebufferPixel)
+    {
+        const bool date = ((testReg >> 14) & 0x1u) != 0u;
+        if (!date)
+            return true;
+
+        const bool datm = ((testReg >> 15) & 0x1u) != 0u;
+        switch (framePsm)
+        {
+        case GS_PSM_CT32:
+            return (((rawFramebufferPixel >> 31) & 0x1u) != 0u) == datm;
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+            return (((rawFramebufferPixel >> 15) & 0x1u) != 0u) == datm;
+        case GS_PSM_CT24:
+            return true;
+        default:
+            return true;
+        }
+    }
+
+    struct TextureCombineResult
+    {
+        uint8_t r;
+        uint8_t g;
+        uint8_t b;
+        uint8_t a;
+    };
+
+    inline TextureCombineResult combineTexture(const GSTex0Reg &tex,
+                                        uint8_t vr,
+                                        uint8_t vg,
+                                        uint8_t vb,
+                                        uint8_t va,
+                                        uint8_t tr,
+                                        uint8_t tg,
+                                        uint8_t tb,
+                                        uint8_t ta)
+    {
+        const bool textureHasAlpha = tex.tcc != 0u;
+        TextureCombineResult out{tr, tg, tb, textureHasAlpha ? ta : va};
+
+        switch (tex.tfx)
+        {
+        case 0:
+            out.r = clampU8((tr * vr) >> 7);
+            out.g = clampU8((tg * vg) >> 7);
+            out.b = clampU8((tb * vb) >> 7);
+            out.a = textureHasAlpha ? clampU8((ta * va) >> 7) : va;
+            break;
+        case 1:
+            out.r = tr;
+            out.g = tg;
+            out.b = tb;
+            out.a = textureHasAlpha ? ta : va;
+            break;
+        case 2:
+            out.r = clampU8(((tr * vr) >> 7) + va);
+            out.g = clampU8(((tg * vg) >> 7) + va);
+            out.b = clampU8(((tb * vb) >> 7) + va);
+            out.a = textureHasAlpha ? clampU8(ta + va) : va;
+            break;
+        case 3:
+            out.r = clampU8(((tr * vr) >> 7) + va);
+            out.g = clampU8(((tg * vg) >> 7) + va);
+            out.b = clampU8(((tb * vb) >> 7) + va);
+            out.a = textureHasAlpha ? ta : va;
+            break;
+        default:
+            out.r = tr;
+            out.g = tg;
+            out.b = tb;
+            out.a = textureHasAlpha ? ta : va;
+            break;
+        }
+
+        return out;
+    }
+
+    inline uint32_t swizzleClutIndexCSM1(uint32_t index)
+    {
+        return (index & ~0x18u) | ((index & 0x08u) << 1u) | ((index & 0x10u) >> 1u);
+    }
+
+    inline bool isFourBitIndexedPsm(uint8_t psm)
+    {
+        return psm == GS_PSM_T4 || psm == GS_PSM_T4HL || psm == GS_PSM_T4HH;
+    }
+
+    inline bool isEightBitIndexedPsm(uint8_t psm)
+    {
+        return psm == GS_PSM_T8 || psm == GS_PSM_T8H;
+    }
+
+    inline uint8_t lerpChannel(uint8_t c00, uint8_t c10, uint8_t c01, uint8_t c11, float fx, float fy)
+    {
+        const float top = static_cast<float>(c00) + (static_cast<float>(c10) - static_cast<float>(c00)) * fx;
+        const float bottom = static_cast<float>(c01) + (static_cast<float>(c11) - static_cast<float>(c01)) * fx;
+        return clampU8(static_cast<int>(std::lround(top + (bottom - top) * fy)));
+    }
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_gpu_profile.h b/ps2xRuntime/src/lib/gs/gs_gpu_profile.h
new file mode 100644
index 0000000..e508ef7
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_gpu_profile.h
@@ -0,0 +1,114 @@
+// GOW-Port: recolector propio de timestamps OpenGL, sin dependencias del driver.
+// Inspiración: nathanialf/ico-pc, rd_perf.c @ 46de16d393b817290e1bbf5de63a6de10cf9575c.
+// No se copia código de ICO. Las ventanas conservan contadores y muestras juntos.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <utility>
+#include <vector>
+
+namespace GSGpuProfile
+{
+    constexpr size_t kMaxSamplesPerWindow = 4096u;
+    constexpr size_t kMaxWaitingWindows = 3u;
+    constexpr uint64_t kFramesPerWindow = 4u;
+
+    struct Pending
+    {
+        uint32_t kind;
+        uint32_t begin;
+        uint32_t end;
+        std::array<uint32_t, 8> info;
+    };
+
+    struct Window
+    {
+        std::vector<Pending> pending;
+        std::vector<std::pair<uint64_t, std::array<uint32_t, 8>>> rasterTimes;
+        std::array<uint64_t, 8> ns{};
+        std::array<uint64_t, 8> count{};
+        uint64_t pairs = 0u;
+        uint64_t tiles = 0u;
+        uint64_t maxBin = 0u;
+        uint64_t sumMaxBin = 0u;
+        uint64_t prims = 0u;
+        uint64_t frames = 0u;
+        uint64_t skippedQueries = 0u;
+        std::array<uint64_t, 6> reasons{};
+        std::array<uint64_t, 3> uploadHazards{};
+    };
+
+    class Queue : public Window
+    {
+    public:
+        bool enabled = false;
+        std::vector<uint32_t> freeQueries;
+        std::array<uint32_t, 8> nextInfo{};
+
+        // GOW-Port: bajo presión se deja de medir, sin detener el render.
+        bool sampleAllowed()
+        {
+            if (pending.size() < kMaxSamplesPerWindow)
+                return true;
+            ++skippedQueries;
+            return false;
+        }
+
+        void endFrame()
+        {
+            ++frames;
+            if (frames >= kFramesPerWindow && waiting.size() < kMaxWaitingWindows)
+                seal();
+        }
+
+        size_t waitingWindows() const { return waiting.size(); }
+
+        // GOW-Port: solo el cierre permite recoger resultados todavía pendientes.
+        void finish()
+        {
+            if (frames != 0u || !pending.empty() || skippedQueries != 0u ||
+                prims != 0u || pairs != 0u || tiles != 0u || maxBin != 0u || sumMaxBin != 0u ||
+                reasons != std::array<uint64_t, 6>{} || uploadHazards != std::array<uint64_t, 3>{})
+                seal();
+        }
+
+        template <class Available, class Read, class Report>
+        void collect(Available available, Read read, Report report, bool wait = false)
+        {
+            while (!waiting.empty())
+            {
+                Window &window = waiting.front();
+                // GOW-Port: todos son TIMESTAMP del mismo contexto. OpenGL garantiza
+                // que el último disponible implica los anteriores disponibles.
+                if (!wait && !window.pending.empty() && !available(window.pending.back().end))
+                    break;
+                for (const Pending &item : window.pending)
+                {
+                    const uint64_t begin = read(item.begin);
+                    const uint64_t end = read(item.end);
+                    window.ns[item.kind] += end - begin;
+                    ++window.count[item.kind];
+                    if (item.kind == 0u)
+                        window.rasterTimes.push_back({end - begin, item.info});
+                    freeQueries.push_back(item.begin);
+                    freeQueries.push_back(item.end);
+                }
+                window.pending.clear();
+                report(window);
+                waiting.pop_front();
+            }
+        }
+
+    private:
+        std::deque<Window> waiting;
+
+        void seal()
+        {
+            waiting.emplace_back(std::move(static_cast<Window &>(*this)));
+            static_cast<Window &>(*this) = Window{};
+        }
+    };
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_gpu_upload_ring.h b/ps2xRuntime/src/lib/gs/gs_gpu_upload_ring.h
new file mode 100644
index 0000000..01614b6
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_gpu_upload_ring.h
@@ -0,0 +1,97 @@
+// GOW-Port: uploads persistentes protegidos por fences, sin dependencia de OpenGL.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+namespace GSGpuUpload
+{
+    enum WaitResult { Signaled, Timeout, Failed };
+    enum class Failure { None, NullFence, Timeout, WaitFailed };
+
+    template <class Fence, size_t ChunkBytes, size_t ChunkCount, size_t Alignment>
+    class Ring
+    {
+        static_assert(ChunkBytes >= 16u && ChunkCount != 0u);
+        static_assert(Alignment != 0u && (Alignment & (Alignment - 1u)) == 0u);
+        static_assert(ChunkBytes % Alignment == 0u);
+        static_assert(ChunkBytes <= (std::numeric_limits<size_t>::max)() / ChunkCount);
+
+    public:
+        void setStorage(uint8_t *mapped) { storage = mapped; }
+        bool available() const { return storage != nullptr && !disabled(); }
+        bool disabled() const { return failed != Failure::None; }
+        Failure failure() const { return failed; }
+
+        // GOW-Port: el callback de espera debe representar la espera acotada completa.
+        // Timeout/Failed impiden todos los uploads posteriores, incluso en otro chunk.
+        template <class CreateFence, class WaitFence, class DeleteFence>
+        size_t put(const void *data, size_t payloadBytes, CreateFence createFence,
+                   WaitFence waitFence, DeleteFence deleteFence)
+        {
+            if (!available() || payloadBytes > ChunkBytes)
+                return SIZE_MAX;
+            const size_t bytes = payloadBytes < 16u ? 16u : payloadBytes;
+            const size_t padding = (Alignment - offset % Alignment) % Alignment;
+            size_t aligned = offset + padding; // ChunkBytes también está alineado.
+            if (bytes > ChunkBytes - aligned)
+            {
+                const Fence submitted = createFence();
+                if (submitted == Fence{})
+                {
+                    failed = Failure::NullFence;
+                    return SIZE_MAX;
+                }
+                fences[chunk] = submitted;
+                const size_t next = (chunk + 1u) % ChunkCount;
+                if (fences[next] != Fence{})
+                {
+                    const WaitResult result = waitFence(fences[next]);
+                    if (result != WaitResult::Signaled)
+                    {
+                        failed = result == WaitResult::Timeout ? Failure::Timeout : Failure::WaitFailed;
+                        // GOW-Port: conservar ambos fences para el cierre; no copiar ni avanzar.
+                        return SIZE_MAX;
+                    }
+                    const Fence complete = fences[next];
+                    fences[next] = Fence{};
+                    deleteFence(complete);
+                }
+                chunk = next;
+                aligned = 0u;
+            }
+            const size_t result = chunk * ChunkBytes + aligned;
+            if (data != nullptr)
+            {
+                std::memcpy(storage + result, data, payloadBytes);
+                if (payloadBytes < bytes)
+                    std::memset(storage + result + payloadBytes, 0, bytes - payloadBytes);
+            }
+            offset = aligned + bytes;
+            return result;
+        }
+
+        // GOW-Port: el propietario llama durante el cierre, antes de desmontar el contexto.
+        template <class DeleteFence>
+        void releaseFences(DeleteFence deleteFence)
+        {
+            for (Fence &fence : fences)
+                if (fence != Fence{})
+                {
+                    const Fence owned = fence;
+                    fence = Fence{};
+                    deleteFence(owned);
+                }
+        }
+
+    private:
+        uint8_t *storage = nullptr;
+        std::array<Fence, ChunkCount> fences{};
+        size_t chunk = 0u;
+        size_t offset = 0u;
+        Failure failed = Failure::None;
+    };
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_host_present.cpp b/ps2xRuntime/src/lib/gs/gs_host_present.cpp
new file mode 100644
index 0000000..4ffe16b
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_host_present.cpp
@@ -0,0 +1,373 @@
+// GOW-Port: contexto host, selección de frames y dibujo raylib usados por el port.
+#include "runtime/gs/gs_host_present.h"
+#include "rlgl.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/ps2_perf.h"
+#include "ps2_log.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+
+namespace
+{
+    constexpr uint32_t kWidth = 640u;
+    constexpr uint32_t kHeight = 512u;
+    constexpr uint32_t kDisplayHeight = 448u;
+}
+
+
+namespace
+{
+    // GOW-Port: output scaler. The GS renders at its native resolution (512x448); this pass maps that image onto the window
+    // at the window's resolution with a 5-tap Catmull-Rom bicubic (GOW_SCALER=sharp, default) instead of the plain
+    // bilinear stretch (GOW_SCALER=bilinear), then applies a light contrast-adaptive sharpen. It does not add detail
+    // (that needs a scaled GS render target); it removes the blur of the stretch.
+    const char *kScalerFragment = R"GLSL(
+#version 330
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec2 srcSize;
+uniform float sharpen;
+uniform float plain;
+out vec4 finalColor;
+
+vec4 tex(vec2 uv) { return texture(texture0, uv); }
+
+void main()
+{
+    if (plain > 0.5)
+    {
+        // frame at least as large as its window rectangle: one bilinear tap, no bicubic / sharpen
+        finalColor = vec4(texture(texture0, fragTexCoord).rgb, 1.0);
+        return;
+    }
+    vec2 pos = fragTexCoord * srcSize;
+    vec2 center = floor(pos - 0.5) + 0.5;
+    vec2 f = pos - center;
+    vec2 f2 = f * f, f3 = f2 * f;
+    vec2 w0 = -0.5 * f3 + f2 - 0.5 * f;
+    vec2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
+    vec2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
+    vec2 w3 = 0.5 * f3 - 0.5 * f2;
+    vec2 w12 = w1 + w2;
+    vec2 offset12 = w2 / w12;
+    vec2 tc0 = (center - 1.0) / srcSize;
+    vec2 tc3 = (center + 2.0) / srcSize;
+    vec2 tc12 = (center + offset12) / srcSize;
+    vec4 c = tex(vec2(tc12.x, tc0.y)) * (w12.x * w0.y)
+           + tex(vec2(tc0.x, tc12.y)) * (w0.x * w12.y)
+           + tex(vec2(tc12.x, tc12.y)) * (w12.x * w12.y)
+           + tex(vec2(tc3.x, tc12.y)) * (w3.x * w12.y)
+           + tex(vec2(tc12.x, tc3.y)) * (w12.x * w3.y);
+    float norm = (w12.x * w0.y) + (w0.x * w12.y) + (w12.x * w12.y) + (w3.x * w12.y) + (w12.x * w3.y);
+    c /= norm;
+    // contrast-adaptive sharpen from the four direct neighbours of the nearest source texel
+    vec2 px = 1.0 / srcSize;
+    vec3 n = tex(fragTexCoord + vec2(0.0, -px.y)).rgb, s = tex(fragTexCoord + vec2(0.0, px.y)).rgb;
+    vec3 e = tex(fragTexCoord + vec2(px.x, 0.0)).rgb, w = tex(fragTexCoord + vec2(-px.x, 0.0)).rgb;
+    vec3 lo = min(min(n, s), min(e, w)), hi = max(max(n, s), max(e, w));
+    vec3 amp = clamp(min(lo, 1.0 - hi) / max(hi, vec3(0.0001)), 0.0, 1.0);
+    float peak = -1.0 / mix(8.0, 5.0, sharpen);
+    vec3 wgt = sqrt(amp) * peak;
+    vec3 sharp = (c.rgb + (n + s + e + w) * wgt) / (1.0 + 4.0 * wgt);
+    finalColor = vec4(clamp(sharp, 0.0, 1.0), 1.0);
+}
+)GLSL";
+
+    Shader g_scaler{};
+    int g_scalerSrcSize = -1, g_scalerSharpen = -1, g_scalerPlain = -1;
+    bool g_scalerTried = false;
+
+    bool scalerEnabled()
+    {
+        static const bool on = [] { const char *v = std::getenv("GOW_SCALER"); return !(v && std::strcmp(v, "bilinear") == 0); }();
+        return on;
+    }
+
+    Shader *scalerShader()
+    {
+        if (!g_scalerTried)
+        {
+            g_scalerTried = true;
+            if (scalerEnabled())
+            {
+                g_scaler = LoadShaderFromMemory(nullptr, kScalerFragment);
+                if (g_scaler.id != 0u && g_scaler.id != rlGetShaderIdDefault())
+                {
+                    g_scalerSrcSize = GetShaderLocation(g_scaler, "srcSize");
+                    g_scalerSharpen = GetShaderLocation(g_scaler, "sharpen");
+                    g_scalerPlain = GetShaderLocation(g_scaler, "plain");
+                }
+                else
+                {
+                    std::fprintf(stderr, "[gs-present] scaler shader failed, using bilinear\n");
+                    g_scaler = {};
+                }
+            }
+        }
+        return g_scaler.id != 0u ? &g_scaler : nullptr;
+    }
+}
+
+void GSHostPresentation::captureHostContext()
+{
+    if (started)
+        return;
+    started = true;
+    const char *setting = std::getenv("PS2X_GS_DIRECT_PRESENT");
+    // GOW-Port: shared GL textures (no readback/upload) by default; PS2X_GS_DIRECT_PRESENT=0 forces RAM frames.
+    captureRequested = !(setting && *setting == '0');
+    if (captureRequested)
+        GSSharedPresent::CaptureHostContext();
+}
+
+void GSHostPresentation::restoreHostContext()
+{
+    if (captureRequested)
+        GSSharedPresent::RestoreHostContext();
+}
+
+void GSHostPresentation::createFallback()
+{
+    if (fallback.id != 0u)
+        return;
+    Image blank = GenImageColor(kWidth, kHeight, BLANK);
+    fallback = LoadTextureFromImage(blank);
+    UnloadImage(blank);
+    SetTextureFilter(fallback, TEXTURE_FILTER_POINT); // Coincide con la ruta RAM original.
+    upload.resize(static_cast<size_t>(kWidth) * kHeight * 4u, 0u);
+}
+
+void GSHostPresentation::blankFallback()
+{
+    if (!uploadedBlank)
+    {
+        for (size_t offset = 0u; offset < upload.size(); offset += 4u)
+        {
+            upload[offset] = MAGENTA.r;
+            upload[offset + 1u] = MAGENTA.g;
+            upload[offset + 2u] = MAGENTA.b;
+            upload[offset + 3u] = MAGENTA.a;
+        }
+        UpdateTexture(fallback, upload.data());
+        uploadedBlank = true;
+    }
+    current.texture = fallback;
+    current.width = kWidth;
+    current.height = kDisplayHeight;
+    current.borrowed = false;
+    current.blank = true;
+    uploaded = true;
+}
+
+GSHostPresentation::View GSHostPresentation::prepare(GS &gs, uint64_t vsyncTick)
+{
+    createFallback();
+    const bool shared = gs.usesSharedPresentation() && GSSharedPresent::Active();
+    if (!modeKnown || shared != sharedMode)
+    {
+        std::fprintf(stderr, "[gs-present] host mode: %s\n", shared ? "shared texture" : "RAM frames");
+        std::fflush(stderr);
+        modeKnown = true;
+        sharedMode = shared;
+        hasLatched = uploaded = uploadedBlank = false;
+        lastSharedSequence = 0u;
+        current = {};
+    }
+    const bool needsLatch = !hasLatched || vsyncTick != lastTick;
+    if (needsLatch)
+    {
+        gs.latchHostPresentationFrame();
+        lastTick = vsyncTick;
+        hasLatched = true;
+    }
+    current.shared = shared;
+    if (shared)
+    {
+        // GOW-Port: la llamada anterior ya terminó EndDrawing, incluido el batch.
+        // Acquire puede conservar el slot previo; nunca descargar píxeles aquí.
+        GSSharedPresent::Frame frame;
+        if (GSSharedPresent::Acquire(frame))
+        {
+            current.frame = frame;
+            if (frame.sequence != lastSharedSequence)
+            {
+                gs.recordAcquiredSharedFrame(frame);
+                lastSharedSequence = frame.sequence;
+            }
+            if (!frame.blank && frame.texture != 0u && frame.width != 0u && frame.height != 0u)
+            {
+                current.texture = Texture2D{frame.texture, static_cast<int>(frame.width), static_cast<int>(frame.height),
+                                            1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+                current.width = frame.width;
+                current.height = frame.height;
+                current.borrowed = true;
+                current.blank = false;
+                return current;
+            }
+        }
+        blankFallback(); // PMODE apagado conserva el placeholder magenta de RAM.
+        return current;
+    }
+    if (!needsLatch && uploaded)
+        return current;
+
+    scratch.clear();
+    uint32_t width = 0u, height = 0u, displayFbp = 0u, sourceFbp = 0u;
+    bool preferred = false;
+    if (!gs.copyLatchedHostPresentationFrame(scratch, width, height, &displayFbp, &sourceFbp, &preferred))
+    {
+        blankFallback();
+        lastWidth = current.width;
+        lastHeight = current.height;
+        return current;
+    }
+    PS2_IF_AGRESSIVE_LOGS({
+        if (uploadDebugCount < 128u || displayFbp != lastDisplayFbp || sourceFbp != lastSourceFbp ||
+            preferred != lastPreferred || width != lastWidth || height != lastHeight)
+            std::cout << "[frame:upload] idx=" << uploadDebugCount << " tick=" << vsyncTick
+                      << " displayFbp=" << displayFbp << " sourceFbp=" << sourceFbp
+                      << " size=" << width << "x" << height
+                      << " preferred=" << static_cast<uint32_t>(preferred ? 1u : 0u) << std::endl;
+        ++uploadDebugCount;
+    });
+    lastDisplayFbp = displayFbp;
+    lastSourceFbp = sourceFbp;
+    lastPreferred = preferred;
+    lastWidth = width;
+    lastHeight = height;
+    if (width > kWidth || height > kHeight)
+    {
+        // GOW-Port: render-target renderer frames (internal resolution) are uploaded as they are, in a texture of their size.
+        if (width > fallbackWidth || height > fallbackHeight)
+        {
+            UnloadTexture(fallback);
+            fallbackWidth = std::max(fallbackWidth, width);
+            fallbackHeight = std::max(fallbackHeight, height);
+            Image bigBlank = GenImageColor(static_cast<int>(fallbackWidth), static_cast<int>(fallbackHeight), BLANK);
+            fallback = LoadTextureFromImage(bigBlank);
+            UnloadImage(bigBlank);
+            SetTextureFilter(fallback, TEXTURE_FILTER_POINT);
+        }
+        UpdateTextureRec(fallback, Rectangle{0.0f, 0.0f, static_cast<float>(width), static_cast<float>(height)}, scratch.data());
+        uploaded = true;
+        uploadedBlank = false;
+        current.texture = fallback;
+        current.width = width;
+        current.height = height;
+        current.borrowed = current.blank = false;
+        current.frame = {};
+        return current;
+    }
+    std::fill(upload.begin(), upload.end(), 0u);
+    const uint32_t copyWidth = std::min(width, kWidth);
+    const uint32_t copyHeight = std::min(height, kHeight);
+    const size_t sourceRow = static_cast<size_t>(width) * 4u;
+    const size_t destinationRow = static_cast<size_t>(kWidth) * 4u;
+    const size_t copyRow = static_cast<size_t>(copyWidth) * 4u;
+    for (uint32_t y = 0u; y < copyHeight; ++y)
+    {
+        const size_t sourceOffset = static_cast<size_t>(y) * sourceRow;
+        const size_t destinationOffset = static_cast<size_t>(y) * destinationRow;
+        if (sourceOffset + copyRow > scratch.size() || destinationOffset + copyRow > upload.size())
+            break;
+        std::memcpy(upload.data() + destinationOffset, scratch.data() + sourceOffset, copyRow);
+    }
+    UpdateTexture(fallback, upload.data());
+    uploaded = true;
+    uploadedBlank = false;
+    current.texture = fallback;
+    current.width = width;
+    current.height = height;
+    current.borrowed = current.blank = false;
+    current.frame = {};
+    return current;
+}
+
+GSHostPresentation::View GSHostPresentation::renderFrame(GS &gs, uint64_t vsyncTick, const std::function<void()> &overlay)
+{
+    View selected;
+    {
+        ps2_perf::Scope perf(ps2_perf::Bucket::Upload);
+        selected = prepare(gs, vsyncTick);
+    }
+    BeginDrawing();
+    ClearBackground(BLACK);
+    const float sourceWidth = static_cast<float>(std::max<uint32_t>(1u, selected.width));
+    const float sourceHeight = static_cast<float>(std::max<uint32_t>(1u, selected.height));
+    const float screenWidth = static_cast<float>(GetScreenWidth());
+    const float screenHeight = static_cast<float>(GetScreenHeight());
+    // GOW-Port: a PS2 frame (e.g. 512x448) is shown at the TV's aspect, not with square pixels:
+    // always 16:9 (the game renders widescreen, see gow_overrides.cpp; 4:3 is not supported any more).
+    constexpr float displayAspect = 16.0f / 9.0f;
+    const float destinationWidth = std::min(screenWidth, screenHeight * displayAspect);
+    const float destinationHeight = destinationWidth / displayAspect;
+    const Rectangle source{0.0f, 0.0f, sourceWidth, sourceHeight};
+    const Rectangle destination{(screenWidth - destinationWidth) * 0.5f,
+                                (screenHeight - destinationHeight) * 0.5f,
+                                destinationWidth, destinationHeight};
+    // GOW-Port: textura del PBO con filas en orden; no invertir source.height.
+    // The bicubic + sharpen pass only helps when the frame is magnified; a frame at least as large as its window
+    // rectangle (PS2X_GS_HW_SCALE high enough, or a small window) is drawn with one linear tap (same shader, "plain").
+    const bool magnified = sourceWidth < destinationWidth || sourceHeight < destinationHeight;
+    Shader *scaler = scalerShader();
+    if (!scaler)
+        SetTextureFilter(selected.texture, TEXTURE_FILTER_BILINEAR);
+    if (scaler)
+    {
+        const float size[2] = {sourceWidth, sourceHeight};
+        static const float sharpen = [] { const char *v = std::getenv("GOW_SHARPEN"); return v ? static_cast<float>(std::atof(v)) : 0.5f; }();
+        SetShaderValue(*scaler, g_scalerSrcSize, size, SHADER_UNIFORM_VEC2);
+        SetShaderValue(*scaler, g_scalerSharpen, &sharpen, SHADER_UNIFORM_FLOAT);
+        const float plain = magnified ? 0.0f : 1.0f;
+        SetShaderValue(*scaler, g_scalerPlain, &plain, SHADER_UNIFORM_FLOAT);
+        SetTextureFilter(selected.texture, TEXTURE_FILTER_BILINEAR);
+        BeginShaderMode(*scaler);
+    }
+    DrawTexturePro(selected.texture, source, destination, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+    if (scaler)
+        EndShaderMode();
+    if (overlay)
+        overlay();
+    // GOW-Port: GOW_HOST_SHOT=<n>: at host frame n write the window's back buffer (what is about to be shown) to
+    // host_shot.png in the working directory, plus the frame / window sizes, to check presentation without a desktop grab.
+    static const long hostShotAt = [] { const char *v = std::getenv("GOW_HOST_SHOT"); return v ? std::atol(v) : -1L; }();
+    static long hostFrame = 0;
+    if (hostShotAt >= 0 && hostFrame++ == hostShotAt)
+    {
+        rlDrawRenderBatchActive();
+        Image screen = LoadImageFromScreen();
+        ExportImage(screen, "host_shot.png");
+        UnloadImage(screen);
+        std::fprintf(stderr, "[gs-present] host_shot frame=%ux%u tex=%u window=%dx%d shared=%d scaler=%d\n", selected.width, selected.height,
+                     selected.texture.id, GetScreenWidth(), GetScreenHeight(), selected.shared ? 1 : 0, scaler ? 1 : 0);
+    }
+    {
+        ps2_perf::Scope perf(ps2_perf::Bucket::HostWait);
+        EndDrawing();
+    }
+    return selected;
+}
+
+void GSHostPresentation::shutdown(GS &gs)
+{
+    if (!started && fallback.id == 0u)
+        return;
+    // GOW-Port: nullptr instala un backend nulo; drena y destruye el worker/contexto compartido.
+    gs.setRasterBackend(nullptr);
+    restoreHostContext();
+    if (fallback.id != 0u)
+        UnloadTexture(fallback); // Nunca descargar la Texture2D prestada del productor.
+    fallback = {};
+    if (captureRequested)
+        GSSharedPresent::ShutdownHost();
+    started = captureRequested = hasLatched = uploaded = uploadedBlank = modeKnown = sharedMode = false;
+    lastTick = lastSharedSequence = 0u;
+    current = {};
+    scratch.clear();
+    upload.clear();
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_inventory.h b/ps2xRuntime/src/lib/gs/gs_inventory.h
new file mode 100644
index 0000000..170e690
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_inventory.h
@@ -0,0 +1,238 @@
+// GOW-Port: GOW_GS_INVENTORY=1 classifies what the game does with the GS, to size a render-target renderer: which draws sample
+// textures that live inside earlier render targets (same or other pixel format), feedback draws (FBP==TBP), depth-as-texture,
+// CLUT loads from render targets, uploads/readbacks that touch render targets and CPU VRAM accessors. Printed every 5 s.
+#pragma once
+
+#include "runtime/gs/gs_types.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <algorithm>
+#include <array>
+#include <map>
+#include <string>
+#include <vector>
+#include <mutex>
+#include <chrono>
+
+class GsInventory
+{
+public:
+    static GsInventory &get()
+    {
+        static GsInventory inv;
+        return inv;
+    }
+    bool enabled() const { return m_enabled; }
+
+    void draw(const GSPrimitiveBatch &b)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const GSContext &c = b.state.context;
+        ++m_draws;
+        ++m_prim[static_cast<int>(b.state.prim.type) & 7];
+        const uint32_t fbp = c.frame.fbp, tbp = c.tex0.tbp0;
+        if (c.frame.fbmsk != 0u) ++m_fbmsk;
+        if (b.state.prim.abe) ++m_abe;
+        if (b.state.prim.fge) ++m_fog;
+        if (b.state.prim.aa1) ++m_aa;
+        if ((c.test & 1u) != 0u) ++m_atest;           // ATE
+        if (((c.test >> 14) & 1u) != 0u) ++m_date;    // DATE
+        if (((c.test >> 16) & 1u) != 0u) ++m_zte;     // ZTE
+        if (b.state.dthe) ++m_dither;
+        if (b.state.pabe) ++m_pabe;
+        if (b.state.scanmsk) ++m_scanmsk;
+        ++m_hist["alpha a|b|c|d lo8=" + hex(c.alpha & 0xFF) + (((c.alpha >> 4) & 3) == 2 ? " fix=" + hex((c.alpha >> 32) & 0xFF) : "") + (b.state.prim.abe ? " ABE" : " noABE")];
+        ++m_hist["test ate=" + hex(c.test & 1) + " atst=" + hex((c.test >> 1) & 7) + " aref=" + hex((c.test >> 4) & 0xFF) + " afail=" + hex((c.test >> 12) & 3) + " ztst=" + hex((c.test >> 17) & 3)];
+        ++m_hist["frame psm=" + hex(c.frame.psm) + " fbw=" + hex(c.frame.fbw) + " fbp=" + hex(c.frame.fbp) + " zpsm=" + hex(c.zbuf.psm) + " zbp=" + hex(c.zbuf.zbp) + (c.zbuf.zmask ? " ZMSK" : "")];
+        if (b.state.prim.tme)
+            ++m_hist["tex tfx=" + hex(c.tex0.tfx) + " tcc=" + hex(c.tex0.tcc) + " fst=" + hex(b.state.prim.fst) + " iip=" + hex(b.state.prim.iip) + " lin=" + hex(b.state.linearFilter) + " clamp=" + hex(c.clamp & 0xF) + " size=" + hex(b.state.textureWidth) + "x" + hex(b.state.textureHeight)];
+        if (c.frame.fbmsk) ++m_hist["fbmsk=" + hex(c.frame.fbmsk)];
+        noteTarget(fbp, c.frame.fbw, c.frame.psm);
+        if (!c.zbuf.zmask && ((c.test >> 16) & 1u) != 0u)
+            noteTarget(c.zbuf.zbp, c.frame.fbw, static_cast<uint8_t>(c.zbuf.psm | 0x30u)); // depth, flagged
+        if (!b.state.prim.tme)
+        {
+            ++m_untextured;
+            return;
+        }
+        if (fbp == tbp) ++m_feedback;
+        if (c.zbuf.zbp == tbp) ++m_depthAsTex;
+        {
+            const auto up = m_uploads.find(tbp);
+            if (up == m_uploads.end())
+                ++m_hist["tex psm=" + hex(c.tex0.psm) + " no upload at tbp"];
+            else
+                ++m_hist["tex psm=" + hex(c.tex0.psm) + " tbw=" + hex(c.tex0.tbw) + " vs upload psm=" + hex(up->second[0]) + " bw=" + hex(up->second[1]) + " " + hex(up->second[2]) + "x" + hex(up->second[3]) + " tex=" + hex(b.state.textureWidth) + "x" + hex(b.state.textureHeight)];
+        }
+        const Target *t = findTarget(tbp);
+        if (!t)
+        {
+            ++m_plainTex;
+            ++m_texPsm[c.tex0.psm & 63];
+            return;
+        }
+        const bool exact = (t->base == tbp);
+        const bool sameFamily = family(t->psm) == family(c.tex0.psm);
+        if (exact && t->psm == c.tex0.psm) ++m_rtSame;
+        else if (exact && sameFamily) ++m_rtSameFamilyOtherPsm;
+        else if (exact) ++m_rtReinterpret;
+        else if (sameFamily) ++m_rtInsideSame;
+        else ++m_rtInsideOther;
+        if (!exact || !sameFamily || t->psm != c.tex0.psm)
+            ++m_reinterpKinds[(static_cast<uint32_t>(t->psm) << 8) | c.tex0.psm];
+    }
+    void clut(const GSTex0Reg &t)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        ++m_clutLoads;
+        if (findTarget(t.cbp)) ++m_clutFromRt;
+    }
+    void transfer(const GSTransferCommand &c)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const uint32_t dir = c.direction;
+        if (dir == 0u)
+        {
+            ++m_hostToLocal;
+            m_uploads[c.bitbltbuf.dbp] = {c.bitbltbuf.dpsm, c.bitbltbuf.dbw, c.trxreg.rrw, c.trxreg.rrh};
+            ++m_hist["upload dpsm=" + hex(c.bitbltbuf.dpsm) + " dbw=" + hex(c.bitbltbuf.dbw) + " " + hex(c.trxreg.rrw) + "x" + hex(c.trxreg.rrh)];
+            if (findTarget(c.bitbltbuf.dbp)) ++m_uploadIntoRt;
+            m_uploadPixels += static_cast<uint64_t>(c.trxreg.rrw) * c.trxreg.rrh;
+        }
+        else if (dir == 1u)
+        {
+            ++m_localToHost;
+            if (findTarget(c.bitbltbuf.sbp)) ++m_readbackFromRt;
+            m_readbackPixels += static_cast<uint64_t>(c.trxreg.rrw) * c.trxreg.rrh;
+        }
+        else
+        {
+            ++m_localToLocal;
+            if (findTarget(c.bitbltbuf.sbp)) ++m_copyFromRt;
+            if (findTarget(c.bitbltbuf.dbp)) ++m_copyIntoRt;
+        }
+    }
+    void clear() { std::lock_guard<std::mutex> lock(m_mutex); ++m_clears; }
+    void cpuRead() { std::lock_guard<std::mutex> lock(m_mutex); ++m_cpuRead; }
+    void cpuWrite() { std::lock_guard<std::mutex> lock(m_mutex); ++m_cpuWrite; }
+    void snapshot() { std::lock_guard<std::mutex> lock(m_mutex); ++m_snapshots; }
+    void consumeL2H() { std::lock_guard<std::mutex> lock(m_mutex); ++m_consumeL2H; }
+    void present()
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        ++m_presents;
+        const auto now = std::chrono::steady_clock::now();
+        if (now - m_last < std::chrono::seconds(5))
+            return;
+        m_last = now;
+        report();
+        m_targets.clear();
+    }
+
+private:
+    struct Target
+    {
+        uint32_t base, fbw;
+        uint8_t psm;
+    };
+    GsInventory() : m_enabled(std::getenv("GOW_GS_INVENTORY") != nullptr), m_last(std::chrono::steady_clock::now()) {}
+    static int family(uint8_t psm)
+    {
+        switch (psm & 0x0F)
+        {
+        case 0: case 1: return 32; // PSMCT32/24
+        case 2: case 10: return 16; // PSMCT16 / 16S
+        case 11: return 8;
+        default: return psm & 0x0F;
+        }
+    }
+    void noteTarget(uint32_t base, uint32_t fbw, uint8_t psm)
+    {
+        for (Target &t : m_targets)
+            if (t.base == base)
+            {
+                t.fbw = fbw;
+                t.psm = psm;
+                return;
+            }
+        m_targets.push_back({base, fbw, psm});
+    }
+    // a target spans fbw*64 pixels x up to 448 rows = fbw * 14 pages * 32 blocks
+    const Target *findTarget(uint32_t block) const
+    {
+        for (const Target &t : m_targets)
+        {
+            const uint32_t span = (t.fbw ? t.fbw : 10u) * 14u * 32u;
+            if (block >= t.base && block < t.base + span)
+                return &t;
+        }
+        return nullptr;
+    }
+    static std::string hex(uint64_t v)
+    {
+        char buf[24];
+        std::snprintf(buf, sizeof(buf), "%llx", (unsigned long long)v);
+        return buf;
+    }
+    void report()
+    {
+        {
+            std::vector<std::pair<uint64_t, std::string>> top;
+            for (const auto &kv : m_hist)
+                top.emplace_back(kv.second, kv.first);
+            std::sort(top.rbegin(), top.rend());
+            for (size_t i = 0; i < top.size() && i < 70u; ++i)
+                std::fprintf(stderr, "[gs-inv-h] %8llu  %s\n", (unsigned long long)top[i].first, top[i].second.c_str());
+            m_hist.clear();
+        }
+        std::fprintf(stderr,
+                     "[gs-inv] 5s: presents=%llu draws=%llu untextured=%llu plainTex=%llu | RT-as-texture: same=%llu samePageOtherPsm=%llu reinterpret=%llu insideSame=%llu insideOther=%llu"
+                     " | feedback(fbp==tbp)=%llu depthAsTex=%llu clutFromRt=%llu/%llu\n",
+                     (unsigned long long)m_presents, (unsigned long long)m_draws, (unsigned long long)m_untextured, (unsigned long long)m_plainTex,
+                     (unsigned long long)m_rtSame, (unsigned long long)m_rtSameFamilyOtherPsm, (unsigned long long)m_rtReinterpret,
+                     (unsigned long long)m_rtInsideSame, (unsigned long long)m_rtInsideOther, (unsigned long long)m_feedback,
+                     (unsigned long long)m_depthAsTex, (unsigned long long)m_clutFromRt, (unsigned long long)m_clutLoads);
+        std::fprintf(stderr,
+                     "[gs-inv]     state: fbmsk!=0=%llu abe=%llu fog=%llu aa=%llu atest=%llu date=%llu zte=%llu dither=%llu pabe=%llu scanmsk=%llu prims(pt,ln,ls,tr,ts,tf,sp)=%llu,%llu,%llu,%llu,%llu,%llu,%llu\n",
+                     (unsigned long long)m_fbmsk, (unsigned long long)m_abe, (unsigned long long)m_fog, (unsigned long long)m_aa,
+                     (unsigned long long)m_atest, (unsigned long long)m_date, (unsigned long long)m_zte, (unsigned long long)m_dither,
+                     (unsigned long long)m_pabe, (unsigned long long)m_scanmsk, (unsigned long long)m_prim[0], (unsigned long long)m_prim[1],
+                     (unsigned long long)m_prim[2], (unsigned long long)m_prim[3], (unsigned long long)m_prim[4], (unsigned long long)m_prim[5],
+                     (unsigned long long)m_prim[6]);
+        std::fprintf(stderr,
+                     "[gs-inv]     transfers: host->local=%llu (into RT %llu, %llu px) local->host=%llu (from RT %llu, %llu px) local->local=%llu (from RT %llu, into RT %llu) clears=%llu cpuRead=%llu cpuWrite=%llu snapshot=%llu consumeL2H=%llu\n",
+                     (unsigned long long)m_hostToLocal, (unsigned long long)m_uploadIntoRt, (unsigned long long)m_uploadPixels,
+                     (unsigned long long)m_localToHost, (unsigned long long)m_readbackFromRt, (unsigned long long)m_readbackPixels,
+                     (unsigned long long)m_localToLocal, (unsigned long long)m_copyFromRt, (unsigned long long)m_copyIntoRt,
+                     (unsigned long long)m_clears, (unsigned long long)m_cpuRead, (unsigned long long)m_cpuWrite,
+                     (unsigned long long)m_snapshots, (unsigned long long)m_consumeL2H);
+        for (const auto &kv : m_reinterpKinds)
+            std::fprintf(stderr, "[gs-inv]     reinterpret rtPsm=%02x -> texPsm=%02x : %llu draws\n", kv.first >> 8, kv.first & 0xFF, (unsigned long long)kv.second);
+        for (const auto &kv : m_texPsm)
+            std::fprintf(stderr, "[gs-inv]     plain texture psm=%02x : %llu draws\n", kv.first, (unsigned long long)kv.second);
+        m_draws = m_untextured = m_plainTex = m_rtSame = m_rtSameFamilyOtherPsm = m_rtReinterpret = m_rtInsideSame = m_rtInsideOther = 0;
+        m_feedback = m_depthAsTex = m_clutFromRt = m_clutLoads = m_fbmsk = m_abe = m_fog = m_aa = m_atest = m_date = m_zte = m_dither = 0;
+        m_pabe = m_scanmsk = m_hostToLocal = m_uploadIntoRt = m_uploadPixels = m_localToHost = m_readbackFromRt = m_readbackPixels = 0;
+        m_localToLocal = m_copyFromRt = m_copyIntoRt = m_clears = m_cpuRead = m_cpuWrite = m_snapshots = m_consumeL2H = m_presents = 0;
+        for (auto &p : m_prim) p = 0;
+        m_reinterpKinds.clear();
+        m_texPsm.clear();
+    }
+
+    bool m_enabled;
+    std::mutex m_mutex;
+    std::chrono::steady_clock::time_point m_last;
+    std::vector<Target> m_targets;
+    std::map<uint32_t, uint64_t> m_reinterpKinds, m_texPsm;
+    std::map<std::string, uint64_t> m_hist;
+    std::map<uint32_t, std::array<uint32_t, 4>> m_uploads;
+    uint64_t m_prim[8]{};
+    uint64_t m_draws = 0, m_untextured = 0, m_plainTex = 0, m_rtSame = 0, m_rtSameFamilyOtherPsm = 0, m_rtReinterpret = 0;
+    uint64_t m_rtInsideSame = 0, m_rtInsideOther = 0, m_feedback = 0, m_depthAsTex = 0, m_clutFromRt = 0, m_clutLoads = 0;
+    uint64_t m_fbmsk = 0, m_abe = 0, m_fog = 0, m_aa = 0, m_atest = 0, m_date = 0, m_zte = 0, m_dither = 0, m_pabe = 0, m_scanmsk = 0;
+    uint64_t m_hostToLocal = 0, m_uploadIntoRt = 0, m_uploadPixels = 0, m_localToHost = 0, m_readbackFromRt = 0, m_readbackPixels = 0;
+    uint64_t m_localToLocal = 0, m_copyFromRt = 0, m_copyIntoRt = 0, m_clears = 0, m_cpuRead = 0, m_cpuWrite = 0, m_snapshots = 0;
+    uint64_t m_consumeL2H = 0, m_presents = 0;
+};
diff --git a/ps2xRuntime/src/lib/gs/gs_stage.cpp b/ps2xRuntime/src/lib/gs/gs_stage.cpp
new file mode 100644
index 0000000..786cb51
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_stage.cpp
@@ -0,0 +1,147 @@
+#include "runtime/gs/gs_stage.h"
+
+#include <condition_variable>
+#include <cstdio>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace
+{
+    struct Packet
+    {
+        GifPathId path = GifPathId::Path1;
+        std::vector<uint8_t> data;
+    };
+
+    // Bound on queued bytes: enough for several XGKICK packets of a batch, small enough that the worker never
+    // runs a whole frame ahead of the GS frontend.
+    constexpr size_t kMaxQueuedBytes = 4u << 20;
+
+    struct Stage
+    {
+        std::mutex mutex;
+        std::condition_variable work;   // stage waits for packets
+        std::condition_variable space;  // producer waits for room
+        std::condition_variable idle;   // waitIdle
+        std::deque<Packet> queue;
+        std::vector<std::vector<uint8_t>> spare; // recycled buffers (avoid an allocation per packet)
+        size_t queuedBytes = 0;
+        bool busy = false;
+        bool stop = false;
+        std::thread thread;
+        std::thread::id threadId;
+        ps2_gs_stage::ProcessFn process;
+        std::function<void()> afterBatch;
+    };
+
+    Stage &stage()
+    {
+        static Stage s;
+        return s;
+    }
+
+    void loop()
+    {
+        Stage &s = stage();
+        std::deque<Packet> batch;
+        for (;;)
+        {
+            {
+                std::unique_lock<std::mutex> lock(s.mutex);
+                for (Packet &p : batch)
+                {
+                    p.data.clear();
+                    s.spare.push_back(std::move(p.data));
+                }
+                batch.clear();
+                s.busy = false;
+                if (s.queue.empty())
+                    s.idle.notify_all();
+                s.work.wait(lock, [&s] { return s.stop || !s.queue.empty(); });
+                if (s.queue.empty())
+                    return;
+                batch.swap(s.queue);
+                s.queuedBytes = 0;
+                s.busy = true;
+            }
+            s.space.notify_all();
+            for (const Packet &p : batch)
+                s.process(p.path, p.data.data(), static_cast<uint32_t>(p.data.size()));
+            if (s.afterBatch)
+                s.afterBatch();
+        }
+    }
+}
+
+namespace ps2_gs_stage
+{
+    void start(ProcessFn process, std::function<void()> afterBatch)
+    {
+        Stage &s = stage();
+        std::lock_guard<std::mutex> lock(s.mutex);
+        if (s.thread.joinable())
+            return;
+        s.process = std::move(process);
+        s.afterBatch = std::move(afterBatch);
+        s.stop = false;
+        s.thread = std::thread(loop);
+        s.threadId = s.thread.get_id();
+        std::fprintf(stderr, "[gs-stage] GS frontend on its own thread, pipelined behind VU1 (PS2X_GS_PIPELINE=0 disables)\n");
+    }
+
+    void stop()
+    {
+        Stage &s = stage();
+        {
+            std::lock_guard<std::mutex> lock(s.mutex);
+            if (!s.thread.joinable())
+                return;
+            s.stop = true;
+        }
+        s.work.notify_all();
+        s.thread.join();
+        s.threadId = {};
+    }
+
+    bool running()
+    {
+        return stage().thread.joinable();
+    }
+
+    bool onStageThread()
+    {
+        return running() && std::this_thread::get_id() == stage().threadId;
+    }
+
+    void push(GifPathId path, const uint8_t *data, uint32_t size)
+    {
+        Stage &s = stage();
+        std::unique_lock<std::mutex> lock(s.mutex);
+        s.space.wait(lock, [&s, size] { return s.queuedBytes == 0 || s.queuedBytes + size <= kMaxQueuedBytes; });
+        Packet p;
+        p.path = path;
+        if (!s.spare.empty())
+        {
+            p.data = std::move(s.spare.back());
+            s.spare.pop_back();
+        }
+        p.data.assign(data, data + size);
+        s.queuedBytes += size;
+        const bool wasEmpty = s.queue.empty();
+        s.queue.push_back(std::move(p));
+        lock.unlock();
+        if (wasEmpty)
+            s.work.notify_one();
+    }
+
+    void waitIdle()
+    {
+        if (!running() || onStageThread())
+            return;
+        Stage &s = stage();
+        std::unique_lock<std::mutex> lock(s.mutex);
+        s.idle.wait(lock, [&s] { return s.queue.empty() && !s.busy; });
+    }
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_swizzle.cpp b/ps2xRuntime/src/lib/gs/gs_swizzle.cpp
