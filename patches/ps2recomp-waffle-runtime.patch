+	cpuRegs.GPR.r[_Rd_].US[0] = Rt.US[0];
+	cpuRegs.GPR.r[_Rd_].US[1] = Rs.US[4];
+	cpuRegs.GPR.r[_Rd_].US[2] = Rt.US[1];
+	cpuRegs.GPR.r[_Rd_].US[3] = Rs.US[5];
+	cpuRegs.GPR.r[_Rd_].US[4] = Rt.US[2];
+	cpuRegs.GPR.r[_Rd_].US[5] = Rs.US[6];
