-    }
-
-    if (!zpass)
-    {
-        return;
-    }
-
-    if (writeMask.writesFramebuffer())
-    {
-        const u8 srcR = r;
-        const u8 srcG = g;
-        const u8 srcB = b;
-
-        if (state.prim.abe)
-        {
-            uint8_t dr = fbrgba & 0xFF;
