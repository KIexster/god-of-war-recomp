+    {
+        std::cerr << "[~PS2Runtime] cleanup exception: " << e.what() << std::endl;
+    }
+    catch (...)
+    {
+        std::cerr << "[~PS2Runtime] cleanup exception: unknown" << std::endl;
+    }
+}
