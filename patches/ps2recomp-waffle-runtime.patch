+                break;
+            case 2u:
+                result = (old & 0xFF000000u) | (value >> 8u);
+                break;
+            case 3u:
+                result = value;
+                break;
+            }
+            mem.store32(aligned, result);
+            break;
+        }
+        case 0x2B:
+        {
+            const uint32_t address = cpu.gpr[rs] + static_cast<uint32_t>(simm);
+            if (address & 3u)
+            {
+                iopRaiseException(cpu, 5u, pc, wasDelaySlot, address);
+                break;
+            }
+            mem.store32(address, cpu.gpr[rt]);
+            break;
+        }
+        case 0x2E:
+        {
+            const uint32_t address = cpu.gpr[rs] + static_cast<uint32_t>(simm);
