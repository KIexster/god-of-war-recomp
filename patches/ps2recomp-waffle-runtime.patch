+            g_lastCdError = -1;
+            return false;
+        }
+
+        file.seekg(static_cast<std::streamoff>(offsetBytes), std::ios::beg);
+        if (!file.good())
+        {
+            g_lastCdError = -1;
+            return false;
+        }
+
+        file.read(reinterpret_cast<char *>(dst), static_cast<std::streamsize>(byteCount));
+        g_lastCdError = 0;
+        return true;
+    }
