+        m_iopSubsystem.reset();
+        m_iopHost.reset();
+#if defined(PLATFORM_VITA)
+        m_audioBackend.stopAll();
+        m_audioBackend.setAudioReady(false);
+#else
+        if (IsAudioDeviceReady())
+        {
+            CloseAudioDevice();
+            m_audioBackend.setAudioReady(false);
