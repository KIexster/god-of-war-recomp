+	cpuRegs.GPR.r[_Rd_].UC[10] = Rt.UC[13];
+	cpuRegs.GPR.r[_Rd_].UC[11] = Rs.UC[13];
+	cpuRegs.GPR.r[_Rd_].UC[12] = Rt.UC[14];
+	cpuRegs.GPR.r[_Rd_].UC[13] = Rs.UC[14];
+	cpuRegs.GPR.r[_Rd_].UC[14] = Rt.UC[15];
+	cpuRegs.GPR.r[_Rd_].UC[15] = Rs.UC[15];
