+            {
+                setReturnU32(ctx, 0u);
+                return;
+            }
+
+            const uint32_t words[4] = {baseAddr, baseAddr, 0u, 0u};
+            writeGuestBytes(rdram,
+                            runtime,
+                            stateAddr,
+                            reinterpret_cast<const uint8_t *>(words),
+                            sizeof(words));
