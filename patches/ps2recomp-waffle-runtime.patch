+__fi void _vuBackupVI(VURegs* VU, u32 reg)
+{
+#ifdef VI_BACKUP
+	if (VU->VIBackupCycles && reg == VU->VIRegNumber)
+	{
+		//On repeat writes we need to remember the value from before the chain
+		VU->VIBackupCycles = 2;
+		return;
+	}
+
+	VU->VIBackupCycles = 2;
+	VU->VIRegNumber = reg;
+	VU->VIOldValue = VU->VI[reg].US[0];
+#endif
+}
