+            const uint32_t value = cpu.gpr[rt];
+            uint32_t result = old;
+            switch (address & 3u)
+            {
+            case 0u:
+                result = value;
+                break;
+            case 1u:
+                result = (old & 0x000000FFu) | (value << 8u);
+                break;
+            case 2u:
+                result = (old & 0x0000FFFFu) | (value << 16u);
+                break;
+            case 3u:
+                result = (old & 0x00FFFFFFu) | (value << 24u);
+                break;
+            }
+            mem.store32(aligned, result);
+            break;
+        }
+        default:
