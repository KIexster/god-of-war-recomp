diff --git a/ps2xRuntime/include/runtime/gs/gs_aspecto.h b/ps2xRuntime/include/runtime/gs/gs_aspecto.h
new file mode 100644
index 0000000..77bc4d1
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_aspecto.h
@@ -0,0 +1,43 @@
+#pragma once
+// GOW-Port: ps2recomp-aspecto. Relación de aspecto de la imagen (GOW_ASPECTO), compartida por la ventana
+// (gs_host_present.cpp) y por el juego (src/gow_overrides.cpp, flotantes de aspecto y apertura de la cámara).
+//   sin definir o vacía: 16:9 (como siempre)
+//   "auto": la de la ventana (pantalla completa 5120x1440 -> 32:9)
+//   "<ancho>:<alto>" (21:9, 32:9) o un número (2.37)
+// Un valor no válido o fuera de 1..4 vale 16:9.
+#include <cstdlib>
+#include <cstring>
+
+namespace gs_aspecto
+{
+    constexpr float kPorDefecto = 16.0f / 9.0f;
+
+    inline float interpretar(const char *texto, float anchoVentana, float altoVentana)
+    {
+        if (texto == nullptr || texto[0] == '\0')
+            return kPorDefecto;
+        float valor = 0.0f;
+        if (std::strcmp(texto, "auto") == 0)
+            valor = altoVentana > 0.0f ? anchoVentana / altoVentana : 0.0f;
+        else
+        {
+            char *fin = nullptr;
+            const double a = std::strtod(texto, &fin);
+            if (fin != texto && *fin == ':')
+            {
+                const char *resto = fin + 1;
+                const double b = std::strtod(resto, &fin);
+                valor = fin != resto && *fin == '\0' && b > 0.0 ? static_cast<float>(a / b) : 0.0f;
+            }
+            else if (fin != texto && *fin == '\0')
+                valor = static_cast<float>(a);
+        }
+        return valor >= 1.0f && valor <= 4.0f ? valor : kPorDefecto;
+    }
+
+    // El aspecto pedido en GOW_ASPECTO para una ventana de ese tamaño.
+    inline float actual(float anchoVentana, float altoVentana)
+    {
+        return interpretar(std::getenv("GOW_ASPECTO"), anchoVentana, altoVentana);
+    }
+}
