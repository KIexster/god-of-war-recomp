+        tc.Run("VU1 native madd returns overflows clamped with the same MAC flags", [](TestCase &t)
+        {
+            // GOW-Port: ps2recomp-vu1-madd-saturado. Los bloques nativos ya no pasan el resultado de madd/msub por
+            // clampv: el desbordamiento sale de maddWide ya en +-FLT_MAX, con los mismos flags MAC que el infinito.
+            const float big = std::numeric_limits<float>::max(), inf = std::numeric_limits<float>::infinity();
+            const __m128 acc = _mm_setr_ps(big, -big, 1.0f, -big);
+            const __m128 a = _mm_setr_ps(big, big, 2.0f, big);
+            const __m128 b = _mm_setr_ps(2.0f, -2.0f, 3.0f, 1.0f);
+            alignas(16) float out[4];
+            _mm_store_ps(out, vu1n::madd<false>(acc, a, b));
+            t.IsTrue(out[0] == big && out[1] == -big, "an overflowing madd should come back as +-FLT_MAX");
+            t.IsTrue(out[2] == 7.0f && out[3] == 0.0f, "the other lanes keep the exact sum");
+            const uint32_t flags = vu1n::macVal<15>(_mm_load_ps(out));
+            const uint32_t flagsInf = vu1n::macVal<15>(_mm_setr_ps(inf, -inf, 7.0f, 0.0f));
+            t.Equals(flags, flagsInf, "the MAC flags of the clamped result should match the unclamped ones");
