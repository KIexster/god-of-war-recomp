+            // GOW-Port: ps2recomp-gs-finish-anticipado. Solo cuentan las escrituras A+D a FINISH dentro de un DIRECT; los
+            // datos de UNPACK (con CL < WL se leen menos vectores), MPG e IMAGE se saltan aunque contengan esos bytes, y
+            // una carga cortada por el final del paquete sigue en el siguiente.
+            const uint64_t packedAd = 1ull | (1ull << 15) | (1ull << 60); // NLOOP 1, EOP, PACKED, NREG 1
+            const uint64_t image = 2ull | (1ull << 15) | (2ull << 58);    // NLOOP 2, EOP, IMAGE
+            const auto appendFinishDirect = [&](std::vector<uint8_t> &p)
+            {
+                appendU32(p, makeVifCmd(0x50u, 0u, 2u)); // DIRECT, 2 QW
+                appendU64(p, packedAd);
+                appendU64(p, 0xEull);                    // REGS[0] = A+D
+                appendU64(p, 0u);
+                appendU64(p, 0x61u);                     // FINISH
+            };
+            // Un QW con el aspecto de un DIRECT con FINISH, para meterlo en datos que hay que saltar.
+            const auto appendDecoy = [&](std::vector<uint8_t> &p)
+            {
+                appendU32(p, makeVifCmd(0x50u, 0u, 1u));
+                appendU32(p, 0u);
+                appendU32(p, 0x61u);
+                appendU32(p, 0u);
+            };
+
+            std::vector<uint8_t> chain;
+            appendU32(chain, makeVifCmd(0x01u, 0u, 0x0201u)); // STCYCL CL=1 WL=2
+            appendU32(chain, makeVifCmd(0x6Cu, 4u, 0u));      // UNPACK V4-32, 4 escrituras = 2 vectores de origen
+            appendDecoy(chain);
+            appendDecoy(chain);
+            appendU32(chain, makeVifCmd(0x4Au, 2u, 0u));      // MPG, 2 instrucciones (16 bytes)
+            appendDecoy(chain);
+            appendU32(chain, makeVifCmd(0x50u, 0u, 3u));      // DIRECT con IMAGE: los datos no son registros
+            appendU64(chain, image);
+            appendU64(chain, 0u);
+            appendDecoy(chain);
+            appendDecoy(chain);
+            appendFinishDirect(chain);
+            appendU32(chain, 0u);                             // NOP
+            uint32_t cycle = 0x0101u, left = 0u;
+            t.Equals(PS2Memory::countPath2Finish(chain.data(), static_cast<uint32_t>(chain.size()), cycle, left), 1u,
+                     "only the A+D FINISH inside a DIRECT should count");
+            t.Equals(cycle, 0x0201u, "STCYCL should carry over to the next packet");
+            t.Equals(left, 0u, "nothing should be left over");
