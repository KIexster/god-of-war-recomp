+            const uint32_t second = PS2Memory::countPath2Finish(chain.data() + cut, static_cast<uint32_t>(chain.size()) - cut,
+                                                                cycle, left);
+            t.Equals(first + second, 1u, "the split chain should count the same FINISH write once");
+        });
