+// GOW-Port: la FPU del EE no tiene Inf/NaN ni denormales. Los resultados con exponente 255 se saturan a
+// +-FLT_MAX, dividir por cero da +-FLT_MAX con los flags D/I de FCR31, CVT.W.S trunca (no redondea) y
+// satura, y las comparaciones tratan los exponentes 0 como cero y los exponentes 255 como finitos.
+constexpr uint32_t PS2_FCR31_I = 0x00020000u;
+constexpr uint32_t PS2_FCR31_D = 0x00010000u;
+constexpr uint32_t PS2_FCR31_SI = 0x00000040u;
+constexpr uint32_t PS2_FCR31_SD = 0x00000020u;
+
+static inline float ps2FpuClamp(float value)
+{
+    return ps2VuClampScalar(value);
+}
+
+static inline float ps2FpuDivide(uint32_t &fcr31, float dividend, float divisor)
+{
+    if (ps2VuFloatIsZero(divisor))
+    {
+        if (ps2VuFloatIsZero(dividend))
+            fcr31 |= PS2_FCR31_I | PS2_FCR31_SI;
+        else
+            fcr31 |= PS2_FCR31_D | PS2_FCR31_SD;
+        return ps2VuSignedFloatMax(ps2VuFloatBits(dividend) ^ ps2VuFloatBits(divisor));
+    }
+    return ps2FpuClamp(dividend / divisor);
+}
+
+static inline int32_t ps2FpuConvertToWord(float value)
+{
+    const uint32_t bits = ps2VuFloatBits(value);
+    if ((bits & 0x7F800000u) >= 0x4F000000u)
+        return (bits & 0x80000000u) ? INT32_MIN : INT32_MAX;
+    return static_cast<int32_t>(value);
+}
+
+static inline uint32_t ps2FpuCompareKey(float value)
+{
+    uint32_t bits = ps2VuFloatBits(value);
+    if ((bits & 0x7F800000u) == 0u)
+        bits = 0u;
+    return (bits & 0x80000000u) != 0u ? ~bits : bits ^ 0x80000000u;
+}
