+// GOW-Port: la VU no tiene Inf/NaN; un resultado con exponente 255 se satura a +-FLT_MAX.
+static inline __m128 ps2VuClampVector(__m128 value)
+{
+    const __m128i bits = _mm_castps_si128(value);
+    const __m128i exponentMask = _mm_set1_epi32(0x7F800000);
+    const __m128i special = _mm_cmpeq_epi32(_mm_and_si128(bits, exponentMask), exponentMask);
