@@ -140,6 +140,78 @@ static inline uint32_t ps2_plzcw32(uint32_t x)
 #define PS2_PXOR(a, b) _mm_xor_si128((__m128i)(a), (__m128i)(b))
 #define PS2_PNOR(a, b) _mm_xor_si128(_mm_or_si128((__m128i)(a), (__m128i)(b)), _mm_set1_epi32(0xFFFFFFFF))
 
+// GOW-Port: VDIV/VSQRT/VRSQRT de VU0 en modo macro con la semantica del hardware. La VU no tiene Inf/NaN:
+// dividir por cero da +-FLT_MAX (signo fs^ft) y activa D (o I si 0/0) en el registro de estado; las raices
+// usan |ft| y activan I si ft es negativo. Los exponentes 0 cuentan como cero.
+static inline uint32_t ps2VuFloatBits(float value)
+{
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    return bits;
+}
+
+static inline bool ps2VuFloatIsZero(float value)
+{
+    return (ps2VuFloatBits(value) & 0x7F800000u) == 0u;
+}
+
+static inline float ps2VuSignedFloatMax(uint32_t signSource)
+{
+    const uint32_t bits = (signSource & 0x80000000u) | 0x7F7FFFFFu;
+    float out;
+    std::memcpy(&out, &bits, sizeof(out));
+    return out;
+}
+
+static inline float ps2VuClampScalar(float value)
+{
+    const uint32_t bits = ps2VuFloatBits(value);
+    return (bits & 0x7F800000u) == 0x7F800000u ? ps2VuSignedFloatMax(bits) : value;
+}
+
+constexpr uint16_t PS2_VU_STATUS_I = 0x0010u;
+constexpr uint16_t PS2_VU_STATUS_D = 0x0020u;
+constexpr uint16_t PS2_VU_STATUS_IS = 0x0400u;
+constexpr uint16_t PS2_VU_STATUS_DS = 0x0800u;
+
+static inline float ps2VuDivide(uint16_t &status, float dividend, float divisor)
+{
+    status &= static_cast<uint16_t>(~(PS2_VU_STATUS_I | PS2_VU_STATUS_D));
+    if (ps2VuFloatIsZero(divisor))
+    {
+        if (ps2VuFloatIsZero(dividend))
+            status |= PS2_VU_STATUS_I | PS2_VU_STATUS_IS;
+        else
+            status |= PS2_VU_STATUS_D | PS2_VU_STATUS_DS;
+        return ps2VuSignedFloatMax(ps2VuFloatBits(dividend) ^ ps2VuFloatBits(divisor));
+    }
+    return ps2VuClampScalar(dividend / divisor);
+}
+
+static inline float ps2VuSqrt(uint16_t &status, float value)
+{
+    status &= static_cast<uint16_t>(~(PS2_VU_STATUS_I | PS2_VU_STATUS_D));
+    if ((ps2VuFloatBits(value) & 0x80000000u) != 0u && !ps2VuFloatIsZero(value))
+        status |= PS2_VU_STATUS_I | PS2_VU_STATUS_IS;
+    return ps2VuClampScalar(std::sqrt(std::fabs(value)));
+}
+
+static inline float ps2VuRsqrt(uint16_t &status, float numerator, float value)
+{
+    status &= static_cast<uint16_t>(~(PS2_VU_STATUS_I | PS2_VU_STATUS_D));
+    if (ps2VuFloatIsZero(value))
+    {
+        if (ps2VuFloatIsZero(numerator))
+            status |= PS2_VU_STATUS_I | PS2_VU_STATUS_IS;
+        else
+            status |= PS2_VU_STATUS_D | PS2_VU_STATUS_DS;
+        return ps2VuSignedFloatMax(ps2VuFloatBits(numerator) ^ ps2VuFloatBits(value));
+    }
+    if ((ps2VuFloatBits(value) & 0x80000000u) != 0u)
+        status |= PS2_VU_STATUS_I | PS2_VU_STATUS_IS;
+    return ps2VuClampScalar(numerator / std::sqrt(std::fabs(value)));
+}
+
 // PS2 VU (Vector Unit) operations
 #define PS2_VADD(a, b) _mm_add_ps((__m128)(a), (__m128)(b))
 #define PS2_VSUB(a, b) _mm_sub_ps((__m128)(a), (__m128)(b))
